---
interface Props {
  tagline?: string;
  title: string;
  subtitle: string;
  primaryCTA: { text: string; href: string };
  secondaryCTA?: { text: string; href: string };
}

const { tagline, subtitle, primaryCTA, secondaryCTA } = Astro.props;
---

<section id="home" class="hero">
  <div class="hero-inner">
    {tagline && <p class="tagline">{tagline}</p>}

    <h1 class="hero-title">
      Technology that accelerates your&nbsp;mission.
    </h1>

    <p class="hero-subtitle">
      {subtitle}
    </p>

    <!-- Prompt bar — the one memorable object -->
    <div class="prompt-panel">
      <div class="prompt-copy">
        <span>Start with the outcome</span>
        <strong>What should technology make easier for your team?</strong>
      </div>
      <div class="prompt-actions">
        <a href={primaryCTA.href} class="btn btn-primary">
          {primaryCTA.text}
        </a>
        {secondaryCTA && (
          <a href={secondaryCTA.href} class="secondary-link">
            {secondaryCTA.text} →
          </a>
        )}
      </div>
    </div>

    <!-- Client bar -->
    <div class="client-bar">
      <p class="client-text">
        Trusted by teams at <span class="client-highlight">Disney</span>, <span class="client-highlight">NBC Sports</span>, <span class="client-highlight">Golf Channel</span>, and <span class="client-highlight">IF:Gathering</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    padding: 5rem 0 4rem;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 7rem 0 5rem;
    }
  }

  .hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .hero-inner {
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-inner {
      padding: 0 3rem;
    }
  }

  .tagline {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 6vw, 4rem);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.02;
    letter-spacing: -0.015em;
    max-width: 56rem;
    margin-bottom: 1.75rem;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 34rem;
    line-height: 1.65;
    margin-bottom: 3rem;
  }

  /* Prompt bar */
  .prompt-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    justify-content: space-between;
    padding: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    max-width: 52rem;
  }

  @media (min-width: 760px) {
    .prompt-panel {
      flex-direction: row;
      align-items: center;
      padding: 1rem 1rem 1rem 1.5rem;
    }
  }

  .prompt-copy {
    display: grid;
    gap: 0.35rem;
  }

  .prompt-copy span {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .prompt-copy strong {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .prompt-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .secondary-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms ease;
    white-space: nowrap;
  }

  .secondary-link:hover {
    color: var(--text-primary);
  }

  /* Client bar */
  .client-bar {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .client-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .client-highlight {
    color: var(--text-primary);
    font-weight: 500;
  }
</style>
