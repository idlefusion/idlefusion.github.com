---
interface Props {
  tagline?: string;
  title: string;
  subtitle: string;
  primaryCTA: { text: string; href: string };
  secondaryCTA?: { text: string; href: string };
}

const { tagline, title, subtitle, primaryCTA, secondaryCTA } = Astro.props;
---

<section id="home" class="hero noise-overlay">
  <!-- Aurora orbs -->
  <div class="aurora-orb aurora-orb-primary orb-1 animate-aurora"></div>
  <div class="aurora-orb aurora-orb-cyan orb-2 animate-aurora" style="animation-delay: -6s"></div>
  <div class="aurora-orb aurora-orb-warm orb-3 animate-aurora" style="animation-delay: -12s"></div>

  <!-- Subtle grid background -->
  <div class="grid-bg"></div>

  <div class="hero-content">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="hero-layout">
        <!-- Main Content -->
        <div class="content-area">
          {tagline && (
            <p class="tagline animate-fade-in" style="animation-delay: 0.1s">
              <span class="tagline-dot"></span>
              {tagline}
            </p>
          )}

          <h1 class="hero-title">
            <span class="title-line animate-fade-in" style="animation-delay: 0.2s">Technology that</span>
            <span class="title-line title-accent animate-fade-in" style="animation-delay: 0.35s">
              <span class="gradient-word">accelerates</span>
            </span>
            <span class="title-line animate-fade-in" style="animation-delay: 0.5s">your</span>
            <span class="title-line title-italic animate-fade-in" style="animation-delay: 0.65s">mission.</span>
          </h1>

          <p class="hero-subtitle animate-fade-in" style="animation-delay: 0.8s">
            {subtitle}
          </p>

          <div class="cta-group animate-fade-in" style="animation-delay: 0.95s">
            <a href={primaryCTA.href} class="btn btn-accent text-base px-8 py-4">
              {primaryCTA.text}
              <svg class="btn-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            {secondaryCTA && (
              <a href={secondaryCTA.href} class="btn btn-outline text-base px-6 py-4">
                {secondaryCTA.text}
              </a>
            )}
          </div>
        </div>

        <!-- Side decoration - floating glass service cards -->
        <div class="decoration-area">
          <div class="service-stack">
            <div class="service-card glass-card card-1">
              <span class="service-number">01</span>
              <span class="service-name">Mobile Apps</span>
            </div>
            <div class="service-card glass-card card-2">
              <span class="service-number">02</span>
              <span class="service-name">Web Development</span>
            </div>
            <div class="service-card glass-card card-3">
              <span class="service-number">03</span>
              <span class="service-name">Digital Strategy</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Client bar -->
      <div class="client-bar animate-fade-in" style="animation-delay: 1.1s">
        <div class="client-divider"></div>
        <p class="client-text">
          Trusted by teams at <span class="client-highlight">Disney</span>, <span class="client-highlight">Golf Channel</span>, and <span class="client-highlight">IF:Gathering</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
  }

  /* Aurora orbs */
  .aurora-orb {
    will-change: transform;
  }

  .orb-1 {
    width: 520px;
    height: 520px;
    top: -8%;
    right: -8%;
  }

  .orb-2 {
    width: 440px;
    height: 440px;
    bottom: -15%;
    left: -5%;
  }

  .orb-3 {
    width: 300px;
    height: 300px;
    top: 40%;
    left: 35%;
    opacity: 0.18;
  }

  .dark .orb-3 { opacity: 0.12; }

  /* Subtle grid background */
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border-color) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-color) 1px, transparent 1px);
    background-size: 80px 80px;
    opacity: 0.35;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 60vh;
  }

  @media (min-width: 1024px) {
    .hero-layout {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 6rem;
    }
  }

  /* Tagline pill */
  .tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.875rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--gradient-aurora-soft);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-pill);
    margin-bottom: 2rem;
  }

  .tagline-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  /* Hero Title */
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 5.75rem);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: 2.5rem;
  }

  .title-line {
    display: block;
  }

  .title-accent {
    position: relative;
    display: inline-block;
  }

  .gradient-word {
    background: var(--gradient-aurora);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    animation: gradientShift 8s ease-in-out infinite;
    padding-right: 0.08em;
  }

  .title-italic {
    font-style: italic;
    color: var(--text-muted);
  }

  /* Subtitle */
  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.1875rem;
    color: var(--text-secondary);
    max-width: 500px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  /* CTA Group */
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-arrow {
    margin-left: 0.5rem;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Decoration area */
  .decoration-area {
    display: none;
  }

  @media (min-width: 1024px) {
    .decoration-area {
      display: block;
      position: relative;
      height: 420px;
    }
  }

  .service-stack {
    position: relative;
    height: 100%;
  }

  .service-card {
    position: absolute;
    padding: 1.125rem 1.625rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: var(--radius-md);
  }

  .service-card:hover {
    transform: translateY(-4px) !important;
    box-shadow: var(--shadow-glow);
    border-color: var(--accent);
  }

  .service-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .service-name {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .card-1 {
    top: 8%;
    left: 12%;
    animation: cardFloat 6s ease-in-out infinite;
  }

  .card-2 {
    top: 42%;
    left: 28%;
    animation: cardFloat 6s ease-in-out infinite;
    animation-delay: 1s;
  }

  .card-3 {
    top: 72%;
    left: 6%;
    animation: cardFloat 6s ease-in-out infinite;
    animation-delay: 2s;
  }

  @keyframes cardFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* Client bar */
  .client-bar {
    margin-top: 4rem;
    padding-top: 2rem;
  }

  .client-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-color), transparent);
    margin-bottom: 1.5rem;
  }

  .client-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .client-highlight {
    color: var(--text-primary);
    font-weight: 500;
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
</style>
