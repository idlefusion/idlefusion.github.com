---
// The studio footer, shared by the business site and the app pages.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <p>
          An independent app & web studio. Senior design and engineering for teams who want it done
          well, by the person they talk to.
        </p>
      </div>
      <div class="footer-col">
        <span class="label">Studio</span>
        <a href="/work/">Work</a>
        <a href="/services/">Services</a>
        <a href="/studio/">About</a>
        <a href="/contact/">Contact</a>
      </div>
      <div class="footer-col">
        <span class="label">Made here</span>
        <a href="/apps/">Apps</a>
        <a href="/open-source/">Open source</a>
      </div>
      <div class="footer-col">
        <span class="label">Elsewhere</span>
        <a href="mailto:hello@idlefusion.com">hello@idlefusion.com</a>
        <a href="https://github.com/idlefusion">GitHub</a>
        <a href="https://linkedin.com/in/mps">LinkedIn</a>
      </div>
    </div>
    <div class="footer-word" aria-hidden="true">idle fusion<span class="dot">.</span></div>
    <div class="footer-base">
      <span>© {year} Idle Fusion LLC</span>
      <span>Painted by hand. Built in code.</span>
    </div>
  </div>
</footer>
