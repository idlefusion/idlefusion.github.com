---
// Pip, the little peach of a train from the Pip app, as inline SVG. The same
// drawing as the app's PipCharacter.swift: a 240 × 220 board, the front of a
// train car (a rounded peach body at 52, 40, 136 × 152) with a leaf on top, a
// dot-matrix destination sign, a windshield with his face in it, two
// headlights and a bumper, and rubber-hose arms. Every pose is in the markup;
// `data-pose` on the <svg> picks which parts show, so a script can change it
// without redrawing.
export type PipPose = 'calm' | 'look' | 'go' | 'uhoh' | 'wave' | 'sleepy' | 'cheer';

interface Props {
  pose?: PipPose;
  /** What the sign says; each pose has its own when this is left out. */
  sign?: string;
  label?: string;
  class?: string;
  id?: string;
}
const signs: Record<PipPose, string> = { calm: 'PIP', look: 'SOON', go: 'GO', uhoh: '!!', wave: 'HI!', sleepy: 'Z Z', cheer: 'YAY' };
const { pose = 'calm', sign, label, class: className, id } = Astro.props;
const text = (sign ?? signs[pose]).toUpperCase().slice(0, 7);

// A four-point sparkle around (x, y), r from the centre to each tip.
const star = (x: number, y: number, r: number) => {
  const inner = r * 0.3;
  return (
    Array.from({ length: 8 }, (_, i) => {
      const angle = (i * Math.PI) / 4 - Math.PI / 2;
      const d = i % 2 === 0 ? r : inner;
      return `${i === 0 ? 'M' : 'L'}${(x + Math.cos(angle) * d).toFixed(1)} ${(y + Math.sin(angle) * d).toFixed(1)}`;
    }).join(' ') + ' Z'
  );
};
const sparkles = [
  [214, 131, 11, 0],
  [22, 136.5, 8.5, 0.5],
  [120, 9, 7, 1],
];
---

<svg
  id={id}
  class:list={['pip', className]}
  viewBox="0 0 240 220"
  data-pose={pose}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <ellipse class="pip-ground" cx="120" cy="208" rx="74" ry="7" />

  <!-- Behind: the night when he's sleepy, speed lines when it's time to go. -->
  <g data-part="sleepy">
    <path class="pip-moon" d="M206 18 a22 22 0 1 0 20 30 a17 17 0 0 1 -20 -30 z" />
    <path class="pip-z" d="M26 40 h14 l-14 14 h14" />
    <path class="pip-z pip-z-small" d="M48 18 h10 l-10 10 h10" />
  </g>
  <g data-part="go" class="pip-speed">
    <path d="M4 92 h30" />
    <path d="M-6 124 h34" style="animation-delay: 0.27s" />
    <path d="M6 156 h26" style="animation-delay: 0.53s" />
  </g>

  <g class="pip-bob">
    <g class="pip-lean">
      <g class="pip-leaf">
        <path class="pip-line" d="M121 44 Q118 34 124 26" />
        <path class="pip-blade" d="M124 27 Q139 8 161 16 Q148 35 124 27 Z" />
        <path class="pip-vein" d="M130 24 Q142 19 153 18" />
      </g>

      <!-- Arms -->
      <g data-part="calm look uhoh sleepy">
        <path class="pip-arm" d="M56 128 Q38 138 40 158 M184 128 Q202 138 200 158" />
        <circle class="pip-hand" cx="40" cy="160" r="8.5" />
        <circle class="pip-hand" cx="200" cy="160" r="8.5" />
      </g>
      <g data-part="wave">
        <path class="pip-arm" d="M56 128 Q38 138 40 158" />
        <circle class="pip-hand" cx="40" cy="160" r="8.5" />
        <g class="pip-waving">
          <path class="pip-arm" d="M184 122 Q208 114 210 82" />
          <circle class="pip-hand" cx="210" cy="78" r="9" />
        </g>
      </g>
      <g data-part="go">
        <path class="pip-arm" d="M56 124 Q34 122 26 102 M184 132 Q206 142 200 166" />
        <circle class="pip-hand" cx="26" cy="100" r="8.5" />
        <circle class="pip-hand" cx="200" cy="168" r="8.5" />
      </g>
      <g data-part="cheer" class="pip-cheering">
        <path class="pip-arm" d="M56 122 Q32 114 30 82 M184 122 Q208 114 210 82" />
        <circle class="pip-hand" cx="30" cy="78" r="9" />
        <circle class="pip-hand" cx="210" cy="78" r="9" />
      </g>

      <!-- Body -->
      <rect class="pip-body" x="52" y="40" width="136" height="152" rx="46" />
      <ellipse class="pip-shine" cx="82" cy="62" rx="12" ry="6" transform="rotate(-28 82 62)" />
      <path class="pip-seam" d="M120 44 Q115 50 120 56" />

      <!-- The destination sign -->
      <rect class="pip-sign" x="78" y="58" width="84" height="23" rx="6" />
      <text class="pip-sign-text" x="120" y="74.5" text-anchor="middle">{text}</text>

      <!-- The windshield, with his face in it -->
      <rect class="pip-glass" x="68" y="88" width="104" height="60" rx="22" />
      <path class="pip-glare" d="M80 100 Q84 95 92 94" />
      <g class:list={['pip-cheeks']}>
        <circle cx="88" cy="134" r="7" />
        <circle cx="152" cy="134" r="7" />
      </g>

      <g class="pip-face">
        <g data-part="calm" class="pip-eyes">
          <circle class="pip-pupil" cx="102" cy="114" r="7" />
          <circle class="pip-pupil" cx="138" cy="114" r="7" />
          <circle class="pip-glint" cx="104.5" cy="111.5" r="2.3" />
          <circle class="pip-glint" cx="140.5" cy="111.5" r="2.3" />
        </g>
        <g data-part="look" class="pip-eyes">
          <circle class="pip-pupil" cx="107" cy="113" r="7" />
          <circle class="pip-pupil" cx="143" cy="113" r="7" />
          <circle class="pip-glint" cx="109.5" cy="110.5" r="2.3" />
          <circle class="pip-glint" cx="145.5" cy="110.5" r="2.3" />
        </g>
        <g data-part="go">
          <path class="pip-filled" d="M94 111 h16 a8 8 0 0 1 -16 0 z M130 111 h16 a8 8 0 0 1 -16 0 z" />
          <path d="M93 102 l15 4 M147 102 l-15 4" />
        </g>
        <g data-part="uhoh">
          <g class="pip-eyes">
            <circle class="pip-pupil" cx="102" cy="116" r="6.5" />
            <circle class="pip-pupil" cx="138" cy="116" r="6.5" />
            <circle class="pip-glint" cx="104" cy="113.5" r="2.1" />
            <circle class="pip-glint" cx="140" cy="113.5" r="2.1" />
          </g>
          <path d="M94 104 l13 -5 M146 104 l-13 -5" />
        </g>
        <path data-part="sleepy" d="M95 114 Q102 120 109 114 M131 114 Q138 120 145 114" />
        <path data-part="wave cheer" d="M95 117 Q102 108 109 117 M131 117 Q138 108 145 117" />

        <path data-part="calm" d="M113 130 Q120 136 127 130" />
        <path data-part="wave go cheer" class="pip-filled" d="M110 128 Q120 141 130 128 Z" />
        <ellipse data-part="look" class="pip-filled" cx="124" cy="133" rx="4.5" ry="5.5" />
        <path data-part="uhoh" d="M110 134 q3 -4 6.5 0 t6.5 0 t6.5 0" />
        <path data-part="sleepy" d="M115 132 Q120 135 125 132" />
      </g>

      <!-- Headlights, glowing when it's time to go -->
      <g data-part="go" class="pip-beams">
        <circle cx="84" cy="170" r="19" />
        <circle cx="156" cy="170" r="19" />
      </g>
      <circle class="pip-lamp" cx="84" cy="170" r="10" />
      <circle class="pip-lamp" cx="156" cy="170" r="10" />
      <rect class="pip-grille" x="106" y="163" width="28" height="13" rx="5" />
      <rect class="pip-ink" x="58" y="186" width="124" height="14" rx="7" />
      <rect class="pip-ink" x="112" y="196" width="16" height="9" rx="3" />

      <path data-part="uhoh" class="pip-sweat" d="M182 82 Q175 92 182 95 Q189 92 182 82 Z" />
    </g>
  </g>

  <g data-part="cheer">
    {
      sparkles.map(([x, y, r, delay]) => (
        <path class="pip-sparkle" d={star(x, y, r)} style={`animation-delay: ${delay}s`} />
      ))
    }
  </g>
</svg>

<style is:global>
  .pip {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pip-ground {
    fill: rgba(28, 29, 33, 0.13);
  }
  .pip-body,
  .pip-glass,
  .pip-blade,
  .pip-hand,
  .pip-lamp,
  .pip-grille {
    stroke: #1c1d21;
    stroke-linejoin: round;
  }
  .pip-body {
    fill: #ffb38a;
    stroke-width: 7;
  }
  .pip-hand {
    fill: #ffb38a;
    stroke-width: 5;
  }
  .pip-glass {
    fill: #fff4eb;
    stroke-width: 6;
  }
  .pip-blade {
    fill: #5fa56b;
    stroke-width: 5;
  }
  .pip-line,
  .pip-arm,
  .pip-vein,
  .pip-seam,
  .pip-glare,
  .pip-z,
  .pip-speed path,
  .pip-face path,
  .pip-face ellipse {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pip-line {
    stroke: #1c1d21;
    stroke-width: 5;
  }
  .pip-arm {
    stroke: #1c1d21;
    stroke-width: 7;
  }
  .pip-vein {
    stroke: #3d7a4f;
    stroke-width: 2.5;
  }
  .pip-seam {
    stroke: #e8916a;
    stroke-width: 3.5;
  }
  .pip-shine {
    fill: #ffd6be;
  }
  .pip-sign,
  .pip-ink {
    fill: #1c1d21;
  }
  .pip-sign-text {
    fill: #ffb23e;
    font: 900 15px ui-monospace, 'SF Mono', Menlo, monospace;
    letter-spacing: 1.2px;
  }
  .pip[data-pose='sleepy'] .pip-sign-text {
    fill: #7a6440;
  }
  .pip-glare {
    stroke: #fff;
    stroke-width: 4;
  }
  .pip-cheeks circle {
    fill: #f49a8c;
    opacity: 0.5;
  }
  .pip[data-pose='wave'] .pip-cheeks circle,
  .pip[data-pose='cheer'] .pip-cheeks circle,
  .pip[data-pose='go'] .pip-cheeks circle {
    opacity: 0.7;
  }
  .pip-face path,
  .pip-face ellipse {
    stroke: #1c1d21;
    stroke-width: 4.5;
  }
  .pip-face .pip-filled {
    fill: #1c1d21;
    stroke-width: 3;
  }
  .pip-pupil {
    fill: #1c1d21;
  }
  .pip-glint {
    fill: #fff;
  }
  .pip-lamp {
    fill: #ffe6ae;
    stroke-width: 5;
  }
  .pip[data-pose='go'] .pip-lamp,
  .pip[data-pose='look'] .pip-lamp {
    fill: #ffd25e;
  }
  .pip[data-pose='sleepy'] .pip-lamp {
    fill: #cfc7bb;
  }
  .pip-beams circle {
    fill: #ffd27a;
    opacity: 0.45;
  }
  .pip-grille {
    fill: #f0956a;
    stroke-width: 4;
  }
  .pip-sweat {
    fill: #8fc3e8;
    stroke: #1c1d21;
    stroke-width: 3.5;
  }
  .pip-moon {
    fill: #ffd27a;
  }
  .pip-z {
    stroke: #8c93a6;
    stroke-width: 4;
  }
  .pip-z-small {
    stroke-width: 3.5;
  }
  .pip-speed path {
    stroke: rgba(28, 29, 33, 0.55);
    stroke-width: 6;
  }
  .pip-sparkle {
    fill: #ffb23e;
    stroke: #1c1d21;
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  /* On asphalt and in dark mode: a soft light rim so his outline shows. */
  .pip-on-dark .pip-bob {
    filter: drop-shadow(0 0 2px rgba(243, 239, 232, 0.55)) drop-shadow(0 0 2px rgba(243, 239, 232, 0.55));
  }

  /* Only the current pose's parts. */
  .pip [data-part] {
    display: none;
  }
  .pip[data-pose='calm'] [data-part~='calm'],
  .pip[data-pose='look'] [data-part~='look'],
  .pip[data-pose='go'] [data-part~='go'],
  .pip[data-pose='uhoh'] [data-part~='uhoh'],
  .pip[data-pose='wave'] [data-part~='wave'],
  .pip[data-pose='sleepy'] [data-part~='sleepy'],
  .pip[data-pose='cheer'] [data-part~='cheer'] {
    display: inline;
  }

  .pip-lean {
    transform-box: view-box;
    transform-origin: 120px 206px;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pip[data-pose='go'] .pip-lean {
    transform: rotate(-6deg);
  }
  .pip[data-pose='look'] .pip-lean {
    transform: rotate(3deg);
  }
  .pip-leaf {
    transform-box: view-box;
    transform-origin: 121px 42px;
  }
  .pip-waving {
    transform-box: view-box;
    transform-origin: 184px 122px;
  }
  .pip-eyes,
  .pip-sparkle,
  .pip-beams circle {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Motion, all small: an engine rumble, a blink, the leaf swaying, a wave,
     speed lines and glowing headlights when it's time to go, a sweat drop,
     drifting z's and twinkling sparkles. Reduce Motion holds him still. */
  @media (prefers-reduced-motion: no-preference) {
    .pip-bob {
      animation: pip-rumble 1.8s ease-in-out infinite;
    }
    .pip[data-pose='go'] .pip-bob {
      animation: pip-dash 1.4s ease-in-out infinite;
    }
    .pip[data-pose='sleepy'] .pip-bob {
      animation: pip-doze 7.2s ease-in-out infinite;
    }
    .pip-leaf {
      animation: pip-sway 5.2s ease-in-out infinite;
    }
    .pip[data-pose='sleepy'] .pip-leaf {
      animation: none;
    }
    .pip-eyes {
      animation: pip-blink 6s infinite;
    }
    .pip-waving {
      animation: pip-wave 1.4s ease-in-out infinite;
    }
    .pip-cheering {
      animation: pip-cheer 1.6s ease-in-out infinite;
    }
    .pip-speed path {
      animation: pip-speed 0.8s linear infinite;
    }
    .pip-beams circle {
      animation: pip-glow 2.4s ease-in-out infinite;
    }
    .pip-sweat {
      animation: pip-drop 1.8s ease-in infinite;
    }
    .pip-z {
      animation: pip-z 3.2s ease-in-out infinite;
    }
    .pip-z-small {
      animation-delay: 1.6s;
    }
    .pip-sparkle {
      animation: pip-twinkle 1.6s ease-in-out infinite alternate;
    }
  }
  @keyframes pip-rumble {
    0%, 100% { transform: translateY(1px); }
    50% { transform: translateY(-2px); }
  }
  @keyframes pip-dash {
    0%, 100% { transform: translate(-2px, 0); }
    50% { transform: translate(3px, -3px); }
  }
  @keyframes pip-doze {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(2px); }
  }
  @keyframes pip-sway {
    0%, 100% { transform: rotate(-9deg); }
    50% { transform: rotate(7deg); }
  }
  @keyframes pip-blink {
    0%, 93%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  @keyframes pip-wave {
    0%, 100% { transform: rotate(-14deg); }
    50% { transform: rotate(12deg); }
  }
  @keyframes pip-cheer {
    0%, 100% { transform: translateY(2px); }
    50% { transform: translateY(-5px); }
  }
  @keyframes pip-speed {
    0% { transform: translateX(26px); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translateX(-30px); opacity: 0; }
  }
  @keyframes pip-glow {
    0%, 100% { transform: scale(0.85); opacity: 0.25; }
    50% { transform: scale(1.15); opacity: 0.6; }
  }
  @keyframes pip-drop {
    0% { transform: translateY(-4px); opacity: 0; }
    25% { opacity: 1; }
    100% { transform: translateY(10px); opacity: 0; }
  }
  @keyframes pip-z {
    0% { transform: translate(0, 6px); opacity: 0; }
    30% { opacity: 1; }
    100% { transform: translate(10px, -16px); opacity: 0; }
  }
  @keyframes pip-twinkle {
    from { transform: scale(0.5); opacity: 0.3; }
    to { transform: scale(1.1); opacity: 1; }
  }
</style>
