---
interface Props {
  tagline?: string;
  title: string;
  subtitle: string;
  primaryCTA: { text: string; href: string };
}

const { tagline, title, subtitle, primaryCTA } = Astro.props;
---

<section class="mobile-hero lg:hidden">
  <!-- Aurora orbs -->
  <div class="aurora-orb aurora-orb-primary orb-1"></div>
  <div class="aurora-orb aurora-orb-cyan orb-2"></div>

  <!-- Subtle grid background -->
  <div class="grid-bg"></div>

  <div class="hero-content">
    <!-- Header Section -->
    <div class="header-section">
      {tagline && (
        <p class="tagline">
          <span class="tagline-dot"></span>
          {tagline}
        </p>
      )}

      <h1 class="brand-title">
        <span class="title-line">Technology that</span>
        <span class="title-line title-accent"><span class="gradient-word">accelerates</span></span>
        <span class="title-line">your <em>mission.</em></span>
      </h1>

      <p class="tagline-text">{subtitle}</p>

      <a href={primaryCTA.href} class="cta-button">
        {primaryCTA.text}
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Quick Links Stack -->
    <div class="cards-stack">
      <a href="#services" class="priority-card">
        <span class="card-number">01</span>
        <div class="card-content">
          <h3 class="card-title">What We Do</h3>
          <p class="card-desc">Mobile & web apps that delight users</p>
        </div>
        <svg class="card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <a href="#our-work" class="priority-card">
        <span class="card-number">02</span>
        <div class="card-content">
          <h3 class="card-title">Our Work</h3>
          <p class="card-desc">Golf Channel, Radio Disney & more</p>
        </div>
        <svg class="card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <a href="#testimonials" class="priority-card">
        <span class="card-number">03</span>
        <div class="card-content">
          <h3 class="card-title">Client Reviews</h3>
          <p class="card-desc">"Exceeded expectations..." — 5 stars</p>
        </div>
        <svg class="card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <a href="#leadership" class="priority-card">
        <span class="card-number">04</span>
        <div class="card-content">
          <h3 class="card-title">About</h3>
          <p class="card-desc">20+ years building for Fortune 500</p>
        </div>
        <svg class="card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Trusted by -->
    <div class="trusted-bar">
      <p class="trusted-text">Trusted by teams at Disney, Golf Channel & IF:Gathering</p>
    </div>
  </div>
</section>

<style>
  .mobile-hero {
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    padding-top: 80px;
  }

  /* Subtle grid background */
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border-color) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-color) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.3;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse at top, #000 20%, transparent 70%);
            mask-image: radial-gradient(ellipse at top, #000 20%, transparent 70%);
  }

  /* Aurora orbs */
  .orb-1 {
    width: 360px;
    height: 360px;
    top: -10%;
    right: -20%;
  }

  .orb-2 {
    width: 280px;
    height: 280px;
    bottom: 10%;
    left: -25%;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Header Section */
  .header-section {
    text-align: center;
  }

  .tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.75rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--gradient-aurora-soft);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-pill);
    margin-bottom: 1.5rem;
  }

  .tagline-dot {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent);
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
  }

  .title-line {
    display: block;
  }

  .title-accent {
    display: block;
  }

  .gradient-word {
    background: var(--gradient-aurora);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  .brand-title em {
    font-style: italic;
    color: var(--text-muted);
  }

  .tagline-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--gradient-aurora);
    background-size: 200% 200%;
    color: white;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 1rem 2rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-glow);
  }

  .cta-button:active {
    transform: scale(0.98);
    background-position: 100% 100%;
  }

  .btn-arrow {
    transition: transform 0.3s ease;
  }

  /* Cards Stack */
  .cards-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .priority-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .priority-card:active {
    transform: scale(0.98);
    border-color: var(--accent);
    box-shadow: var(--shadow-glow);
  }

  .card-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
    min-width: 24px;
  }

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-arrow {
    color: var(--text-muted);
    opacity: 0.5;
    transition: all 0.3s ease;
  }

  .priority-card:active .card-arrow {
    color: var(--accent);
    opacity: 1;
    transform: translateX(2px);
  }

  /* Trusted bar */
  .trusted-bar {
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-color);
    margin-top: 0.5rem;
  }

  .trusted-text {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
    margin: 0;
  }

  /* Hide on desktop */
  @media (min-width: 1024px) {
    .mobile-hero {
      display: none;
    }
  }
</style>
