---
import type { Project } from '../data/projects';
import Paint from './site/Paint.astro';
interface Props {
  project: Project;
  large?: boolean;
  /** Heading level inside the card. */
  level?: 'h2' | 'h3';
}
const { project: p, large = false, level = 'h3' } = Astro.props;
const Heading = level;
---

<a class:list={['project-card', { large }]} href={`/work/${p.slug}/`} data-category={p.type}>
  <div class="project-art">
    <Paint src={p.art} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
    <span class="client-chip">
      <img src={p.image} alt="" width="30" height="30" loading="lazy" decoding="async" />
      {p.client}
    </span>
  </div>
  <div class="project-meta">
    <span class="meta">{p.category}</span>
    <span class="meta">{p.platform}</span>
  </div>
  <Heading class="h3">{p.name} <span class="arrow" aria-hidden="true">→</span></Heading>
  <p>{p.short}</p>
</a>
