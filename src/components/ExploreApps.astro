---
import { visibleApps } from '../data/apps';
interface Props {
  current: string;
}
const { current } = Astro.props;
const visible = visibleApps;
const currentIndex = visible.findIndex((app) => app.slug === current);
const others = [...visible.slice(currentIndex + 1), ...visible.slice(0, currentIndex + 1)]
  .filter((app) => app.slug !== current)
  .slice(0, 3);
---

<section class="app-discovery" aria-labelledby="app-discovery-title">
  <div class="app-discovery-inner">
    <div class="app-discovery-heading">
      <div>
        <p class="app-discovery-label">More from Idle Fusion</p>
        <h2 id="app-discovery-title">Find your next everyday app.</h2>
      </div>
      <a class="app-discovery-all" href="/apps/">View all {visible.length} apps ↗</a>
    </div>
    <div class="app-discovery-grid">
      {
        others.map((app) => (
          <a class="app-discovery-card" href={`/${app.slug}/`}>
            <>
              <img src={app.icon} width="56" height="56" alt="" loading="lazy" />
              <div>
                <>
                  <p class="app-discovery-category">{app.category}</p>
                  <h3>{app.name} ↗</h3>
                  <p class="app-discovery-desc">{app.desc}</p>
                </>
              </div>
            </>
          </a>
        ))
      }
    </div>
  </div>
</section>
<style>
  .app-discovery {
    background: #0a0a0a;
    color: #ffffff;
    padding: 64px 0;
    font-family: 'Work Sans', sans-serif;
    border-block: 1px solid #262626;
  }
  .app-discovery-inner {
    max-width: 72rem;
    margin: auto;
    padding: 0 1.5rem;
  }
  .app-discovery-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 32px;
  }
  .app-discovery-label {
    color: #2aabee;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 15px;
  }
  .app-discovery h2 {
    color: white;
    font:
      500 clamp(26px, 3vw, 36px)/1.15 'Work Sans',
      sans-serif;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .app-discovery-all {
    color: #ffffff;
    font-size: 12px;
    text-decoration: none;
    border-bottom: 1px solid #777;
    padding-bottom: 5px;
    white-space: nowrap;
  }
  .app-discovery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .app-discovery-card {
    display: flex;
    align-items: start;
    gap: 16px;
    border-top: 1px solid #333;
    padding-top: 24px;
    text-decoration: none;
    color: white;
  }
  .app-discovery-card > div {
    min-width: 0;
  }
  .app-discovery-card img {
    width: 56px;
    height: 56px;
    border-radius: 13px;
    flex: none;
  }
  .app-discovery-category {
    color: #bcbcbc;
    font-size: 9px;
    line-height: 1.5;
    margin: 0 0 7px;
  }
  .app-discovery h3 {
    color: white;
    font:
      500 19px/1.2 'Work Sans',
      sans-serif;
    letter-spacing: -0.03em;
    margin: 0 0 9px;
  }
  .app-discovery-desc {
    color: #bcbcbc;
    font-size: 12px;
    line-height: 1.6;
    margin: 0;
  }
  .app-discovery a:hover,
  .app-discovery a:hover h3 {
    color: #2aabee;
  }
  .app-discovery a:focus-visible {
    outline: 2px solid #2aabee;
    outline-offset: 6px;
  }
  @media (min-width: 1024px) {
    .app-discovery-inner {
      padding-inline: 3rem;
    }
  }
  @media (max-width: 800px) {
    .app-discovery-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .app-discovery-heading {
      flex-direction: column;
      align-items: start;
    }
    .app-discovery {
      padding-block: 45px;
    }
  }
</style>
