---
import '../styles/site.css';
import Analytics from '../components/Analytics.astro';
import Fonts from '../components/Fonts.astro';
import FusionMark from '../components/site/FusionMark.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { defaultSocialImage, organizationSchema, siteOrigin } from '../data/site';
interface Props {
  title: string;
  description: string;
  active?: string;
  ogImage?: string;
  robots?: string;
  /** The painted "start a project" block before the footer. Off on /contact/. */
  closingCta?: boolean;
  /** Tailor that block: heading HTML, where the button goes, and its analytics name. */
  cta?: { heading?: string; href?: string; track?: string };
}
const {
  title,
  description,
  active = '',
  ogImage = defaultSocialImage,
  robots = 'index, follow',
  closingCta = true,
  cta = {},
} = Astro.props;
const ctaHeading = cta.heading ?? 'Have an idea? Let’s <span class="hand">sketch it out.</span>';
const ctaHref = cta.href ?? '/contact/';
const ctaTrack = cta.track ?? 'cta_footer';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteOrigin).href;
const pageTitle = `${title} — Idle Fusion`;
const socialImage = new URL(ogImage, Astro.site ?? siteOrigin).href;
const nav = [
  ['Work', 'work'],
  ['Services', 'services'],
  ['Studio', 'studio'],
  ['Apps', 'apps'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Idle Fusion" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181613" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png" />
    <Fonts />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <div class="wrap header-inner">
        <a class="wordmark" href="/" aria-label="Idle Fusion home">
          <FusionMark /><span class="word">idle fusion<span class="dot">.</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {
            nav.map(([label, slug]) => (
              <a href={`/${slug}/`} aria-current={active === slug ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
        <a class="btn small header-cta" href="/contact/" data-track="cta_header">
          <span class="btn-text">Start a project</span><span class="btn-arrow" aria-hidden="true"
            >→</span
          >
        </a>
        <details class="mobile-nav">
          <summary aria-label="Toggle navigation"
            >Menu <span class="bars" aria-hidden="true"></span></summary
          >
          <nav aria-label="Mobile navigation">
            {
              nav.map(([label, slug]) => (
                <a href={`/${slug}/`} aria-current={active === slug ? 'page' : undefined}>
                  {label} <span aria-hidden="true">→</span>
                </a>
              ))
            }
            <a href="/open-source/" aria-current={active === 'open-source' ? 'page' : undefined}
              >Open source <span aria-hidden="true">→</span></a
            >
            <a class="btn block" href="/contact/" data-track="cta_header">
              <span class="btn-text">Start a project</span><span
                class="btn-arrow"
                aria-hidden="true">→</span
              >
            </a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    {
      closingCta && (
        <section class="wrap cta-paint" aria-labelledby="closing-cta-title" data-closing-cta>
          <picture>
            <source
              media="(prefers-color-scheme: dark) and (max-width: 700px)"
              srcset="/img/paint/night/cta-wash-tall.webp"
            />
            <source media="(prefers-color-scheme: dark)" srcset="/img/paint/night/cta-wash.webp" />
            <source media="(max-width: 700px)" srcset="/img/paint/cta-wash-tall.webp" />
            <img
              class="wash paint"
              src="/img/paint/cta-wash.webp"
              alt=""
              loading="lazy"
              decoding="async"
              width="2400"
              height="1000"
            />
          </picture>
          <div class="cta-inner">
            <p class="label">
              <span class="status-dot" /> Start a project
            </p>
            <h2 id="closing-cta-title" set:html={ctaHeading} />
            <div class="cta-side">
              <p>
                Tell us what you’re building. Matthew reads every note himself and usually replies
                within one business day.
              </p>
              <a class="btn light" href={ctaHref} data-track={ctaTrack}>
                <span class="btn-text">Start a project</span>
                <span class="btn-arrow" aria-hidden="true">
                  →
                </span>
              </a>
              <a class="mail" href="mailto:hello@idlefusion.com">
                or email hello@idlefusion.com
              </a>
            </div>
          </div>
        </section>
      )
    }
    <SiteFooter />
    {
      closingCta && (
        <a class="btn block sticky-cta" href="/contact/" data-track="cta_sticky" data-sticky-cta>
          <span class="btn-text">Start a project</span>
          <span class="btn-arrow" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
    <Analytics />
    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const onScroll = () => header?.toggleAttribute('data-scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Phones: a slim "start a project" bar once the visitor has scrolled past the
      // first screen, tucked away again when the closing call to action is on screen.
      const sticky = document.querySelector<HTMLElement>('[data-sticky-cta]');
      const closing = document.querySelector('[data-closing-cta]');
      if (sticky && 'IntersectionObserver' in window) {
        let pastFold = false;
        let closingVisible = false;
        const update = () => sticky.toggleAttribute('data-visible', pastFold && !closingVisible);
        addEventListener(
          'scroll',
          () => {
            pastFold = scrollY > innerHeight * 0.9;
            update();
          },
          { passive: true },
        );
        if (closing)
          new IntersectionObserver(([entry]) => {
            closingVisible = entry.isIntersecting;
            update();
          }).observe(closing);
      }

      // Close the phone menu after choosing a destination on the same page.
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      menu
        ?.querySelectorAll('a')
        .forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    </script>
  </body>
</html>
