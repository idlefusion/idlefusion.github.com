---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogUrl?: string;
}

const {
  title,
  description,
  ogImage = '/img/logo.png',
  ogUrl = 'https://idlefusion.com'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <meta name="keywords" content="app development, web development, mobile apps, consulting, digital agency, software development">
    <meta name="author" content="Matthew Strickland, Idle Fusion LLC">
    <meta name="robots" content="index, follow">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:url" content={ogUrl}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Idle Fusion">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/favicon.svg">

    <!-- Theme Color -->
    <meta name="theme-color" content="#0a0a0a">
    <meta name="msapplication-TileColor" content="#0a0a0a">

    <title>{title}</title>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:wght@400;500;600;700&family=Source+Serif+4:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&family=EB+Garamond:wght@400;500;600;700&family=Raleway:wght@400;500;600;700&family=Lora:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Crimson+Pro:wght@400;500;600;700&family=Work+Sans:wght@400;500;600;700&family=Sora:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Libre+Franklin:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Satoshi Font from Fontshare -->
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet">

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Theme initialization (prevents flash of wrong theme) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Font Switcher Initialization -->
    <script is:inline>
      (function() {
        var params = new URLSearchParams(window.location.search);
        var opt = params.get('fonts') || localStorage.getItem('fontOption') || '';
        if (['0','a','b','c','d','e','f','g','h','i'].includes(opt)) {
          document.documentElement.setAttribute('data-fonts', opt);
          localStorage.setItem('fontOption', opt);
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-secondary)] transition-colors duration-300">
    <slot />
    <div id="font-switcher" style="position:fixed;bottom:20px;right:20px;z-index:9999;display:grid;grid-template-columns:repeat(5,1fr);gap:6px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:8px;padding:12px;box-shadow:var(--shadow-lg);font-family:sans-serif;font-size:12px;align-items:center;"><span style="grid-column:1/-1;color:var(--text-muted);font-weight:500;text-align:center;font-size:11px;margin-bottom:4px;">Font Options</span><a href="?" class="fs-btn" data-font="0" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">0</a><a href="?fonts=a" class="fs-btn" data-font="a" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">A</a><a href="?fonts=b" class="fs-btn" data-font="b" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">B</a><a href="?fonts=c" class="fs-btn" data-font="c" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">C</a><a href="?fonts=d" class="fs-btn" data-font="d" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">D</a><a href="?fonts=e" class="fs-btn" data-font="e" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">E</a><a href="?fonts=f" class="fs-btn" data-font="f" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">F</a><a href="?fonts=g" class="fs-btn" data-font="g" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">G</a><a href="?fonts=h" class="fs-btn" data-font="h" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">H</a><a href="?fonts=i" class="fs-btn" data-font="i" style="padding:6px 10px;border-radius:4px;text-decoration:none;color:var(--text-secondary);border:1px solid var(--border-color);transition:all .2s;text-align:center;font-weight:500;">I</a></div>
    <script is:inline>
      (function(){
        var current = document.documentElement.getAttribute("data-fonts") || "0";
        document.querySelectorAll(".fs-btn").forEach(function(btn){
          if(btn.dataset.font === current) {
            btn.style.background = "var(--accent)";
            btn.style.color = "white";
            btn.style.borderColor = "var(--accent)";
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    color: var(--text-secondary);
    background-color: var(--bg-primary);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    transition: background-color 0.3s, color 0.3s;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    flex: 1;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--scrollbar-track);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-thumb-hover);
  }
</style>
