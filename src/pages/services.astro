---
import Layout from '../layouts/SiteLayout.astro';
import Process from '../components/site/Process.astro';
import Faq from '../components/site/Faq.astro';

const services = [
  {
    id: 'mobile',
    number: '01',
    name: 'Mobile apps',
    art: '/img/paint/service-mobile.webp',
    description:
      'Native apps that feel right from the first tap. We bring product thinking and careful engineering to the devices your customers use every day, from the first prototype to the App Store and every release after.',
    get: [
      'iOS & Android applications',
      'Apple Watch experiences',
      'Interface design & prototyping',
      'App launch & ongoing development',
    ],
    fit: [
      'You’re turning an idea into a first release',
      'An existing app needs rebuilding, extending, or bringing up to date',
      'Your brand needs a native companion to its website or broadcast',
    ],
    related: [
      ['Radio Disney', '/work/radio-disney/'],
      ['Golf Channel Academy', '/work/golf-channel-academy/'],
      ['Easy Digital Downloads', '/work/easy-digital-downloads/'],
    ],
    cta: 'Plan a mobile app',
  },
  {
    id: 'web',
    number: '02',
    name: 'Websites & platforms',
    art: '/img/paint/service-web.webp',
    description:
      'A clear, useful home for your business online. From a focused marketing site to a connected platform, we build around what your audience needs to do, and make it fast and accessible.',
    get: [
      'Business & marketing websites',
      'Custom web applications',
      'Platform & API integrations',
      'Performance & accessibility',
    ],
    fit: [
      'Your site isn’t bringing in the inquiries it should',
      'Your team or customers need a tool they’ll use every day',
      'Separate systems need to work together',
    ],
    related: [['Everybody Everywhere', '/work/everybody-everywhere/']],
    cta: 'Plan a website',
  },
  {
    id: 'strategy',
    number: '03',
    name: 'Technical direction',
    art: '/img/paint/service-direction.webp',
    description:
      'Experienced perspective for the decisions that matter. Clarify the opportunity, choose a practical path, and give your team the confidence to move forward.',
    get: [
      'Product discovery & roadmaps',
      'Architecture & technical planning',
      'Engineering team guidance',
      'Coaching for developers and leads',
    ],
    fit: [
      'You’re choosing a platform, a stack, or a partner',
      'Your team is stuck, or growing faster than its habits',
      'You want a senior second opinion before committing budget',
    ],
    related: [],
    cta: 'Talk it through',
  },
];

const engagements = [
  {
    name: 'Project build',
    meta: 'Most common',
    text: 'A defined product or release, taken from a focused plan to launch, with regular check-ins and working software along the way.',
    href: '/contact/',
    link: 'Start a project',
  },
  {
    name: 'Ongoing partnership',
    meta: 'For products that keep evolving',
    text: 'A steady, senior presence after launch: new features, platform updates, and the improvements that come with real-world use.',
    href: '/contact/',
    link: 'Talk about a partnership',
  },
  {
    name: 'Advisory & coaching',
    meta: 'For teams building themselves',
    text: 'Focused time for the big decisions, architecture and code reviews, and helping your developers grow.',
    href: '/contact/?service=coaching',
    link: 'Ask about coaching',
  },
];
---

<Layout
  title="Services"
  active="services"
  description="iOS and Apple Watch app development, websites and web platforms, and technical direction. How Idle Fusion works with you, from first question to next release."
>
  <section class="page-intro wrap">
    <span class="label"><span class="idx">Services</span> What we do</span>
    <h1 class="h1">Senior design & engineering, <span class="hand">start to finish.</span></h1>
    <div class="intro-row">
      <p class="lede">
        Thoughtful design, experienced development, and a practical partner from the first question
        to the next release. Choose a starting point, or bring a problem and we’ll find its shape
        together.
      </p>
      <a class="btn" href="/contact/" data-track="cta_hero">
        <span class="btn-text">Start a project</span><span class="btn-arrow" aria-hidden="true"
          >→</span
        >
      </a>
    </div>
    <nav class="service-nav" aria-label="On this page">
      {
        services.map((s) => (
          <a href={`#${s.id}`}>
            <span>{s.number}</span>
            {s.name}
          </a>
        ))
      }
      <a href="#engagements"><span>04</span>Ways to work together</a>
      <a href="#process"><span>05</span>Process</a>
    </nav>
  </section>

  <section class="wrap" aria-label="Practices">
    {
      services.map((s) => (
        <article class="service-detail" id={s.id}>
          <div class="art">
            <span class="label">
              <span class="idx">{s.number}</span> Practice
            </span>
            <img
              class="paint"
              src={s.art}
              alt=""
              width="720"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="content">
            <h2 class="h2">{s.name}</h2>
            <p>{s.description}</p>
            <div class="service-cols">
              <div>
                <h3>What you get</h3>
                <ul class="ticks">
                  {s.get.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3>A good fit if</h3>
                <ul class="ticks">
                  {s.fit.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
            {s.related.length > 0 && (
              <p class="proof-line">
                Related work:{' '}
                {s.related.map(([name, href], i) => (
                  <Fragment>
                    <a href={href}>{name}</a>
                    {i < s.related.length - 1 && ', '}
                  </Fragment>
                ))}
              </p>
            )}
            {s.id === 'strategy' && (
              <p class="proof-line">
                “Matthew’s expertise and leadership were invaluable to our team.” — Roger Walker,
                Assurance Systems, Inc.
              </p>
            )}
            <div class="actions">
              <a class="btn small" href={`/contact/?service=${s.id}`} data-track="cta_service">
                <span class="btn-text">{s.cta}</span>
                <span class="btn-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="section wrap" id="engagements" aria-labelledby="engage-title">
    <header class="section-head">
      <span class="label"><span class="idx">04</span> Ways to work together</span>
    </header>
    <div class="section-title">
      <h2 id="engage-title">Sized to what you <span class="hand ochre">actually need.</span></h2>
      <p>Not sure which fits? Start a conversation and we’ll suggest one; there’s no wrong door.</p>
    </div>
    <div class="engagements">
      {
        engagements.map((e) => (
          <article class="engagement">
            <span class="meta">{e.meta}</span>
            <h3 class="h3">{e.name}</h3>
            <p>{e.text}</p>
            <a class="link-arrow" href={e.href} data-track="cta_service">
              {e.link} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id="process" aria-labelledby="process-title" style="padding-top:0">
    <header class="section-head">
      <span class="label"><span class="idx">05</span> The process</span>
    </header>
    <div class="section-title">
      <h2 id="process-title">Clear steps. <span class="hand cerulean">Shared momentum.</span></h2>
      <p>The same simple shape, whether it’s a short advisory engagement or a multi-month build.</p>
    </div>
    <Process />
  </section>

  <section class="section tight wrap" aria-label="Client testimonial" style="padding-top:0">
    <figure class="quote-block">
      <blockquote>
        “Matthew’s expertise and leadership were invaluable to our team. He consistently delivered
        innovative solutions and strategic guidance.”
      </blockquote>
      <figcaption class="label">Roger Walker · Assurance Systems, Inc.</figcaption>
    </figure>
  </section>

  <section class="section wrap" aria-label="Frequently asked questions">
    <Faq heading="Before you reach out." />
  </section>
</Layout>
