---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Macro Easy - Privacy Policy"
  description="Privacy policy for Macro Easy"
  ogUrl="https://idlefusion.com/macro-easy/privacy"
>
  <main>
    <section class="section-padding">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-2">Privacy Policy</h1>
        <p class="text-sm text-[var(--text-secondary)] mb-12">Macro Easy - Simple Macro Tracking &middot; Effective February 23, 2026</p>
        <div class="space-y-8 text-[var(--text-secondary)] leading-relaxed">
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Short version</h2>
            <p>Macro Easy stores your nutrition data on your device and does not sell or share your entries.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Storage</h2>
            <p>Targets, entries, and history are stored locally on your iPhone. There are no user accounts and no server-side profiles.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">What is optional</h2>
            <p>Health app integration is optional and only used when you grant permission. We do not use these entries for tracking or ads.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Contact</h2>
            <p>Privacy questions are welcome at <a href="mailto:support@idlefusion.com?subject=Macro%20Easy%20Privacy" class="text-[var(--accent-primary)] hover:underline">support@idlefusion.com</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
