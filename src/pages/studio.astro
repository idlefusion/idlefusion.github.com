---
import Layout from '../layouts/SiteLayout.astro';
import { founderSchema } from '../data/site';
import { visibleApps } from '../data/apps';

const values = [
  [
    'Direct by default.',
    'A close working relationship with the person building your product. Clear conversations, shared context, and practical decisions.',
  ],
  [
    'Simple takes care.',
    'The details matter because people feel them. We look for the clearest path through complexity and give it the attention it deserves.',
  ],
  [
    'Invested beyond launch.',
    'Software keeps evolving. We value lasting partnerships and the steady improvements that make a good product better.',
  ],
];
---

<Layout
  title="The studio"
  active="studio"
  description="Meet Matthew Strickland, Idle Fusion’s founder, with 20+ years building apps and digital products for Disney, NBC Sports, and independent teams."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(founderSchema)} />
  <section class="wrap studio-hero">
    <div class="copy">
      <span class="label"><span class="idx">Studio</span> Hello, we’re Idle Fusion</span>
      <h1 class="h1">Good work starts with <span class="hand">good people.</span></h1>
      <p class="body-copy">
        I’m Matthew Strickland, founder of Idle Fusion. I’ve spent more than 20 years helping people
        turn ambitious ideas into useful digital products.
      </p>
      <p class="body-copy">
        From mobile experiences for Disney and NBC to independent apps for everyday life, the goal
        is the same: make technology feel simple, thoughtful, and worth using. When you work with
        Idle Fusion, you work with me, from the first call to the next release.
      </p>
      <div class="actions">
        <a class="btn" href="/contact/" data-track="cta_founder">
          <span class="btn-text">Talk with Matthew</span><span class="btn-arrow" aria-hidden="true"
            >→</span
          >
        </a>
        <a class="link-arrow" href="/work/">See the work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="portrait">
      <img
        class="paint"
        src="/img/paint/portrait-matthew.webp"
        alt="Matthew Strickland, founder of Idle Fusion"
        width="768"
        height="1024"
        fetchpriority="high"
      />
      <figcaption class="label">Matthew Strickland · Founder & technology partner</figcaption>
    </figure>
  </section>

  <section class="section wrap" aria-labelledby="values-title">
    <header class="section-head">
      <span class="label"><span class="idx">01</span> How we work</span>
    </header>
    <div class="section-title">
      <h2 id="values-title">
        Small studio. <span class="hand cerulean">Considered</span> by design.
      </h2>
      <p>Three habits that shape every project, whatever its size.</p>
    </div>
    <div class="values">
      {
        values.map(([title, text]) => (
          <article class="value">
            <h3 class="h3">{title}</h3>
            <p>{text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section wrap" aria-labelledby="making-title" style="padding-top:0">
    <header class="section-head">
      <span class="label"><span class="idx">02</span> Always making</span>
    </header>
    <div class="section-title">
      <h2 id="making-title">A builder’s curiosity. An owner’s perspective.</h2>
      <p>
        We build our own apps and share tools with other developers. That hands-on practice informs
        the care we bring to every client project.
      </p>
    </div>
    <div class="making">
      <a href="/apps/">
        <div class="icons">
          <img src="/img/breathe-easy/icon.png" alt="" width="52" height="52" loading="lazy" />
          <img src="/img/contrast/icon.png" alt="" width="52" height="52" loading="lazy" />
          <img src="/img/track-easy/icon.png" alt="" width="52" height="52" loading="lazy" />
        </div>
        <span class="meta">In-house products · {visibleApps.length} apps</span>
        <h3 class="h3">Small apps. Useful things.</h3>
        <p>Purpose-built, privacy-minded tools for health, focus, and everyday life.</p>
        <span class="link-arrow">Explore our apps <span aria-hidden="true">→</span></span>
      </a>
      <a href="/open-source/">
        <code class="oss-chip">swift package · healthkit-run-generator</code>
        <span class="meta">Open source</span>
        <h3 class="h3">Good tools are worth sharing.</h3>
        <p>Practical resources for the developer community, born from real projects.</p>
        <span class="link-arrow">See what we’re sharing <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>
</Layout>
