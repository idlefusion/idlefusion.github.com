---
// Where the contact form lands when it is submitted without JavaScript.
import ContactNextSteps from '../../components/ContactNextSteps.astro';
import Layout from '../../layouts/SiteLayout.astro';
---

<Layout
  title="Thanks for getting in touch"
  description="Your message is on its way to Idle Fusion."
  robots="noindex, follow"
  closingCta={false}
>
  <section class="page-intro wrap">
    <span class="label"><span class="status-dot"></span> Message sent</span>
    <h1 class="h1">Thanks. Your message is on its <span class="hand">way.</span></h1>
    <div class="intro-row" style="align-items:start">
      <div style="display:grid;gap:14px;max-width:34em;width:100%">
        <p class="label">What happens next</p>
        <ContactNextSteps />
      </div>
      <a class="link-arrow" href="/work/"
        >While you wait, see selected work <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</Layout>
