---
// The home page used to live here. In production public/_redirects answers
// with a 301; this page is the fallback, and it keeps #section links working.
const target = '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://idlefusion.com/" />
    <title>Idle Fusion</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <a href={target}>Continue to Idle Fusion</a>
  </body>
</html>
