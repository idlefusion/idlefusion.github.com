  headline: 'Log supplements consistently with simple reminders.',
  description: 'Dose Easy helps you build a reliable supplement routine with dose logs, reminders, and daily checklists that keep your health habits visible and easy to follow.',
  icon: '/img/dose-easy/icon.png',
  appStoreUrl: '#',
  appStoreNote: 'Free &middot; No account required',
  accent: '#14b8a6',
  accentDeep: '#0d9488',
  screenshots: [
    { src: '01_today_checklist.png', label: 'Today checklist' },
    { src: '02_supplement_list.png', label: 'Supplement library' },
    { src: '03_history.png', label: 'History and adherence' },
    { src: '04_dark_mode.png', label: 'Dark mode' },
    { src: '04_settings_themes.png', label: 'Advanced reminders' },
    { src: '05_themes.png', label: 'Theme options' },
  ],
