---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dose Easy - Privacy Policy"
  description="Privacy policy for Dose Easy"
  ogUrl="https://idlefusion.com/dose-easy/privacy"
>
  <main>
    <section class="section-padding">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-2">Privacy Policy</h1>
        <p class="text-sm text-[var(--text-secondary)] mb-12">Dose Easy - Supplement & Vitamin Tracker &middot; Effective February 23, 2026</p>
        <div class="space-y-8 text-[var(--text-secondary)] leading-relaxed">
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Short version</h2>
            <p>Dose Easy is privacy-first: no accounts, no ads, and no third-party analytics services are used for dose tracking.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Data stored</h2>
            <p>Supplement names, doses, reminders, and completion logs are kept locally with no hidden remote upload.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Notifications</h2>
            <p>Reminders are generated locally by iOS notification scheduling and are not tied to account-level tracking.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Contact</h2>
            <p>Have privacy questions? Email <a href="mailto:support@idlefusion.com?subject=Dose%20Easy%20Privacy" class="text-[var(--accent-primary)] hover:underline">support@idlefusion.com</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
