---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ExploreApps from '../../components/ExploreApps.astro';
---

<BaseLayout
  title="Temp Easy — Body Temperature Tracker for iOS"
  description="Track body temperature for the whole family. Log readings, see trends with fever alerts, and export reports for your doctor. No accounts, no subscriptions."
  ogImage="/img/temp-easy/icon.png"
  ogUrl="https://idlefusion.com/temp-easy"
>

  <!-- App Nav -->
  <nav class="te-nav">
    <div class="te-nav-inner">
      <a href="/temp-easy" class="te-logo">Temp Easy</a>
      <div class="te-nav-actions">
        <ThemeToggle />
        <a href="https://apps.apple.com/app/id0000000000" class="te-nav-cta" target="_blank" rel="noopener noreferrer">
          <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="40" />
        </a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero — Dark, bold -->
    <section class="te-hero">
      <div class="te-hero-glow te-hero-glow--primary"></div>
      <div class="te-hero-glow te-hero-glow--secondary"></div>
      <div class="te-hero-inner">
        <div class="te-hero-content">
          <div class="te-hero-text">
            <div class="te-hero-badge">TEMPERATURE TRACKER</div>
            <h1 class="te-hero-title">
              Track temperature,<br/><em>for the whole family.</em>
            </h1>
            <p class="te-hero-subtitle">
              Log readings, monitor symptoms, and share reports with your doctor. All your family's health data stays on your device — no accounts, no cloud sync, no subscriptions.
            </p>
            <div class="te-hero-actions">
              <a href="https://apps.apple.com/app/id0000000000" class="te-store-badge" target="_blank" rel="noopener noreferrer">
                <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
              </a>
              <span class="te-hero-note">Free &middot; No account required</span>
            </div>
          </div>
          <div class="te-hero-icon-wrap">
            <img src="/img/temp-easy/icon.png" alt="Temp Easy app icon" class="te-hero-icon" width="240" height="240" />
          </div>
        </div>
      </div>
    </section>

    <!-- Screenshots -->
    <section class="te-screenshots">
      <div class="app-screenshots-scroll">
          <img src="/img/temp-easy/screenshots/01_marketing.png" alt="Temp Easy screenshot 1" class="app-screenshot" />
          <img src="/img/temp-easy/screenshots/02_marketing.png" alt="Temp Easy screenshot 2" class="app-screenshot" />
          <img src="/img/temp-easy/screenshots/03_marketing.png" alt="Temp Easy screenshot 3" class="app-screenshot" />
          <img src="/img/temp-easy/screenshots/04_marketing.png" alt="Temp Easy screenshot 4" class="app-screenshot" />
          <img src="/img/temp-easy/screenshots/05_marketing.png" alt="Temp Easy screenshot 5" class="app-screenshot" />
          <img src="/img/temp-easy/screenshots/06_marketing.png" alt="Temp Easy screenshot 6" class="app-screenshot" />
        </div>
    </section>

    <!-- Features — Two-column with large cards -->
    <section class="te-features-section">
      <div class="te-container-wide">
        <div class="te-features-header">
          <span class="te-label-dark">FEATURES</span>
          <h2 class="te-features-title">Built for your family's health.</h2>
        </div>

        <div class="te-features">
          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10h-10V2z"/><path d="M12 12 2 2"/><circle cx="12" cy="12" r="8"/></svg>
            </div>
            <h3>Multi-Person Profiles</h3>
            <p>Create profiles for each family member with custom fever thresholds by age. Track everyone's temperature in one app.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <h3>Trend Charts</h3>
            <p>Visualize temperature changes over time with beautiful charts. Track up to 30 readings per person to spot patterns and recovery.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2v20M6.5 6h6M6.5 10h6M6.5 14h6M6.5 18h6"/></svg>
            </div>
            <h3>Symptom Tracking</h3>
            <p>Log symptoms alongside each reading — headache, cough, fatigue, and more. See the full picture of how everyone's feeling.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3>Medication Logging</h3>
            <p>Record medications and doses with timestamps. Keep track of what was given and when, especially useful for children's medicine.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3>Export for Doctors</h3>
            <p>Generate CSV or text reports with all readings, symptoms, and medications. Share via email or print for your next doctor's visit.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <h3>HealthKit Sync</h3>
            <p>Optionally sync with Apple Health. Read existing temperature data or write new readings. Your health data stays unified in one place.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Fever Thresholds Section -->
    <section class="te-categories">
      <div class="te-container">
        <div class="te-categories-header">
          <span class="te-label-dark">FEVER THRESHOLDS</span>
          <h2 class="te-categories-title">Know when to worry.</h2>
          <p class="te-categories-subtitle">Temperature readings are color-coded based on standard medical guidelines for fever detection.</p>
        </div>
        <div class="te-categories-grid">
          <div class="te-category te-category--normal">
            <span class="te-category-label">Normal</span>
            <span class="te-category-range">&lt; 99.1°F / 37.3°C</span>
          </div>
          <div class="te-category te-category--elevated">
            <span class="te-category-label">Elevated</span>
            <span class="te-category-range">99.1–100.4°F / 37.3–38.0°C</span>
          </div>
          <div class="te-category te-category--fever">
            <span class="te-category-label">Fever</span>
            <span class="te-category-range">≥ 100.4°F / 38.0°C</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy — Full-width dark banner -->
    <section class="te-privacy-banner">
      <div class="te-container">
        <div class="te-privacy-inner">
          <span class="te-label-dark">PRIVACY</span>
          <h2 class="te-privacy-title">Your family's health data stays yours.</h2>
          <p class="te-privacy-text">
            No analytics. No ads. No tracking pixels. No telemetry.<br/>
            Your temperature readings and health information are stored locally on your device. We never see them, and neither does anyone else.
          </p>
          <a href="/temp-easy/privacy" class="te-privacy-link">Read the full privacy policy &rarr;</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="te-cta">
      <div class="te-container">
        <div class="te-cta-inner">
          <h2 class="te-cta-title">Start tracking.</h2>
          <p class="te-cta-text">Free on the App Store. No account required.</p>
          <a href="https://apps.apple.com/app/id0000000000" class="te-store-badge" target="_blank" rel="noopener noreferrer">
            <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
          </a>
        </div>
      </div>
    </section>
    <ExploreApps current="temp-easy" />
  </main>

  <!-- App Footer -->
  <footer class="te-footer">
    <div class="te-footer-inner">
      <div class="te-footer-links">
        <a href="/temp-easy/support">Support</a>
        <span class="te-footer-dot">&middot;</span>
        <a href="/temp-easy/privacy">Privacy Policy</a>
      </div>
      <div class="te-footer-brand">
        An <a href="/">Idle Fusion</a> app
      </div>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════
     TEMP EASY — Warm Amber / Temperature Theme
     Clean, medical, trustworthy with a warm tone
     ═══════════════════════════════════════════════════════ */

  :global(:root) {
    --te-accent: #ea580c;
    --te-accent-deep: #c2410c;
    --te-accent-bg: #fff7ed;
    --te-secondary: #f59e0b;
    --te-bg: #f8fafc;
    --te-surface: #ffffff;
    --te-border: rgba(148, 163, 184, 0.15);
    --te-text: #0f172a;
    --te-text-muted: #64748b;
    --te-feature-icon-bg: rgba(234, 88, 12, 0.08);
    --te-feature-icon-border: rgba(234, 88, 12, 0.12);
  }

  :global(.dark) {
    --te-accent: #fb923c;
    --te-accent-deep: #ea580c;
    --te-accent-bg: #431407;
    --te-bg: #0a0f1a;
    --te-surface: #111827;
    --te-border: rgba(148, 163, 184, 0.08);
    --te-text: #f1f5f9;
    --te-text-muted: #94a3b8;
    --te-feature-icon-bg: rgba(234, 88, 12, 0.1);
    --te-feature-icon-border: rgba(234, 88, 12, 0.15);
  }

  /* ─── Nav ─── */
  .te-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--te-bg);
    border-bottom: 1px solid var(--te-border);
    backdrop-filter: blur(12px);
  }

  .te-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
  }

  @media (min-width: 640px) {
    .te-nav-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .te-nav-inner { padding: 0 3rem; }
  }

  .te-logo {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--te-accent-deep);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .te-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .te-nav-cta img {
    height: 32px;
    transition: opacity 0.2s;
  }

  .te-nav-cta:hover img {
    opacity: 0.7;
  }

  /* ─── Hero — Dark, dramatic ─── */
  .te-hero {
    background: #0a0f1a;
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .te-hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.12;
  }

  .te-hero-glow--primary {
    top: -30%;
    left: -10%;
    background: var(--te-accent);
  }

  .te-hero-glow--secondary {
    bottom: -40%;
    right: -10%;
    background: var(--te-secondary);
  }

  .te-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .te-hero-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .te-hero-inner { padding: 0 3rem; }
  }

  .te-hero-content {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .te-hero-content {
      flex-direction: row;
      text-align: left;
      gap: 4rem;
    }
  }

  .te-hero-text { flex: 1; }

  .te-hero-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--te-accent);
    margin-bottom: 1.5rem;
  }

  .te-hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: #f1f5f9;
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .te-hero-title em {
    font-style: italic;
    color: var(--te-accent);
  }

  .te-hero-subtitle {
    font-size: 1.125rem;
    color: #94a3b8;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  @media (max-width: 767px) {
    .te-hero-subtitle { margin-left: auto; margin-right: auto; }
  }

  .te-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .te-hero-actions { align-items: flex-start; }
  }

  .te-store-badge {
    display: inline-block;
  }

  .te-store-badge img {
    height: 54px;
    transition: opacity 0.2s;
  }

  .te-store-badge:hover img { opacity: 0.8; }

  .te-hero-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .te-hero-icon-wrap { flex-shrink: 0; }

  .te-hero-icon {
    width: 180px;
    height: 180px;
    border-radius: 40px;
    box-shadow: 0 20px 60px rgba(234, 88, 12, 0.2), 0 0 80px rgba(234, 88, 12, 0.08);
  }

  @media (min-width: 768px) {
    .te-hero-icon {
      width: 240px;
      height: 240px;
      border-radius: 54px;
    }
  }

  /* ─── Screenshots ─── */
  .te-screenshots {
    padding: 2rem 0 4rem;
    overflow: hidden;
  }
  .te-screenshots-inner {
    max-width: 400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .te-screenshot {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  /* ─── Containers ─── */
  .te-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .te-container-wide {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .te-container { padding: 0 2rem; }
    .te-container-wide { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .te-container { padding: 0 3rem; }
    .te-container-wide { padding: 0 3rem; }
  }

  /* ─── Features — 2-col, icon-led ─── */
  .te-features-section {
    background: var(--te-surface);
    padding: 5rem 0;
  }

  .te-features-header {
    margin-bottom: 3.5rem;
    max-width: 520px;
  }

  .te-label-dark {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--te-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .te-features-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    color: var(--te-text);
    margin-bottom: 1rem;
  }

  .te-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--te-border);
    border: 1px solid var(--te-border);
    border-radius: 16px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .te-features { grid-template-columns: 1fr 1fr; }
  }

  .te-feature {
    padding: 2rem;
    background: var(--te-surface);
  }

  .te-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--te-feature-icon-bg);
    border: 1px solid var(--te-feature-icon-border);
    border-radius: 10px;
    color: var(--te-accent-deep);
    margin-bottom: 1.25rem;
  }

  .te-feature h3 {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--te-text);
    margin-bottom: 0.625rem;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .te-feature p {
    color: var(--te-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* ─── Fever Thresholds Section ─── */
  .te-categories {
    background: var(--te-bg);
    padding: 5rem 0;
  }

  .te-categories-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .te-categories-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--te-text);
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .te-categories-subtitle {
    font-size: 1.0625rem;
    color: var(--te-text-muted);
    max-width: 480px;
    margin: 0 auto;
  }

  .te-categories-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .te-category {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    min-width: 180px;
  }

  .te-category-label {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .te-category-range {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .te-category--normal {
    background: rgba(34, 197, 94, 0.1);
    color: #16a34a;
  }

  .te-category--elevated {
    background: rgba(234, 179, 8, 0.1);
    color: #ca8a04;
  }

  .te-category--fever {
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
  }

  :global(.dark) .te-category--normal {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
  }

  :global(.dark) .te-category--elevated {
    background: rgba(234, 179, 8, 0.15);
    color: #facc15;
  }

  :global(.dark) .te-category--fever {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }

  /* ─── Privacy Banner ─── */
  .te-privacy-banner {
    background: #0a0f1a;
    padding: 5rem 0;
    border-top: 1px solid rgba(148, 163, 184, 0.08);
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }

  .te-privacy-inner {
    text-align: center;
  }

  .te-privacy-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #f1f5f9;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .te-privacy-text {
    font-size: 1.0625rem;
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .te-privacy-link {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--te-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .te-privacy-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── CTA ─── */
  .te-cta {
    padding: 6rem 0;
    background: var(--te-accent-bg);
    position: relative;
    overflow: hidden;
  }

  .te-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  .te-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--te-text);
    margin-bottom: 1rem;
  }

  .te-cta-text {
    font-size: 1.125rem;
    color: var(--te-text-muted);
    margin-bottom: 2rem;
  }

  /* ─── Footer ─── */
  .te-footer {
    background: var(--te-bg);
    border-top: 1px solid var(--te-border);
    padding: 2rem 0;
  }

  .te-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .te-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .te-footer-inner { padding: 0 3rem; }
  }

  .te-footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .te-footer-links a {
    color: var(--te-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .te-footer-links a:hover {
    color: var(--te-accent);
  }

  .te-footer-dot {
    color: var(--te-text-muted);
    opacity: 0.4;
  }

  .te-footer-brand {
    font-size: 0.8125rem;
    color: var(--te-text-muted);
    opacity: 0.6;
  }

  .te-footer-brand a {
    color: var(--te-text-muted);
