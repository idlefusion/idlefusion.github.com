---
import Layout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';
import Paint from '../../components/site/Paint.astro';
export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}
const { project: p, next } = Astro.props;
const practice = p.type === 'Web' ? 'web' : 'mobile';
---

<Layout
  title={p.name}
  active="work"
  description={p.intro}
  ogImage={`/img/og/work-${p.slug}.png`}
  cta={{
    heading: 'Planning something <span class="hand">similar?</span>',
    href: `/contact/?service=${practice}`,
    track: 'cta_case_study',
  }}
>
  <section class="wrap case-intro">
    <a class="back-link" href="/work/">← All work</a>
    <span class="label"><span class="idx">{p.number}</span> {p.category}</span>
    <h1 class="h1">{p.name}<span style="color:var(--rose)">.</span></h1>
    <p class="lede">{p.intro}</p>
    <dl class="case-meta">
      <div>
        <dt>Client</dt>
        <dd>{p.client}</dd>
      </div>
      <div>
        <dt>Platform</dt>
        <dd>{p.platform}</dd>
      </div>
      <div>
        <dt>Practice</dt>
        <dd>Design & development</dd>
      </div>
    </dl>
    <div class="project-art case-art">
      <Paint src={p.art} alt="" width="1600" height="1000" fetchpriority="high" />
      <span class="client-chip">
        <img src={p.image} alt="" width="30" height="30" />
        {p.client}
      </span>
    </div>
    {p.note && <p class="case-note">{p.note}</p>}
  </section>
  <section class="section wrap" aria-label="The project">
    <div class="case-body">
      <article>
        <span class="label"><span class="idx">01</span> The challenge</span>
        <div>
          <h2 class="h3">A problem worth solving.</h2>
          <p>{p.challenge}</p>
        </div>
      </article>
      <article>
        <span class="label"><span class="idx">02</span> Our approach</span>
        <div>
          <h2 class="h3">Built around the experience.</h2>
          <ul>
            {p.approach.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </article>
      <article>
        <span class="label"><span class="idx">03</span> The outcome</span>
        <div>
          <h2 class="h3">From idea to everyday use.</h2>
          {
            p.results && (
              <dl class="case-results">
                {p.results.map((result) => (
                  <div>
                    <dt>{result.value}</dt>
                    <dd>{result.label}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          <p>{p.outcome}</p>
        </div>
      </article>
    </div>
  </section>
  {
    p.screenshots && (
      <section class="wrap case-gallery" aria-label={`${p.name} screenshots`}>
        {p.screenshots.map((shot) => (
          <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
        ))}
      </section>
    )
  }
  <nav class="wrap" aria-label="More work">
    <a href={`/work/${next.slug}/`} class="next-project">
      <div>
        <span class="label">Next project</span>
        <span class="h3">{next.name}</span>
      </div>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </nav>
</Layout>
