---
import Layout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';

const moreClients = [
  ['NBC Sports', 'Flagship sports app'],
  ['Telemundo Deportes', 'Spanish-language sports'],
  ['GolfNow', 'GPS & tee-time booking'],
  ['Treehouse', 'Coding education apps'],
  ['Comcast RSN', 'Regional sports networks'],
  ['Pro Football Talk', 'NFL news app'],
  ['North Point Ministries', 'Mobile app'],
  ['Gitty', 'GitHub client for iOS'],
];
---

<Layout
  title="Selected work"
  active="work"
  description="Selected Idle Fusion projects: mobile apps and web platforms for Radio Disney, Golf Channel, Easy Digital Downloads, and mission-driven organizations."
>
  <section class="page-intro wrap">
    <span class="label"><span class="idx">Work</span> Selected projects</span>
    <h1 class="h1">Built for big audiences and <span class="hand ochre">bold missions.</span></h1>
    <div class="intro-row">
      <p class="lede">
        From beloved media brands to mission-driven organizations: a selection of the products we’ve
        helped bring to life, and what it took to get them there.
      </p>
      <span class="meta">{String(projects.length).padStart(2, '0')} case studies</span>
    </div>
  </section>
  <section class="wrap" aria-label="Selected projects">
    <div class="filter-bar">
      <div class="filters" aria-label="Filter projects">
        {
          ['All work', 'Mobile', 'Web'].map((label, i) => (
            <button class="filter" data-filter={i === 0 ? 'All' : label} aria-pressed={i === 0}>
              {label}
            </button>
          ))
        }
      </div>
      <span class="meta" id="project-count" aria-live="polite">{projects.length} projects</span>
    </div>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} level="h2" />)}
      {
        projects.length % 2 === 1 && (
          <a class="project-slot" href="/contact/" data-track="cta_case_study">
            <span class="label">
              <span class="idx">{String(projects.length + 1).padStart(2, '0')}</span> Open slot
            </span>
            <span class="h2">
              Next case study: <span class="hand">yours.</span>
            </span>
            <p>Tell us what you’re building. Matthew replies within one business day.</p>
            <span class="link-arrow">
              Start a project <span aria-hidden="true">→</span>
            </span>
          </a>
        )
      }
    </div>
  </section>
  <section class="section wrap" aria-labelledby="more-title">
    <header class="section-head">
      <span class="label"><span class="idx">+</span> More good company</span>
    </header>
    <div class="section-title">
      <h2 id="more-title">Experience that travels.</h2>
      <p>
        Teams we’ve built with over twenty years, across sports, media, education, and commerce.
      </p>
    </div>
    <ul class="client-list">
      {
        moreClients.map(([name, what]) => (
          <li>
            <strong>{name}</strong>
            <span>{what}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      let count = 0;
      cards.forEach((card) => {
        card.hidden =
          button.dataset.filter !== 'All' && card.dataset.category !== button.dataset.filter;
        if (!card.hidden) count++;
      });
      document.getElementById('project-count')!.textContent =
        `${count} ${count === 1 ? 'project' : 'projects'}`;
    }),
  );
</script>
