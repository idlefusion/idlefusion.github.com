---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ExploreApps from '../../components/ExploreApps.astro';
---

<BaseLayout
  title="Rest Easy — Sleep Sounds for iOS"
  description="Sleep sounds for better rest. Ambient soundscapes, custom mixing, sleep timer, and background playback. No accounts, no subscriptions."
  ogImage="/img/rest-easy/icon.png"
  ogUrl="https://idlefusion.com/rest-easy"
>

  <!-- App Nav -->
  <nav class="re-nav">
    <div class="re-nav-inner">
      <a href="/rest-easy" class="re-logo">Rest Easy</a>
      <div class="re-nav-actions">
        <ThemeToggle />
        <a href="https://apps.apple.com/app/id0000000000" class="re-nav-cta" target="_blank" rel="noopener noreferrer">
          <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="40" />
        </a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero — Dark, calming night sky -->
    <section class="re-hero">
      <div class="re-hero-glow re-hero-glow--moon"></div>
      <div class="re-hero-glow re-hero-glow--stars"></div>
      <div class="re-hero-inner">
        <div class="re-hero-content">
          <div class="re-hero-text">
            <div class="re-hero-badge">AMBIENT SOUNDSCAPES</div>
            <h1 class="re-hero-title">
              Sleep sounds for<br/><em>better rest.</em>
            </h1>
            <p class="re-hero-subtitle">
              Drift off with soothing ambient sounds. Mix your perfect soundscape, set a sleep timer, and let the sounds play all night.
            </p>
            <div class="re-hero-actions">
              <a href="https://apps.apple.com/app/id0000000000" class="re-store-badge" target="_blank" rel="noopener noreferrer">
                <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
              </a>
              <span class="re-hero-note">Free &middot; No account required</span>
            </div>
          </div>
          <div class="re-hero-icon-wrap">
            <img src="/img/rest-easy/icon.png" alt="Rest Easy app icon" class="re-hero-icon" width="240" height="240" />
          </div>
        </div>
      </div>
    </section>

    <!-- Screenshots -->
    <section class="re-screenshots">
      <div class="app-screenshots-scroll">
          <img src="/img/rest-easy/screenshots/01_marketing.png" alt="Rest Easy screenshot 1" class="app-screenshot" />
          <img src="/img/rest-easy/screenshots/02_marketing.png" alt="Rest Easy screenshot 2" class="app-screenshot" />
          <img src="/img/rest-easy/screenshots/03_marketing.png" alt="Rest Easy screenshot 3" class="app-screenshot" />
          <img src="/img/rest-easy/screenshots/04_marketing.png" alt="Rest Easy screenshot 4" class="app-screenshot" />
          <img src="/img/rest-easy/screenshots/05_marketing.png" alt="Rest Easy screenshot 5" class="app-screenshot" />
          <img src="/img/rest-easy/screenshots/06_marketing.png" alt="Rest Easy screenshot 6" class="app-screenshot" />
        </div>
    </section>

    <!-- Features -->
    <section class="re-features-section">
      <div class="re-container-wide">
        <div class="re-features-header">
          <span class="re-label-dark">FEATURES</span>
          <h2 class="re-features-title">Designed for sleep.</h2>
        </div>

        <div class="re-features">
          <div class="re-feature">
            <div class="re-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            </div>
            <h3>Ambient Sounds</h3>
            <p>Rain, ocean waves, forest, wind, thunder, and more. High-quality, seamlessly looping soundscapes designed to help you relax and sleep.</p>
          </div>

          <div class="re-feature">
            <div class="re-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h.01"/><path d="M7 20v-4"/><path d="M12 20v-8"/><path d="M17 20V8"/><path d="M22 4v16"/></svg>
            </div>
            <h3>Sound Mixing</h3>
            <p>Layer multiple sounds together and adjust individual volumes. Create your perfect combination — gentle rain with distant thunder, or ocean with soft wind.</p>
          </div>

          <div class="re-feature">
            <div class="re-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Sleep Timer</h3>
            <p>Set sounds to fade out after a duration of your choice. Fall asleep to soothing audio without draining your battery all night.</p>
          </div>

          <div class="re-feature">
            <div class="re-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
            </div>
            <h3>Background Playback</h3>
            <p>Lock your phone, switch apps, or turn off the screen. Rest Easy keeps playing in the background so you can drift off undisturbed.</p>
          </div>

          <div class="re-feature">
            <div class="re-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </div>
            <h3>Dark Interface</h3>
            <p>A calming dark theme that won't disturb your eyes at bedtime. Minimal, distraction-free design built for nighttime use.</p>
          </div>

          <div class="re-feature">
            <div class="re-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h3>Completely Offline</h3>
            <p>All sounds are included in the app. No streaming, no downloads, no internet required. Works perfectly on airplane mode.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Banner -->
    <section class="re-privacy-banner">
      <div class="re-container">
        <div class="re-privacy-inner">
          <span class="re-label-dark">PRIVACY</span>
          <h2 class="re-privacy-title">Zero data collection.</h2>
          <p class="re-privacy-text">
            No analytics. No ads. No tracking.<br/>
            Rest Easy doesn't make network requests. Your sleep habits are your business.
          </p>
          <a href="/rest-easy/privacy" class="re-privacy-link">Read the full privacy policy &rarr;</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="re-cta">
      <div class="re-container">
        <div class="re-cta-inner">
          <h2 class="re-cta-title">Sleep better tonight.</h2>
          <p class="re-cta-text">Free on the App Store. No account required.</p>
          <a href="https://apps.apple.com/app/id0000000000" class="re-store-badge" target="_blank" rel="noopener noreferrer">
            <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
          </a>
        </div>
      </div>
    </section>
    <ExploreApps current="rest-easy" />
  </main>

  <!-- Footer -->
  <footer class="re-footer">
    <div class="re-footer-inner">
      <div class="re-footer-links">
        <a href="/rest-easy/support">Support</a>
        <span class="re-footer-dot">&middot;</span>
        <a href="/rest-easy/privacy">Privacy Policy</a>
      </div>
      <div class="re-footer-brand">
        An <a href="/">Idle Fusion</a> app
      </div>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════
     REST EASY — Deep Indigo / Purple, Night Theme
     Calm, soothing, sleep-focused
     ═══════════════════════════════════════════════════════ */

  :global(:root) {
    --re-accent: #a78bfa;
    --re-accent-deep: #8b5cf6;
    --re-accent-bg: #f5f3ff;
    --re-moon: #fcd34d;
    --re-bg: #f8fafc;
    --re-surface: #ffffff;
    --re-border: rgba(148, 163, 184, 0.15);
    --re-text: #0f172a;
    --re-text-muted: #64748b;
    --re-feature-icon-bg: rgba(139, 92, 246, 0.08);
    --re-feature-icon-border: rgba(139, 92, 246, 0.12);
  }

  :global(.dark) {
    --re-accent: #c4b5fd;
    --re-accent-deep: #a78bfa;
    --re-accent-bg: #1e1b4b;
    --re-bg: #0a0a1a;
    --re-surface: #111827;
    --re-border: rgba(148, 163, 184, 0.08);
    --re-text: #f1f5f9;
    --re-text-muted: #94a3b8;
    --re-feature-icon-bg: rgba(139, 92, 246, 0.1);
    --re-feature-icon-border: rgba(139, 92, 246, 0.15);
  }

  /* ─── Nav ─── */
  .re-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--re-bg);
    border-bottom: 1px solid var(--re-border);
    backdrop-filter: blur(12px);
  }

  .re-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
  }

  @media (min-width: 640px) {
    .re-nav-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .re-nav-inner { padding: 0 3rem; }
  }

  .re-logo {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--re-accent-deep);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .re-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .re-nav-cta img {
    height: 32px;
    transition: opacity 0.2s;
  }

  .re-nav-cta:hover img {
    opacity: 0.7;
  }

  /* ─── Hero — Dark night sky theme ─── */
  .re-hero {
    background: #0a0a1a;
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .re-hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.12;
  }

  .re-hero-glow--moon {
    top: -30%;
    left: -10%;
    background: var(--re-moon);
  }

  .re-hero-glow--stars {
    bottom: -40%;
    right: -10%;
    background: var(--re-accent);
  }

  .re-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .re-hero-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .re-hero-inner { padding: 0 3rem; }
  }

  .re-hero-content {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .re-hero-content {
      flex-direction: row;
      text-align: left;
      gap: 4rem;
    }
  }

  .re-hero-text { flex: 1; }

  .re-hero-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--re-accent);
    margin-bottom: 1.5rem;
  }

  .re-hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: #f1f5f9;
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .re-hero-title em {
    font-style: italic;
    color: var(--re-accent);
  }

  .re-hero-subtitle {
    font-size: 1.125rem;
    color: #94a3b8;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  @media (max-width: 767px) {
    .re-hero-subtitle { margin-left: auto; margin-right: auto; }
  }

  .re-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .re-hero-actions { align-items: flex-start; }
  }

  .re-store-badge {
    display: inline-block;
  }

  .re-store-badge img {
    height: 54px;
    transition: opacity 0.2s;
  }

  .re-store-badge:hover img { opacity: 0.8; }

  .re-hero-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .re-hero-icon-wrap { flex-shrink: 0; }

  .re-hero-icon {
    width: 180px;
    height: 180px;
    border-radius: 40px;
    box-shadow: 0 20px 60px rgba(139, 92, 246, 0.2), 0 0 80px rgba(139, 92, 246, 0.08);
  }

  @media (min-width: 768px) {
    .re-hero-icon {
      width: 240px;
      height: 240px;
      border-radius: 54px;
    }
  }

  /* ─── Screenshots ─── */
  .re-screenshots {
    padding: 2rem 0 4rem;
    overflow: hidden;
  }
  .re-screenshots-inner {
    max-width: 400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .re-screenshot {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  /* ─── Containers ─── */
  .re-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .re-container-wide {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .re-container { padding: 0 2rem; }
    .re-container-wide { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .re-container { padding: 0 3rem; }
    .re-container-wide { padding: 0 3rem; }
  }

  /* ─── Features ─── */
  .re-features-section {
    background: var(--re-surface);
    padding: 5rem 0;
  }

  .re-features-header {
    margin-bottom: 3.5rem;
    max-width: 520px;
  }

  .re-label-dark {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--re-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .re-features-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    color: var(--re-text);
    margin-bottom: 1rem;
  }

  .re-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--re-border);
    border: 1px solid var(--re-border);
    border-radius: 16px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .re-features { grid-template-columns: 1fr 1fr; }
  }

  .re-feature {
    padding: 2rem;
    background: var(--re-surface);
  }

  .re-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--re-feature-icon-bg);
    border: 1px solid var(--re-feature-icon-border);
    border-radius: 10px;
    color: var(--re-accent-deep);
    margin-bottom: 1.25rem;
  }

  .re-feature h3 {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--re-text);
    margin-bottom: 0.625rem;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .re-feature p {
    color: var(--re-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* ─── Privacy Banner ─── */
  .re-privacy-banner {
    background: #0a0a1a;
    padding: 5rem 0;
    border-top: 1px solid rgba(148, 163, 184, 0.08);
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }

  .re-privacy-inner {
    text-align: center;
  }

  .re-privacy-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #f1f5f9;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .re-privacy-text {
    font-size: 1.0625rem;
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .re-privacy-link {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--re-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .re-privacy-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── CTA ─── */
  .re-cta {
    padding: 6rem 0;
    background: var(--re-accent-bg);
    position: relative;
    overflow: hidden;
  }

  .re-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  .re-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--re-text);
    margin-bottom: 1rem;
  }

  .re-cta-text {
    font-size: 1.125rem;
    color: var(--re-text-muted);
    margin-bottom: 2rem;
  }

  /* ─── Footer ─── */
  .re-footer {
    background: var(--re-bg);
    border-top: 1px solid var(--re-border);
    padding: 2rem 0;
  }

  .re-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .re-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .re-footer-inner { padding: 0 3rem; }
  }

  .re-footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .re-footer-links a {
    color: var(--re-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .re-footer-links a:hover {
    color: var(--re-accent);
  }

  .re-footer-dot {
    color: var(--re-text-muted);
    opacity: 0.4;
  }

  .re-footer-brand {
    font-size: 0.8125rem;
    color: var(--re-text-muted);
    opacity: 0.6;
  }

  .re-footer-brand a {
    color: var(--re-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .re-footer-brand a:hover {
    color: var(--re-accent);
  }
</style>
