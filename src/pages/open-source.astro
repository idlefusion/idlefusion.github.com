---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Open Source — Idle Fusion"
  description="Open source projects from Idle Fusion. Tools and libraries we've built and shared with the community."
  ogUrl="https://idlefusion.com/open-source"
>
  <Header currentPage="open-source" />

  <main>
    <!-- Hero -->
    <section class="oss-hero">
      <div class="oss-container">
        <div class="oss-hero-badge">Community</div>
        <h1 class="oss-hero-title">Open Source</h1>
        <p class="oss-hero-subtitle">
          Tools and libraries we've built and shared with the developer community.
        </p>
      </div>
    </section>

    <!-- Projects -->
    <section class="oss-projects">
      <div class="oss-container">
        <div class="oss-project-card">
          <div class="oss-project-header">
            <div class="oss-project-icon">🏃</div>
            <div class="oss-project-meta">
              <span class="oss-project-lang">Swift</span>
              <span class="oss-project-platform">iOS 17+ · macOS 14+</span>
            </div>
          </div>

          <h2 class="oss-project-name">
            <a href="https://github.com/mps/healthkit-run-generator" target="_blank" rel="noopener noreferrer">
              HealthKit Run Generator
              <svg class="oss-external-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7M17 7H7M17 7V17"/>
              </svg>
            </a>
          </h2>

          <p class="oss-project-desc">
            A Swift Package for generating realistic HealthKit running workout data — outdoor runs with GPS routes and indoor treadmill runs with accurate physiological metrics. Built for developers who need real-looking test data without going for a run.
          </p>

          <div class="oss-project-features">
            <div class="oss-feature">
              <span class="oss-feature-icon">🗺️</span>
              <div>
                <strong>Outdoor & Indoor Runs</strong>
                <span>GPS routes with elevation, treadmill simulation with incline profiles</span>
              </div>
            </div>
            <div class="oss-feature">
              <span class="oss-feature-icon">❤️</span>
              <div>
                <strong>Physiological Accuracy</strong>
                <span>Heart rate curves, cadence, pace splits — all following real exercise physiology</span>
              </div>
            </div>
            <div class="oss-feature">
              <span class="oss-feature-icon">📊</span>
              <div>
                <strong>5 Run Profiles</strong>
                <span>Easy, tempo, interval, long run, and race — each with calibrated metrics</span>
              </div>
            </div>
            <div class="oss-feature">
              <span class="oss-feature-icon">🔁</span>
              <div>
                <strong>Deterministic Seeds</strong>
                <span>Reproducible output for snapshot testing and CI pipelines</span>
              </div>
            </div>
            <div class="oss-feature">
              <span class="oss-feature-icon">📅</span>
              <div>
                <strong>Training Plans</strong>
                <span>4-week periodized cycles with progressive overload and recovery weeks</span>
              </div>
            </div>
            <div class="oss-feature">
              <span class="oss-feature-icon">📦</span>
              <div>
                <strong>Batch Generation</strong>
                <span>Generate hundreds of runs with seed ranges and JSON export</span>
              </div>
            </div>
          </div>

          <div class="oss-project-actions">
            <a href="https://github.com/mps/healthkit-run-generator" class="oss-btn oss-btn-primary" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              View on GitHub
            </a>
            <a href="/healthkit-run-generator" class="oss-btn oss-btn-secondary">
              Project Page →
            </a>
          </div>

          <div class="oss-project-install">
            <code><span class="oss-code-comment">// Package.swift</span>
.package(url: "https://github.com/mps/healthkit-run-generator", from: "0.1.0")</code>
          </div>
        </div>

        <!-- More Coming Soon -->
        <div class="oss-coming-soon">
          <div class="oss-coming-soon-inner">
            <span class="oss-coming-soon-icon">🚀</span>
            <h3>More coming soon</h3>
            <p>We're working on open-sourcing more of our tools and libraries. Follow us on <a href="https://github.com/idlefusion" target="_blank" rel="noopener noreferrer">GitHub</a> to stay updated.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .oss-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---- Hero ---- */
  .oss-hero {
    padding: 140px 0 60px;
    text-align: center;
  }

  .oss-hero-badge {
    display: inline-block;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .oss-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .oss-hero-subtitle {
    font-size: clamp(16px, 2vw, 18px);
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ---- Projects ---- */
  .oss-projects {
    padding: 0 0 100px;
  }

  .oss-project-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 36px;
    margin-bottom: 32px;
  }

  .oss-project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .oss-project-icon {
    font-size: 32px;
  }

  .oss-project-meta {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .oss-project-lang {
    font-size: 12px;
    font-weight: 600;
    color: #f97316;
    background: rgba(249, 115, 22, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.02em;
  }

  .oss-project-platform {
    font-size: 13px;
    color: var(--text-muted);
  }

  .oss-project-name {
    font-family: var(--font-heading);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 600;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .oss-project-name a {
    color: var(--text-primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .oss-project-name a:hover {
    color: var(--accent);
  }

  .oss-external-icon {
    opacity: 0.4;
    transition: opacity 0.2s, transform 0.2s;
  }

  .oss-project-name a:hover .oss-external-icon {
    opacity: 0.8;
    transform: translate(2px, -2px);
  }

  .oss-project-desc {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  /* ---- Features ---- */
  .oss-project-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  .oss-feature {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    background: var(--bg-secondary);
    border-radius: 10px;
    border: 1px solid var(--border-color);
  }

  .oss-feature-icon {
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .oss-feature strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .oss-feature span {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ---- Actions ---- */
  .oss-project-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .oss-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    white-space: nowrap;
  }

  .oss-btn-primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  :global(.dark) .oss-btn-primary {
    background: var(--paper);
    color: var(--ink);
  }

  .oss-btn-primary:hover {
    opacity: 0.85;
  }

  .oss-btn-secondary {
    background: transparent;
    border-color: var(--border-color);
    color: var(--text-primary);
  }

  .oss-btn-secondary:hover {
    border-color: var(--border-hover);
    background: var(--bg-secondary);
  }

  /* ---- Install ---- */
  .oss-project-install {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 16px 20px;
    overflow-x: auto;
  }

  .oss-project-install code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    white-space: pre;
  }

  .oss-code-comment {
    opacity: 0.5;
  }

  /* ---- Coming Soon ---- */
  .oss-coming-soon {
    text-align: center;
  }

  .oss-coming-soon-inner {
    padding: 48px 24px;
    border: 1px dashed var(--border-color);
    border-radius: 16px;
  }

  .oss-coming-soon-icon {
    font-size: 28px;
    display: block;
    margin-bottom: 12px;
  }

  .oss-coming-soon h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .oss-coming-soon p {
    font-size: 15px;
    color: var(--text-muted);
    max-width: 400px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .oss-coming-soon a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .oss-coming-soon a:hover {
    color: var(--accent);
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .oss-hero {
      padding: 120px 0 40px;
    }

    .oss-project-card {
      padding: 24px;
    }

    .oss-project-features {
      grid-template-columns: 1fr;
    }

    .oss-project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
