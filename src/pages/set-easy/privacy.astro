---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Set Easy - Privacy Policy"
  description="Privacy policy for Set Easy"
  ogUrl="https://idlefusion.com/set-easy/privacy"
>
  <main>
    <section class="section-padding">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-2">Privacy Policy</h1>
        <p class="text-sm text-[var(--text-secondary)] mb-12">Set Easy - Gym & Strength Tracking &middot; Effective February 23, 2026</p>
        <div class="space-y-8 text-[var(--text-secondary)] leading-relaxed">
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Short version</h2>
            <p>Set Easy keeps your strength training history on-device and does not rely on analytics or ad tracking.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Workout data</h2>
            <p>Sets, reps, exercise names, and routines are stored only in your app data. There is no public sharing unless you create and send a card manually.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Health integration</h2>
            <p>Health permissions are optional and can be revoked any time in iOS settings. We do not read your Health data for any hidden use.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Contact</h2>
            <p>For privacy questions, email <a href="mailto:support@idlefusion.com?subject=Set%20Easy%20Privacy" class="text-[var(--accent-primary)] hover:underline">support@idlefusion.com</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
