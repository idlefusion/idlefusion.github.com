---
const site = Astro.site ?? new URL('https://idlefusion.com');
const canonicalUrl = new URL('/', site).href;
const socialImage = new URL('/img/logo.png', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Idle Fusion. Thoughtful apps and websites. Say hello, or come on in."
    />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Idle Fusion — Thoughtful apps & websites" />
    <meta
      property="og:description"
      content="Independent digital studio. Say hello, or come on in."
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Idle Fusion — Thoughtful apps & websites" />
    <meta
      name="twitter:description"
      content="Independent digital studio. Say hello, or come on in."
    />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        // Apply the shared preference before painting the welcome screen.
        let saved;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const dark =
          saved === 'dark' ||
          (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', dark);
        document.querySelector('meta[name="theme-color"]').content = dark ? '#101114' : '#ffffff';
        // Keep bookmarks to sections of the previous homepage useful.
        const followSectionLink = () => {
          if (['#our-work', '#how-it-works', '#leadership'].includes(location.hash)) {
            location.replace(`/explore/${location.hash}`);
          }
        };
        window.addEventListener('hashchange', followSectionLink);
        followSectionLink();
      })();
    </script>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;450;500;550;600&display=swap"
      rel="stylesheet"
    />
    <title>A simple hello — Idle Fusion</title>
  </head>
  <body>
    <button
      id="appearance-toggle"
      type="button"
      aria-label="Switch to dark mode"
      title="Switch to dark mode"
      hidden
    >
      <svg
        class="moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
        ><path d="M20.5 13.2A8.5 8.5 0 0 1 10.8 3.5a8.5 8.5 0 1 0 9.7 9.7Z"></path></svg
      >
      <svg
        class="sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path></svg
      >
    </button>
    <main id="home">
      <div class="introduction">
        <span class="fusion-mark" aria-hidden="true"></span>
        <p class="eyebrow">Independent by design.</p>
        <h1>idle fusion<span>.</span></h1>
        <p class="description">Thoughtful apps & websites.<br />Good people to build with.</p>

        <div class="contact">
          <p>Matthew Strickland <span aria-hidden="true">/</span> Founder & builder</p>
          <a class="email" href="mailto:hello@idlefusion.com"
            >hello@idlefusion.com <span aria-hidden="true">↗</span></a
          >
        </div>

        <div class="invitation">
          <p>There’s more to the story.</p>
          <a
            class="enter"
            href="/explore/"
            aria-label="Come on in — explore the full Idle Fusion website"
          >
            Come on in <span class="enter-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Idle Fusion</span>
      <nav aria-label="Find us elsewhere">
        <a href="https://github.com/idlefusion">GitHub ↗</a>
        <a href="https://linkedin.com/in/mps">LinkedIn ↗</a>
      </nav>
    </footer>
  </body>
</html>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('appearance-toggle') as HTMLButtonElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  let preference: string | null = null;
  try {
    preference = localStorage.getItem('theme');
  } catch {}
  const renderTheme = () => {
    const dark = preference === 'dark' || (preference !== 'light' && system.matches);
    root.dataset.theme = dark ? 'dark' : 'light';
    root.classList.toggle('dark', dark);
    const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
    toggle.setAttribute('aria-label', label);
    toggle.title = label;
    (document.querySelector('meta[name="theme-color"]') as HTMLMetaElement).content = dark
      ? '#101114'
      : '#ffffff';
  };
  toggle.addEventListener('click', () => {
    preference = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', preference);
    } catch {}
    renderTheme();
  });
  system.addEventListener('change', renderTheme);
  window.addEventListener('storage', (event) => {
    if (event.key === 'theme' || event.key === null) {
      preference = event.newValue;
      renderTheme();
    }
  });
  renderTheme();
  toggle.hidden = false;
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    --welcome-bg: #ffffff;
    --welcome-text: #111111;
    --welcome-muted: #686868;
    --welcome-line: #d8d8d8;
    --welcome-blue: #0088cc;
    --welcome-link: #006da3;
    --welcome-tint: #e8f5fc;
    color-scheme: light;
    background: var(--welcome-bg);
  }
  :global(html[data-theme='dark']) {
    --welcome-bg: #101114;
    --welcome-text: #f4f5f6;
    --welcome-muted: #a0a5ae;
    --welcome-line: #353941;
    --welcome-blue: #2aabee;
    --welcome-link: #6bc8fa;
    --welcome-tint: #172b39;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) {
      --welcome-bg: #101114;
      --welcome-text: #f4f5f6;
      --welcome-muted: #a0a5ae;
      --welcome-line: #353941;
      --welcome-blue: #2aabee;
      --welcome-link: #6bc8fa;
      --welcome-tint: #172b39;
      color-scheme: dark;
    }
  }
  :global(body) {
    margin: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    color: var(--welcome-text);
    background: var(--welcome-bg);
    font-family: 'Work Sans', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(::selection) {
    background: var(--welcome-tint);
  }
  #appearance-toggle {
    position: absolute;
    top: 24px;
    right: 32px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--welcome-muted);
    background: transparent;
    border: 1px solid var(--welcome-line);
    border-radius: 50%;
    cursor: pointer;
  }
  #appearance-toggle[hidden] {
    display: none;
  }
  #appearance-toggle:hover {
    color: var(--welcome-link);
    border-color: var(--welcome-blue);
  }
  #appearance-toggle svg {
    width: 18px;
    height: 18px;
  }
  .sun {
    display: none;
  }
  :global(.dark) .sun {
    display: block;
  }
  :global(.dark) .moon {
    display: none;
  }
  main {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 72px 24px 64px;
  }
  .introduction {
    width: 100%;
    text-align: center;
  }
  .fusion-mark {
    display: block;
    position: relative;
    width: 43px;
    height: 39px;
    margin: 0 auto 36px;
  }
  .fusion-mark::before,
  .fusion-mark::after {
    content: '';
    position: absolute;
    top: 0;
    width: 28px;
    height: 39px;
    border: 1.5px solid var(--welcome-blue);
    border-radius: 50%;
    transform: rotate(32deg);
  }
  .fusion-mark::before {
    left: 0;
  }
  .fusion-mark::after {
    right: 0;
  }
  p {
    margin: 0;
  }
  .eyebrow {
    color: var(--welcome-muted);
    font-size: 10px;
    font-weight: 450;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    margin: 21px 0 22px;
    font-size: clamp(58px, 8vw, 96px);
    line-height: 1.05;
    font-weight: 550;
    letter-spacing: -0.075em;
  }
  h1 span {
    color: var(--welcome-blue);
  }
  .description {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: -0.025em;
    color: var(--welcome-muted);
  }
  .contact {
    margin-top: 42px;
  }
  .contact p {
    font-size: 11px;
    color: var(--welcome-muted);
    line-height: 1.8;
  }
  .contact p span {
    padding: 0 8px;
    color: var(--welcome-line);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--welcome-blue);
    outline-offset: 7px;
    border-radius: 2px;
  }
  .email {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    padding: 10px 0 5px;
    border-bottom: 1px solid var(--welcome-line);
  }
  .email span {
    color: var(--welcome-blue);
  }
  .email:hover {
    color: var(--welcome-link);
    border-color: var(--welcome-blue);
  }
  .invitation {
    margin-top: 48px;
  }
  .invitation::before {
    content: '';
    display: block;
    height: 1px;
    width: 32px;
    background: var(--welcome-line);
    margin: 0 auto 26px;
  }
  .invitation p {
    font-size: 11px;
    color: var(--welcome-muted);
  }
  .enter {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 14px;
    padding: 5px;
    font-size: 14px;
    font-weight: 500;
  }
  .enter-arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--welcome-tint);
    color: var(--welcome-link);
    font-size: 18px;
    transition:
      background 160ms,
      color 160ms;
  }
  .enter:hover .enter-arrow {
    background: var(--welcome-blue);
    color: var(--welcome-bg);
  }
  footer {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px 40px;
    color: var(--welcome-muted);
    font-size: 10px;
  }
  footer nav {
    display: flex;
    gap: 24px;
  }
  footer a {
    padding-block: 8px;
  }
  footer a:hover {
    color: var(--welcome-link);
  }
  @media (max-width: 520px) {
    #appearance-toggle {
      top: 16px;
      right: 20px;
    }
    main {
      padding: 80px 22px 38px;
    }
    .fusion-mark {
      margin-bottom: 30px;
    }
    h1 {
      font-size: clamp(54px, 15vw, 72px);
      margin-top: 20px;
    }
    .description {
      font-size: 16px;
    }
    .contact {
      margin-top: 34px;
    }
    .contact p {
      font-size: 10px;
    }
    .contact p span {
      padding-inline: 5px;
    }
    .invitation {
      margin-top: 38px;
    }
    footer {
      padding: 20px 22px;
      font-size: 9px;
    }
    footer nav {
      gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enter-arrow {
      transition: none;
    }
  }
</style>
