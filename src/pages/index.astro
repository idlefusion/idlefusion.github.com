---
import Analytics from '../components/Analytics.astro';
import Fonts from '../components/Fonts.astro';
import FusionMark from '../components/site/FusionMark.astro';
import { defaultSocialImage, organizationSchema } from '../data/site';
const site = Astro.site ?? new URL('https://idlefusion.com');
const canonicalUrl = new URL('/', site).href;
const socialImage = new URL(defaultSocialImage, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Idle Fusion is an independent studio building thoughtful iOS apps and websites, trusted by Disney, NBC Sports, and Golf Channel. Say hello, or come on in."
    />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta
      property="og:title"
      content="Idle Fusion — Apps & websites, from first sketch to shipped"
    />
    <meta
      property="og:description"
      content="Independent app & web studio. Say hello, or come on in."
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Idle Fusion — Apps & websites, from first sketch to shipped"
    />
    <meta
      name="twitter:description"
      content="Independent app & web studio. Say hello, or come on in."
    />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#f5f0e6" />
    <script is:inline>
      (() => {
        // Apply the shared preference before painting the welcome screen.
        let saved;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const dark =
          saved === 'dark' ||
          (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', dark);
        document.querySelector('meta[name="theme-color"]').content = dark ? '#121110' : '#f5f0e6';
        // Keep bookmarks to sections of the previous homepage useful.
        const followSectionLink = () => {
          if (['#our-work', '#how-it-works', '#leadership'].includes(location.hash)) {
            location.replace(`/explore/${location.hash}`);
          }
        };
        window.addEventListener('hashchange', followSectionLink);
        followSectionLink();
      })();
    </script>
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <Fonts />
    <title>Idle Fusion — Independent app & web studio</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <header class="top">
      <span class="small-mark"><FusionMark class="mark-svg" /></span>
      <button
        id="appearance-toggle"
        type="button"
        aria-label="Switch to dark mode"
        title="Switch to dark mode"
        hidden
      >
        <svg
          class="moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><path d="M20.5 13.2A8.5 8.5 0 0 1 10.8 3.5a8.5 8.5 0 1 0 9.7 9.7Z"></path></svg
        >
        <svg
          class="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
      </button>
    </header>
    <main id="home">
      <div class="introduction">
        <p class="eyebrow"><span class="dot-live"></span> Independent by design</p>
        <h1>idle fusion<span>.</span></h1>
        <p class="description">
          Thoughtful apps & websites,<br />from first sketch to <em>shipped.</em>
        </p>
        <p class="clients">Trusted by Disney, NBC Sports, Golf Channel & Treehouse</p>

        <div class="contact">
          <p class="who">Matthew Strickland <span aria-hidden="true">/</span> Founder & builder</p>
          <div class="contact-links">
            <a class="start" href="/contact/" data-track="cta_welcome_contact"
              ><span class="start-text">Start a project</span><span
                class="start-arrow"
                aria-hidden="true">→</span
              ></a
            >
            <a class="email" href="mailto:hello@idlefusion.com">hello@idlefusion.com</a>
          </div>
        </div>

        <div class="invitation">
          <p>There’s more to the story.</p>
          <a
            class="enter"
            href="/explore/"
            aria-label="Come on in — explore the full Idle Fusion website"
            data-track="enter_site"
          >
            Come on in <span class="enter-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <figure class="art" aria-hidden="true">
        <img
          class="paint"
          src="/img/paint/fusion-mark.webp"
          alt=""
          width="1240"
          height="1000"
          fetchpriority="high"
        />
        <svg class="construction" viewBox="80 200 1240 1000">
          <ellipse
            class="geo draw"
            cx="450"
            cy="690"
            rx="285"
            ry="380"
            transform="rotate(32 450 690)"></ellipse>
          <ellipse
            class="geo draw"
            cx="750"
            cy="690"
            rx="285"
            ry="380"
            transform="rotate(32 750 690)"></ellipse>
          <path class="geo" d="M434 690h32M450 674v32M734 690h32M750 674v32"></path>
        </svg>
      </figure>
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Idle Fusion</span>
      <nav aria-label="Find us elsewhere">
        <a href="https://github.com/idlefusion">GitHub</a>
        <a href="https://linkedin.com/in/mps">LinkedIn</a>
      </nav>
    </footer>
    <Analytics />
  </body>
</html>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('appearance-toggle') as HTMLButtonElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  let preference: string | null = null;
  try {
    preference = localStorage.getItem('theme');
  } catch {}
  const renderTheme = () => {
    const dark = preference === 'dark' || (preference !== 'light' && system.matches);
    root.dataset.theme = dark ? 'dark' : 'light';
    root.classList.toggle('dark', dark);
    const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
    toggle.setAttribute('aria-label', label);
    toggle.title = label;
    (document.querySelector('meta[name="theme-color"]') as HTMLMetaElement).content = dark
      ? '#121110'
      : '#f5f0e6';
  };
  toggle.addEventListener('click', () => {
    preference = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', preference);
    } catch {}
    renderTheme();
  });
  system.addEventListener('change', renderTheme);
  window.addEventListener('storage', (event) => {
    if (event.key === 'theme' || event.key === null) {
      preference = event.newValue;
      renderTheme();
    }
  });
  renderTheme();
  toggle.hidden = false;
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    --bg: #f5f0e6;
    --text: #171512;
    --muted: #5a544c;
    --line: rgba(23, 21, 18, 0.16);
    --rose: #d23f68;
    --rose-text: #b02d55;
    --btn-bg: #171512;
    --btn-text: #f5f0e6;
    --paper-tex: url('/img/paint/paper.webp');
    color-scheme: light;
    background: var(--bg);
  }
  :global(html[data-theme='dark']) {
    --bg: #121110;
    --text: #f2ede4;
    --muted: #aaa298;
    --line: rgba(242, 237, 228, 0.18);
    --rose: #e5678b;
    --rose-text: #ef8aa7;
    --btn-bg: #f2ede4;
    --btn-text: #121110;
    --paper-tex: none;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) {
      --bg: #121110;
      --text: #f2ede4;
      --muted: #aaa298;
      --line: rgba(242, 237, 228, 0.18);
      --rose: #e5678b;
      --rose-text: #ef8aa7;
      --btn-bg: #f2ede4;
      --btn-text: #121110;
      --paper-tex: none;
      color-scheme: dark;
    }
  }
  :global(body) {
    margin: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    color: var(--text);
    background: var(--bg) var(--paper-tex) repeat;
    background-size: 320px 320px;
    font-family: 'Work Sans', ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(::selection) {
    background: rgba(210, 63, 104, 0.25);
  }
  :global(:focus-visible) {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px clamp(20px, 4vw, 56px) 0;
  }
  .small-mark :global(.mark-svg) {
    width: 34px;
    height: 31px;
  }
  .small-mark :global(ellipse) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  #appearance-toggle {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  #appearance-toggle[hidden] {
    display: none;
  }
  #appearance-toggle:hover {
    border-color: var(--text);
  }
  #appearance-toggle svg {
    width: 18px;
    height: 18px;
  }
  .sun {
    display: none;
  }
  :global(.dark) .sun {
    display: block;
  }
  :global(.dark) .moon {
    display: none;
  }
  main {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    width: min(100% - 2 * clamp(20px, 4vw, 56px), 1320px);
    margin: 0 auto;
    padding: 32px 0 48px;
  }
  .introduction {
    display: grid;
    justify-items: start;
  }
  p {
    margin: 0;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dot-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rose);
  }
  h1 {
    margin: 18px 0 20px;
    font-size: clamp(56px, 9vw, 136px);
    line-height: 0.92;
    font-weight: 600;
    letter-spacing: -0.07em;
  }
  h1 span {
    color: var(--rose);
  }
  .description {
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .description em {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    padding: 0 0.08em;
    background: url('/img/paint/swatch-rose.webp') no-repeat 0 92% / 100% 0.6em;
  }
  .clients {
    margin-top: 16px;
    font-size: 14px;
    color: var(--muted);
  }
  .contact {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    width: 100%;
    max-width: 520px;
  }
  .who {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .who span {
    margin: 0 6px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }
  .start {
    display: inline-flex;
    align-items: stretch;
    min-height: 52px;
    background: var(--btn-bg);
    color: var(--btn-text);
    border-radius: 3px;
    overflow: hidden;
    text-decoration: none;
    font-size: 15px;
    font-weight: 550;
  }
  .start-text {
    display: flex;
    align-items: center;
    padding: 0 20px 0 22px;
  }
  .start-arrow {
    display: grid;
    place-items: center;
    width: 50px;
    background: #d23f68;
    color: #fff;
    transition: width 0.3s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .start:hover .start-arrow {
    width: 62px;
  }
  .email {
    color: var(--text);
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .email:hover {
    color: var(--rose-text);
  }
  .invitation {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    font-size: 15px;
    color: var(--muted);
  }
  .enter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 17px;
    font-weight: 550;
    text-decoration: none;
  }
  .enter-arrow {
    color: var(--rose);
    font-size: 20px;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .enter:hover .enter-arrow {
    transform: translateX(6px);
  }
  .art {
    position: relative;
    margin: 0;
    aspect-ratio: 1240 / 1000;
  }
  .art .paint,
  .art .construction {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .paint {
    mix-blend-mode: multiply;
  }
  :global(html[data-theme='dark']) .paint {
    filter: invert(1) hue-rotate(180deg) saturate(1.2);
    mix-blend-mode: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .paint {
      filter: invert(1) hue-rotate(180deg) saturate(1.2);
      mix-blend-mode: screen;
    }
  }
  .construction {
    color: var(--text);
    overflow: visible;
  }
  .geo {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    opacity: 0.45;
    vector-effect: non-scaling-stroke;
  }
  .draw {
    stroke-dasharray: 2400;
    stroke-dashoffset: 2400;
    animation: draw 2.6s 0.2s cubic-bezier(0.2, 0.7, 0.1, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 18px clamp(20px, 4vw, 56px) 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  footer nav {
    display: flex;
    gap: 20px;
  }
  footer a {
    color: inherit;
    text-decoration: none;
  }
  footer a:hover {
    color: var(--text);
  }
  @media (max-width: 860px) {
    main {
      grid-template-columns: 1fr;
      padding-top: 8px;
    }
    .art {
      order: -1;
      width: min(100%, 440px);
      justify-self: center;
      margin-bottom: -12px;
    }
  }
  @media (max-width: 380px) {
    .contact-links {
      gap: 14px;
    }
    .start {
      width: 100%;
    }
    .start-text {
      flex: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .draw {
      animation: none;
      stroke-dashoffset: 0;
    }
    .start-arrow,
    .enter-arrow {
      transition: none;
    }
  }
</style>
