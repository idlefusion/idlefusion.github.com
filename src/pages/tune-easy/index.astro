---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ExploreApps from '../../components/ExploreApps.astro';
---

<BaseLayout
  title="Tune Easy — Simple Guitar Tuner for iOS"
  description="Tune your guitar, simply. Real-time pitch detection, reference tones, and haptic feedback. No accounts, no subscriptions."
  ogImage="/img/tune-easy/icon.png"
  ogUrl="https://idlefusion.com/tune-easy"
>

  <!-- App Nav -->
  <nav class="te-nav">
    <div class="te-nav-inner">
      <a href="/tune-easy" class="te-logo">Tune Easy</a>
      <div class="te-nav-actions">
        <ThemeToggle />
        <a href="https://apps.apple.com/app/id0000000000" class="te-nav-cta" target="_blank" rel="noopener noreferrer">
          <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="40" />
        </a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section class="te-hero">
      <div class="te-hero-glow te-hero-glow--warm"></div>
      <div class="te-hero-glow te-hero-glow--cool"></div>
      <div class="te-hero-inner">
        <div class="te-hero-content">
          <div class="te-hero-text">
            <div class="te-hero-badge">STANDARD TUNING</div>
            <h1 class="te-hero-title">
              Tune your guitar,<br/><em>simply.</em>
            </h1>
            <p class="te-hero-subtitle">
              A purpose-built tuner for guitarists. Real-time pitch detection, reference tones, haptic feedback. No fuss, just tune.
            </p>
            <div class="te-hero-actions">
              <a href="https://apps.apple.com/app/id0000000000" class="te-store-badge" target="_blank" rel="noopener noreferrer">
                <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
              </a>
              <span class="te-hero-note">Free &middot; No account required</span>
            </div>
          </div>
          <div class="te-hero-icon-wrap">
            <img src="/img/tune-easy/icon.png" alt="Tune Easy app icon" class="te-hero-icon" width="240" height="240" />
          </div>
        </div>
      </div>
    </section>

    <!-- Screenshots -->
    <section class="te-screenshots">
      <div class="app-screenshots-scroll">
          <img src="/img/tune-easy/screenshots/01_marketing.png" alt="Tune Easy screenshot 1" class="app-screenshot" />
          <img src="/img/tune-easy/screenshots/02_marketing.png" alt="Tune Easy screenshot 2" class="app-screenshot" />
          <img src="/img/tune-easy/screenshots/03_marketing.png" alt="Tune Easy screenshot 3" class="app-screenshot" />
          <img src="/img/tune-easy/screenshots/04_marketing.png" alt="Tune Easy screenshot 4" class="app-screenshot" />
        </div>
    </section>

    <!-- Features -->
    <section class="te-features-section">
      <div class="te-container-wide">
        <div class="te-features-header">
          <span class="te-label-dark">FEATURES</span>
          <h2 class="te-features-title">Built for guitarists.</h2>
        </div>

        <div class="te-features">
          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            </div>
            <h3>Standard Tuning</h3>
            <p>E A D G B E. That's it. No confusing menus, no alternate tunings to accidentally select. Just the tuning 99% of guitarists use 99% of the time.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l3-9 6 18 3-9h4"/></svg>
            </div>
            <h3>Real-Time Pitch Detection</h3>
            <p>Advanced autocorrelation works great with guitar's rich harmonics. See exactly how many cents flat or sharp you are, instantly.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
            </div>
            <h3>Reference Tones</h3>
            <p>Not sure what the string should sound like? Tap any string button to hear the target pitch. Learn to tune by ear.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 12.5 2 16l3.5 3.5"/><path d="M18.5 12.5 22 16l-3.5 3.5"/><path d="m2 16 20 0"/><circle cx="12" cy="6" r="4"/></svg>
            </div>
            <h3>Haptic Feedback</h3>
            <p>Feel when you nail it. A satisfying tap tells you the string is in tune — no need to stare at the screen while you adjust.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3>Clear Visual Feedback</h3>
            <p>Big, bold note display with a visual gauge showing flat, sharp, or in tune. Green glow when you hit it. Works great in any light.</p>
          </div>

          <div class="te-feature">
            <div class="te-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h3>Completely Offline</h3>
            <p>No servers, no cloud sync, no network requests. Your microphone is used only for tuning. Period.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Banner -->
    <section class="te-privacy-banner">
      <div class="te-container">
        <div class="te-privacy-inner">
          <span class="te-label-dark">PRIVACY</span>
          <h2 class="te-privacy-title">Zero data collection.</h2>
          <p class="te-privacy-text">
            No analytics. No ads. No tracking pixels. No telemetry.<br/>
            Your microphone is used only for pitch detection. Nothing is recorded or stored.
          </p>
          <a href="/tune-easy/privacy" class="te-privacy-link">Read the full privacy policy &rarr;</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="te-cta">
      <div class="te-container">
        <div class="te-cta-inner">
          <h2 class="te-cta-title">Get in tune.</h2>
          <p class="te-cta-text">Free on the App Store. No account required.</p>
          <a href="https://apps.apple.com/app/id0000000000" class="te-store-badge" target="_blank" rel="noopener noreferrer">
            <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
          </a>
        </div>
      </div>
    </section>
    <ExploreApps current="tune-easy" />
  </main>

  <!-- Footer -->
  <footer class="te-footer">
    <div class="te-footer-inner">
      <div class="te-footer-links">
        <a href="/tune-easy/support">Support</a>
        <span class="te-footer-dot">&middot;</span>
        <a href="/tune-easy/privacy">Privacy Policy</a>
      </div>
      <div class="te-footer-brand">
        An <a href="/">Idle Fusion</a> app
      </div>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════
     TUNE EASY — Amber / Gold, Musical Theme
     Warm, acoustic, musical
     ═══════════════════════════════════════════════════════ */

  :global(:root) {
    --te-accent: #f59e0b;
    --te-accent-deep: #d97706;
    --te-accent-bg: #fffbeb;
    --te-warm: #ef4444;
    --te-bg: #f8fafc;
    --te-surface: #ffffff;
    --te-border: rgba(148, 163, 184, 0.15);
    --te-text: #0f172a;
    --te-text-muted: #64748b;
    --te-feature-icon-bg: rgba(245, 158, 11, 0.08);
    --te-feature-icon-border: rgba(245, 158, 11, 0.12);
  }

  :global(.dark) {
    --te-accent: #fbbf24;
    --te-accent-deep: #f59e0b;
    --te-accent-bg: #451a03;
    --te-bg: #0a0f1a;
    --te-surface: #111827;
    --te-border: rgba(148, 163, 184, 0.08);
    --te-text: #f1f5f9;
    --te-text-muted: #94a3b8;
    --te-feature-icon-bg: rgba(245, 158, 11, 0.1);
    --te-feature-icon-border: rgba(245, 158, 11, 0.15);
  }

  /* ─── Nav ─── */
  .te-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--te-bg);
    border-bottom: 1px solid var(--te-border);
    backdrop-filter: blur(12px);
  }

  .te-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
  }

  @media (min-width: 640px) {
    .te-nav-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .te-nav-inner { padding: 0 3rem; }
  }

  .te-logo {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--te-accent-deep);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .te-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .te-nav-cta img {
    height: 32px;
    transition: opacity 0.2s;
  }

  .te-nav-cta:hover img {
    opacity: 0.7;
  }

  /* ─── Hero ─── */
  .te-hero {
    background: #0a0f1a;
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .te-hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.12;
  }

  .te-hero-glow--warm {
    top: -30%;
    left: -10%;
    background: var(--te-warm);
  }

  .te-hero-glow--cool {
    bottom: -40%;
    right: -10%;
    background: var(--te-accent);
  }

  .te-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .te-hero-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .te-hero-inner { padding: 0 3rem; }
  }

  .te-hero-content {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .te-hero-content {
      flex-direction: row;
      text-align: left;
      gap: 4rem;
    }
  }

  .te-hero-text { flex: 1; }

  .te-hero-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--te-accent);
    margin-bottom: 1.5rem;
  }

  .te-hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: #f1f5f9;
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .te-hero-title em {
    font-style: italic;
    color: var(--te-accent);
  }

  .te-hero-subtitle {
    font-size: 1.125rem;
    color: #94a3b8;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  @media (max-width: 767px) {
    .te-hero-subtitle { margin-left: auto; margin-right: auto; }
  }

  .te-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .te-hero-actions { align-items: flex-start; }
  }

  .te-store-badge {
    display: inline-block;
  }

  .te-store-badge img {
    height: 54px;
    transition: opacity 0.2s;
  }

  .te-store-badge:hover img { opacity: 0.8; }

  .te-hero-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .te-hero-icon-wrap { flex-shrink: 0; }

  .te-hero-icon {
    width: 180px;
    height: 180px;
    border-radius: 40px;
    box-shadow: 0 20px 60px rgba(245, 158, 11, 0.2), 0 0 80px rgba(245, 158, 11, 0.08);
  }

  @media (min-width: 768px) {
    .te-hero-icon {
      width: 240px;
      height: 240px;
      border-radius: 54px;
    }
  }

  /* ─── Screenshots ─── */
  .te-screenshots {
    padding: 2rem 0 4rem;
    overflow: hidden;
  }
  .te-screenshots-inner {
    max-width: 400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .te-screenshot {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  /* ─── Containers ─── */
  .te-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .te-container-wide {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .te-container { padding: 0 2rem; }
    .te-container-wide { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .te-container { padding: 0 3rem; }
    .te-container-wide { padding: 0 3rem; }
  }

  /* ─── Features ─── */
  .te-features-section {
    background: var(--te-surface);
    padding: 5rem 0;
  }

  .te-features-header {
    margin-bottom: 3.5rem;
    max-width: 520px;
  }

  .te-label-dark {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--te-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .te-features-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    color: var(--te-text);
    margin-bottom: 1rem;
  }

  .te-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--te-border);
    border: 1px solid var(--te-border);
    border-radius: 16px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .te-features { grid-template-columns: 1fr 1fr; }
  }

  .te-feature {
    padding: 2rem;
    background: var(--te-surface);
  }

  .te-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--te-feature-icon-bg);
    border: 1px solid var(--te-feature-icon-border);
    border-radius: 10px;
    color: var(--te-accent-deep);
    margin-bottom: 1.25rem;
  }

  .te-feature h3 {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--te-text);
    margin-bottom: 0.625rem;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .te-feature p {
    color: var(--te-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* ─── Privacy Banner ─── */
  .te-privacy-banner {
    background: #0a0f1a;
    padding: 5rem 0;
    border-top: 1px solid rgba(148, 163, 184, 0.08);
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }

  .te-privacy-inner {
    text-align: center;
  }

  .te-privacy-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #f1f5f9;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .te-privacy-text {
    font-size: 1.0625rem;
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .te-privacy-link {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--te-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .te-privacy-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── CTA ─── */
  .te-cta {
    padding: 6rem 0;
    background: var(--te-accent-bg);
    position: relative;
    overflow: hidden;
  }

  .te-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  .te-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--te-text);
    margin-bottom: 1rem;
  }

  .te-cta-text {
    font-size: 1.125rem;
    color: var(--te-text-muted);
    margin-bottom: 2rem;
  }

  /* ─── Footer ─── */
  .te-footer {
    background: var(--te-bg);
    border-top: 1px solid var(--te-border);
    padding: 2rem 0;
  }

  .te-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .te-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .te-footer-inner { padding: 0 3rem; }
  }

  .te-footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .te-footer-links a {
    color: var(--te-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .te-footer-links a:hover {
    color: var(--te-accent);
  }

  .te-footer-dot {
    color: var(--te-text-muted);
    opacity: 0.4;
  }

  .te-footer-brand {
    font-size: 0.8125rem;
    color: var(--te-text-muted);
    opacity: 0.6;
  }

  .te-footer-brand a {
    color: var(--te-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .te-footer-brand a:hover {
    color: var(--te-accent);
  }
</style>
