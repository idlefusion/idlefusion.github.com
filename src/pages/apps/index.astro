---
import Layout from '../../layouts/SiteLayout.astro';
import { appsByPopularity, featuredApps, visibleApps } from '../../data/apps';
const featured = new Set(featuredApps.map((app) => app.slug));
// The middle icon is drawn largest, so the most popular app goes there.
const [first, second, third] = featuredApps;
const iconArt = [second, first, third];
const focus = new Set(['focus-easy', 'pomo-easy', 'track-easy', 'voice-easy']);
const everyday = new Set([
  'check-yourself',
  'count-easy',
  'spend-easy',
  'decibel',
  'tune-easy',
  'split-easy',
]);
const category = (slug: string) =>
  focus.has(slug) ? 'Focus' : everyday.has(slug) ? 'Everyday' : 'Health';
---

<Layout
  title="Our apps"
  active="apps"
  description="Small, privacy-minded iOS apps made by Idle Fusion for health, focus, and everyday life. Browse the collection by category or search for an app."
>
  <section class="page-intro wrap">
    <span class="label"><span class="idx">Apps</span> Made by Idle Fusion</span>
    <h1 class="h1">A little simpler. <span class="hand cerulean">Every day.</span></h1>
    <div class="intro-row">
      <p class="lede">
        Small, purpose-built apps for the things you do every day. Thoughtfully designed, with
        privacy at their heart.
      </p>
      <span class="meta">{visibleApps.length} independent apps</span>
    </div>
  </section>
  <section class="wrap">
    <div class="apps-feature">
      <div>
        <span class="label">The everyday collection</span>
        <h2 class="h2">Less friction. More living.</h2>
        <p>
          Build a habit, find your focus, or make room to breathe. Find the tool that fits your day.
        </p>
        <p>
          Most loved right now:{' '}
          {featuredApps.map((app, i) => [
            <a href={`/${app.slug}/`}>{app.name}</a>,
            i < featuredApps.length - 2 ? ', ' : i === featuredApps.length - 2 ? ', and ' : '.',
          ])}
        </p>
        <a class="link-arrow" href={`/${first.slug}/`}
          >Meet {first.name}, our most popular app <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="app-icon-art">
        {
          iconArt.map((app, i) => (
            <a href={`/${app.slug}/`}>
              <img
                src={app.icon}
                alt={`${app.name} icon`}
                width={i === 1 ? 128 : 96}
                height={i === 1 ? 128 : 96}
              />
            </a>
          ))
        }
      </div>
    </div>
    <div class="filter-bar">
      <div class="filters" aria-label="Filter apps">
        {
          ['All apps', 'Health', 'Focus', 'Everyday'].map((name, i) => (
            <button class="filter" data-app-filter={i === 0 ? 'All' : name} aria-pressed={i === 0}>
              {name}
            </button>
          ))
        }
      </div>
      <label class="search-field">
        Find an app<input id="app-search" type="search" placeholder="Search the collection" />
      </label>
    </div>
    <p class="meta" id="app-count" aria-live="polite" style="margin-bottom:8px">
      {visibleApps.length} apps
    </p>
    <div class="app-grid">
      {
        appsByPopularity.map((app) => (
          <a
            class="app-tile"
            data-app-category={category(app.slug)}
            data-search={`${app.name} ${app.category} ${app.desc}`.toLowerCase()}
            href={`/${app.slug}/`}
          >
            <>
              <img src={app.icon} alt="" width="56" height="56" loading="lazy" />
              <div>
                <>
                  <p class="app-category">
                    {featured.has(app.slug) ? `Popular · ${app.category}` : app.category}
                  </p>
                  <h3>
                    {app.name} <span aria-hidden="true">→</span>
                  </h3>
                  <p>{app.desc}</p>
                </>
              </div>
            </>
          </a>
        ))
      }
    </div>
    <p class="empty-state" id="app-empty" hidden>
      No apps found. Try another search or choose All apps.
    </p>
  </section>
</Layout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-app-filter]');
  const search = document.getElementById('app-search') as HTMLInputElement;
  const tiles = document.querySelectorAll<HTMLElement>('[data-app-category]');
  let category = 'All';
  function updateApps() {
    let count = 0;
    tiles.forEach((tile) => {
      tile.hidden =
        (category !== 'All' && tile.dataset.appCategory !== category) ||
        !tile.dataset.search!.includes(search.value.trim().toLowerCase());
      if (!tile.hidden) count++;
    });
    document.getElementById('app-count')!.textContent = `${count} ${count === 1 ? 'app' : 'apps'}`;
    document.getElementById('app-empty')!.hidden = count > 0;
  }
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      category = button.dataset.appFilter!;
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      updateApps();
    }),
  );
  search.addEventListener('input', updateApps);
</script>
