---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const apps = [
  { slug: 'contrast', name: 'Contrast', category: 'Sauna + Cold Plunge', tagline: 'Purpose-built for contrast therapy', desc: 'A beautiful timer for sauna and cold plunge sessions with HealthKit sync, Apple Watch support, and guided protocols.', icon: '/img/contrast/icon.png', color: '#E67348' },
  { slug: 'fast-easy', name: 'Fast Easy', category: 'Fasting Timer', tagline: 'Fasting made simple', desc: 'A simple, beautiful fasting timer. Track intermittent fasting with zero complexity—no accounts, no tracking, no subscriptions.', icon: '/img/fast-easy/icon.png', color: '#4CAF50' },
  { slug: 'focus-easy', name: 'Focus Easy', category: 'Minimalist Launcher', tagline: 'Replace clutter with calm', desc: 'A distraction-free home screen launcher. Your essential apps, one tap away. Nothing else.', icon: '/img/focus-easy/icon.png', color: '#607D8B' },
  { slug: 'run-easy', name: 'Run Easy', category: 'Heart Rate Zone Training', tagline: 'Train smarter, not harder', desc: 'Heart rate zone training on Apple Watch built around the Maffetone method with real-time coaching and haptic cues.', icon: '/img/run-easy/icon.png', color: '#FF5722' },
  { slug: 'check-yourself', name: 'Check Yourself', category: 'Camera Mirror', tagline: 'Quick check before your call', desc: 'A lightweight macOS menu bar app to check your appearance before meetings. One click, instant mirror.', icon: '/img/check-yourself/icon.png', color: '#9C27B0' },
  { slug: 'breathe-easy', name: 'Breathe Easy', category: 'Breathing Exercises', tagline: 'Breathe better, feel better', desc: 'Guided breathing exercises with haptic feedback. Box breathing, 4-7-8, and customizable patterns.', icon: '/img/breathe-easy/icon.png', color: '#00BCD4' },
  { slug: 'track-easy', name: 'Track Easy', category: 'Habit Tracker', tagline: 'Build habits that stick', desc: 'Track habits without the hassle. Unlimited habits, streaks, widgets, and Apple Watch support.', icon: '/img/track-easy/icon.png', color: '#8BC34A' },
  { slug: 'mood-easy', name: 'Mood Easy', category: 'Mood Tracker', tagline: 'Your year in pixels', desc: 'Track your mood privately with quick emoji logging and beautiful Year in Pixels visualization.', icon: '/img/mood-easy/icon.png', color: '#FFEB3B' },
  { slug: 'pomo-easy', name: 'Pomo Easy', category: 'Pomodoro Timer', tagline: 'Focus in 25-minute sprints', desc: 'The Pomodoro technique, beautifully executed. Live Activities, widgets, and Apple Watch.', icon: '/img/pomo-easy/icon.png', color: '#F44336' },
  { slug: 'hydrate', name: 'Hydrate', category: 'Water Tracker', tagline: 'Stay hydrated, stay healthy', desc: 'Track your daily water intake with quick-log buttons, widgets, and HealthKit sync.', icon: '/img/hydrate/icon.png', color: '#2196F3' },
  { slug: 'count-easy', name: 'Count Easy', category: 'Tally Counter', tagline: 'Count anything', desc: 'Count anything with satisfying haptics. Multiple counters, history, widgets, and Apple Watch.', icon: '/img/count-easy/icon.png', color: '#795548' },
  { slug: 'cycle-easy', name: 'Cycle Easy', category: 'Period Tracker', tagline: 'Your cycle, your privacy', desc: 'Privacy-first period tracking. Everything stays on your device—no accounts, no cloud, no tracking.', icon: '/img/cycle-easy/icon.png', color: '#E91E63' },
  { slug: 'voice-easy', name: 'Voice Easy', category: 'Voice Recorder', tagline: 'Record privately, transcribe locally', desc: 'Record voice memos with on-device transcription. Your voice never leaves your device.', icon: '/img/voice-easy/icon.png', color: '#673AB7' },
  { slug: 'weigh-easy', name: 'Weigh Easy', category: 'Weight Tracker', tagline: 'Track your journey privately', desc: 'Track your weight with trend charts, goals, measurements, and progress photos—all stored locally.', icon: '/img/weigh-easy/icon.png', color: '#3F51B5' },
  { slug: 'pressure-easy', name: 'Pressure Easy', category: 'Blood Pressure', tagline: 'Know your numbers', desc: 'Track blood pressure with AHA category indicators and PDF export for your doctor.', icon: '/img/pressure-easy/icon.png', color: '#009688' },
  { slug: 'spend-easy', name: 'Spend Easy', category: 'Expense Tracker', tagline: 'No bank required', desc: 'Track spending privately. No bank connections, no cloud sync, no subscriptions. Your money, your business.', icon: '/img/spend-easy/icon.png', color: '#4CAF50' },
  { slug: 'rest-easy', name: 'Rest Easy', category: 'Sleep Sounds', tagline: 'Drift off peacefully', desc: 'Soothing ambient sounds for better sleep. Mix soundscapes, set a timer, and rest easy.', icon: '/img/rest-easy/icon.png', color: '#3F51B5' },
  { slug: 'meds-easy', name: 'Meds Easy', category: 'Medication Tracker', tagline: 'Never miss a dose', desc: 'Medication schedules, reminders, and refill tracking—without sharing your health data.', icon: '/img/meds-easy/icon.png', color: '#26A69A' },
  { slug: 'decibel', name: 'Decibel', category: 'Sound Meter', tagline: 'Measure sound instantly', desc: 'Real-time decibel meter with NIOSH exposure warnings. Protect your hearing.', icon: '/img/decibel/icon.png', color: '#00C853' },
  { slug: 'caffeine-easy', name: 'Caffeine Easy', category: 'Caffeine Tracker', tagline: 'Know when you\'ll sleep', desc: 'Track when caffeine clears your system with half-life science and beautiful decay visualization.', icon: '/img/caffeine-easy/icon.png', color: '#795548' },
  { slug: 'stretch-easy', name: 'Stretch Easy', category: 'Stretching Routines', tagline: 'Move better, feel better', desc: 'Guided stretching routines with timers, haptic cues, and Apple Watch support.', icon: '/img/stretch-easy/icon.png', color: '#26A69A' },
  { slug: 'tune-easy', name: 'Tune Easy', category: 'Guitar Tuner', tagline: 'Tune simply', desc: 'Standard tuning for guitar with real-time pitch detection and reference tones. No complexity.', icon: '/img/tune-easy/icon.png', color: '#D4A574' },
];

// Pick a random spotlight app
const spotlightApp = apps[Math.floor(Math.random() * apps.length)];
---

<BaseLayout
  title="Our Apps - Idle Fusion"
  description="Privacy-first apps designed with care. No accounts, no subscriptions, no data collection. Just tools that work."
>
  <Header currentPage="apps" />

  <main>
    <!-- Spotlight Hero -->
    <section class="spotlight" style={`--spotlight-color: ${spotlightApp.color}`}>
      <div class="spotlight-inner">
        <div class="spotlight-content">
          <span class="spotlight-label">App Spotlight</span>
          <div class="spotlight-category">{spotlightApp.category}</div>
          <h1 class="spotlight-title">{spotlightApp.name}</h1>
          <p class="spotlight-tagline">{spotlightApp.tagline}</p>
          <p class="spotlight-desc">{spotlightApp.desc}</p>
          <div class="spotlight-actions">
            <a href={`/${spotlightApp.slug}`} class="btn btn-light">
              Learn more
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M10 5l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="spotlight-visual">
          <div class="spotlight-icon-wrapper">
            <img src={spotlightApp.icon} alt={`${spotlightApp.name} icon`} class="spotlight-icon" width="280" height="280" />
          </div>
        </div>
      </div>
    </section>

    <!-- All Apps Grid -->
    <section class="apps-section">
      <div class="apps-container">
        <div class="apps-header">
          <h2 class="apps-title">All Apps</h2>
          <p class="apps-subtitle">Privacy-first. No accounts. No subscriptions.</p>
        </div>

        <div class="apps-grid">
          {apps.map(app => (
            <a href={`/${app.slug}`} class="app-card">
              <img src={app.icon} alt={`${app.name} icon`} class="app-card-icon" width="72" height="72" />
              <div class="app-card-content">
                <span class="app-card-category">{app.category}</span>
                <h3 class="app-card-name">{app.name}</h3>
                <p class="app-card-tagline">{app.tagline}</p>
              </div>
              <svg class="app-card-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Privacy Banner -->
    <section class="privacy-banner">
      <div class="privacy-inner">
        <div class="privacy-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="privacy-content">
          <h3 class="privacy-title">Your data stays yours</h3>
          <p class="privacy-desc">Every app we make stores data locally on your device. No accounts, no cloud sync, no analytics. Privacy isn't a feature—it's the foundation.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Spotlight Section */
  .spotlight {
    background: linear-gradient(135deg, var(--spotlight-color) 0%, color-mix(in srgb, var(--spotlight-color) 70%, #000) 100%);
    padding: 5rem 0;
    position: relative;
    overflow: hidden;
  }

  .spotlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  .spotlight-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .spotlight-inner {
      grid-template-columns: 1fr 1fr;
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .spotlight-inner {
      padding: 0 3rem;
    }
  }

  .spotlight-content {
    color: white;
  }

  .spotlight-label {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.15);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
  }

  .spotlight-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .spotlight-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 1;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .spotlight-tagline {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    opacity: 0.9;
    margin: 0 0 1rem;
  }

  .spotlight-desc {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.125rem;
    line-height: 1.6;
    opacity: 0.8;
    margin: 0 0 2rem;
    max-width: 28rem;
  }

  .spotlight-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .spotlight-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .spotlight-icon-wrapper {
    position: relative;
  }

  .spotlight-icon-wrapper::before {
    content: '';
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    border-radius: 50%;
  }

  .spotlight-icon {
    border-radius: 56px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.4);
    position: relative;
  }

  /* Apps Section */
  .apps-section {
    padding: 5rem 0;
    background: var(--bg-secondary);
  }

  .apps-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .apps-container { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .apps-container { padding: 0 3rem; }
  }

  .apps-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .apps-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  .apps-subtitle {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.125rem;
    color: var(--text-muted);
    margin: 0;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .apps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .app-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .app-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }

  :global(.dark) .app-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .app-card-icon {
    flex-shrink: 0;
    border-radius: 16px;
  }

  .app-card-content {
    flex: 1;
    min-width: 0;
  }

  .app-card-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.25rem;
  }

  .app-card-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 0.25rem;
    line-height: 1.2;
  }

  .app-card-tagline {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .app-card-arrow {
    flex-shrink: 0;
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .app-card:hover .app-card-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent);
  }

  /* Privacy Banner */
  .privacy-banner {
    padding: 4rem 0;
    background: var(--bg-primary);
    border-top: 1px solid var(--border-color);
  }

  .privacy-inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .privacy-inner {
      flex-direction: row;
      text-align: left;
      gap: 2rem;
    }
  }

  .privacy-icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--accent);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .privacy-content {
    flex: 1;
  }

  .privacy-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  .privacy-desc {
    font-family: 'Satoshi', sans-serif;
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
