---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import AppLayout from '../../layouts/AppLayout.astro';
import { currencyScreenshots } from '../../data/currency';

// Prerendered modules move during builds; asset checks use the project root.
const projectRoot = process.cwd();

const screenshotVariants = currencyScreenshots.map((shot) => ({
  ...shot,
  src: `/${shot.path}`,
  available: existsSync(join(projectRoot, 'public', shot.path)),
}));

const currencyVariants = [
  { code: 'EUR', name: 'Dollar to Euro' },
  { code: 'JPY', name: 'Dollar to Yen' },
  { code: 'GBP', name: 'Dollar to Pound' },
  { code: 'CAD', name: 'Dollar to CAD' },
  { code: 'AUD', name: 'Dollar to AUD' },
  { code: 'CHF', name: 'Dollar to Franc' },
  { code: 'CNY', name: 'Dollar to Yuan' },
  { code: 'HKD', name: 'Dollar to HKD' },
  { code: 'NZD', name: 'Dollar to NZD' },
  { code: 'SEK', name: 'Dollar to Krona' },
  { code: 'KRW', name: 'Dollar to Won' },
  { code: 'SGD', name: 'Dollar to SGD' },
  { code: 'NOK', name: 'Dollar to NOK' },
  { code: 'MXN', name: 'Dollar to Peso' },
  { code: 'INR', name: 'Dollar to Rupee' },
  { code: 'BRL', name: 'Dollar to Real' },
  { code: 'ZAR', name: 'Dollar to Rand' },
  { code: 'AED', name: 'Dollar to Dirham' },
  { code: 'TRY', name: 'Dollar to Lira' },
  { code: 'TWD', name: 'Dollar to TWD' },
];

const values = [
  [
    'Fast keypad entry',
    'Punch in an amount instantly with a numeric keypad tuned for one-handed use.',
  ],
  [
    'Offline cache fallback',
    'When network access drops, recent rates are cached so conversions keep working.',
  ],
  [
    'Light & dark support',
    'Every screen is polished for both themes to stay readable in any environment.',
  ],
];

const steps = [
  ['1. Choose your converter', 'Pick the app matching the currency you use most.'],
  ['2. Enter amount with the keypad', 'Type naturally and see USD output update in real time.'],
  ['3. Trust the result anywhere', 'Live rates when online, smart cached fallback when offline.'],
];

const faqs = [
  {
    question: 'Are these all separate apps?',
    answer:
      'Yes. Each app is a focused converter for one currency-to-USD workflow, built from the same proven Pesos Dos foundation.',
  },
  {
    question: 'Do I need an account to use them?',
    answer:
      'No account, login, or subscription required. Install, open, and start converting immediately.',
  },
  {
    question: 'How does offline mode work?',
    answer:
      'If live rates are unavailable, the app falls back to a recently cached rate so you can keep moving. It refreshes automatically when connectivity returns.',
  },
  {
    question: 'Will Android versions be available?',
    answer: 'This launch is iOS-first. Contact us to ask about plans for other platforms.',
  },
];

const family = {
  slug: 'apps/currency',
  name: 'Currency apps',
  icon: '',
  pigments: ['#1f9e6e', '#2a7fb8'] as [string, string],
  ink: '#16704e',
  store: null,
  platform: 'iOS' as const,
};
---

<AppLayout
  title="Currency Apps — Idle Fusion"
  description="A family of 20 fast USD converter apps inspired by Pesos Dos. Fast keypad entry, offline cache fallback, and beautiful light/dark support."
  canonical="https://idlefusion.com/apps/currency"
  app={family}
  kind="landing"
  policies={false}
  maker="These converters are designed and built by Idle Fusion"
  sections={[
    { id: 'screenshots', label: 'Screenshots' },
    { id: 'family', label: 'All 20' },
  ]}
>
  <main id="main">
    <section class="wrap app-hero">
      <div class="app-hero-copy">
        <p class="label"><span class="app-dot"></span> New app family</p>
        <h1 class="h1 app-title long">
          20 currency apps, one ultra-fast <em class="hand app-hand">conversion experience.</em>
        </h1>
        <p class="lede">
          Built from the Pesos Dos playbook, each app is purpose-built for one job: convert local
          currency to USD in seconds with clean, focused controls.
        </p>
        <div class="actions">
          <a class="btn" href="#cta">
            <span class="btn-text">Check availability</span><span
              class="btn-arrow"
              aria-hidden="true">→</span
            >
          </a>
          <a class="link-arrow" href="#family"
            >Browse 20 variants <span aria-hidden="true">↓</span></a
          >
        </div>
      </div>
      <figure class="app-hero-art v1">
        <span class="app-wash a" style="--mask: url(/img/paint/app-wash-1a.webp)"></span>
        <span class="app-wash b" style="--mask: url(/img/paint/app-wash-1b.webp)"></span>
        <svg class="construction" viewBox="0 0 1100 1000" aria-hidden="true">
          <ellipse
            class="geo draw"
            cx="420"
            cy="520"
            rx="255"
            ry="330"
            transform="rotate(32 420 520)"></ellipse>
          <ellipse
            class="geo draw"
            cx="640"
            cy="470"
            rx="255"
            ry="330"
            transform="rotate(32 640 470)"></ellipse>
        </svg>
        <span class="app-hero-icon app-glyph" aria-hidden="true">$</span>
        <figcaption class="label app-fig">Fig. — One core, twenty currencies</figcaption>
      </figure>
    </section>

    <section class="wrap app-section" aria-label="Highlights">
      <ol class="app-features">
        {
          values.map(([title, text], i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="h3">{title}</h2>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="app-section app-shots" id="screenshots" aria-labelledby="screenshots-title">
      <div class="wrap">
        <header class="section-head">
          <span class="label"><span class="idx">01</span> In-app preview</span>
          <span class="meta"
            >{screenshotVariants.length} screens · scroll <span aria-hidden="true">→</span></span
          >
        </header>
        <div class="section-title">
          <h2 id="screenshots-title">Real app screens, ready for each market.</h2>
          <p>Explore the focused conversion experience across a selection of currencies.</p>
        </div>
      </div>
      <ol class="shot-strip" tabindex="0" aria-label="Currency app screenshots">
        {
          screenshotVariants.map((shot, i) => (
            <li>
              <figure>
                {shot.available ? (
                  <img
                    src={shot.src}
                    alt={shot.title}
                    width="1320"
                    height="2868"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="shot-placeholder" aria-hidden="true">
                    <span class="h3">{shot.code}</span>
                    <span class="meta">Screenshot pending</span>
                  </div>
                )}
                <figcaption class="meta">
                  {String(i + 1).padStart(2, '0')} — {shot.title}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap app-section" id="family" aria-labelledby="family-title">
      <header class="section-head">
        <span class="label"><span class="idx">02</span> App family overview</span>
      </header>
      <div class="section-title">
        <h2 id="family-title">20 conversion variants from one trusted core.</h2>
      </div>
      <ul class="currency-grid">
        {
          currencyVariants.map((variant) => (
            <li>
              <span class="code">{variant.code}</span>
              <span class="name">{variant.name}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap app-section" aria-labelledby="how-title">
      <header class="section-head">
        <span class="label"><span class="idx">03</span> How it works</span>
      </header>
      <div class="section-title">
        <h2 id="how-title">Simple by <em class="hand app-hand">design.</em></h2>
      </div>
      <ol class="app-features">
        {
          steps.map(([title, text], i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap app-cta" id="cta" aria-labelledby="app-cta-title">
      <span class="app-cta-wash a"></span>
      <span class="app-cta-wash b"></span>
      <div class="app-cta-inner">
        <span
          class="app-glyph"
          aria-hidden="true"
          style="width:96px;height:96px;font-size:56px;border-radius:22px">$</span
        >
        <div>
          <p class="label">Get access</p>
          <h2 id="app-cta-title">Be first to know when these apps hit the App Store.</h2>
          <p>App Store links and launch timing will appear here as each variant ships.</p>
        </div>
        <div style="display:grid;gap:14px;justify-items:start">
          <span class="store-soon">
            <span class="store-soon-dot" aria-hidden="true"></span>App Store (coming soon)
          </span>
          <a class="link-arrow" href="/contact/"
            >Ask about availability <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>

    <section class="wrap app-section" aria-label="Frequently asked questions">
      <div class="faq">
        <div class="faq-aside">
          <span class="label"><span class="idx">FAQ</span></span>
          <h2 class="h2">Common questions</h2>
        </div>
        <div class="faq-list">
          {
            faqs.map((item, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>{item.question}</summary>
                <div class="answer">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</AppLayout>
