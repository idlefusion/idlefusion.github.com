---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Split Easy - Privacy Policy"
  description="Privacy policy for Split Easy"
  ogUrl="https://idlefusion.com/split-easy/privacy"
>
  <main>
    <section class="section-padding">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-2">Privacy Policy</h1>
        <p class="text-sm text-[var(--text-secondary)] mb-12">Split Easy - Bill Splitting &middot; Effective February 23, 2026</p>
        <div class="space-y-8 text-[var(--text-secondary)] leading-relaxed">
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Short version</h2>
            <p>Split Easy stores split data locally and does not profile users for ads or analytics.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Local-first storage</h2>
            <p>Party members, split values, and shared results remain in local app storage. There is no backend account database.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Optional sharing</h2>
            <p>Share cards are generated locally and sent through iOS sharing flows. We do not run your share data through external analytics.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Contact</h2>
            <p>Privacy requests: <a href="mailto:support@idlefusion.com?subject=Split%20Easy%20Privacy" class="text-[var(--accent-primary)] hover:underline">support@idlefusion.com</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
