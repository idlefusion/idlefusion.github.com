---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const currentPath = Astro.url.pathname;
---

<BaseLayout
  title="Page Not Found — Idle Fusion"
  description="The page you are looking for does not exist. Browse the Idle Fusion app directory or return to the homepage."
  robots="noindex, nofollow"
>
  <Header />

  <main class="not-found-page">
    <section class="not-found-app-shell">
      <div class="not-found-mesh"></div>

      <article class="missing-app">
        <p class="missing-app-label">404 <span class="not-found-text">Not Found</span></p>

        <div class="missing-title-row">
          <p class="app-label">Requested path</p>
          <p class="app-path">{currentPath}</p>
        </div>

        <section class="ios-hub" aria-label="Missing app">
          <div class="ios-app-frame">
            <div class="ios-notch"></div>
            <p class="ios-app-header">Missing App</p>
            <div class="ios-app-icon" aria-hidden="true">
              <span class="app-tile-copy">404</span>
              <span class="tile-cross tile-cross-1"></span>
              <span class="tile-cross tile-cross-2"></span>
            </div>
          </div>
          <div class="quick-actions" aria-live="polite">
            <a href="/" class="btn btn-primary">Back to Home</a>
          </div>
        </section>
      </article>
    </section>
  </main>

  <Footer variant="compact" />
</BaseLayout>

<style>
  .not-found-page {
    position: relative;
    padding: 4rem 0;
    min-height: calc(100vh - var(--footer-space, 0px));
    background:
      radial-gradient(circle at 12% 14%, rgba(36, 120, 102, 0.09), transparent 36%),
      radial-gradient(circle at 88% 90%, rgba(36, 120, 102, 0.07), transparent 36%),
      linear-gradient(130deg, color-mix(in srgb, var(--bg-primary) 92%, black), var(--bg-primary));
    overflow: hidden;
  }

  .not-found-app-shell {
    position: relative;
    max-width: 62rem;
    margin: 0 auto;
    padding: 1rem;
    min-height: calc(100vh - 8rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .not-found-app-shell {
      padding: 1rem 2rem;
    }
  }

  .not-found-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: 24px;
    background-image:
      linear-gradient(to right, rgba(247, 245, 239, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(247, 245, 239, 0.06) 1px, transparent 1px);
    background-size: 46px 46px;
    opacity: 0.34;
    animation: pulse-grid 8s ease-in-out infinite;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.75));
  }

  .not-found-mesh::before,
  .not-found-mesh::after {
    content: '';
    position: absolute;
    width: 220px;
    aspect-ratio: 1;
    border-radius: 32px;
    border: 1px solid color-mix(in srgb, var(--border-color) 55%, transparent);
    right: -74px;
    top: -64px;
    transform: rotate(14deg);
    opacity: 0.34;
    filter: blur(0.2px);
  }

  .not-found-mesh::after {
    left: -54px;
    right: auto;
    bottom: -74px;
    top: auto;
    transform: rotate(-15deg);
    opacity: 0.26;
  }

  .missing-app {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: 26px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-card) 95%, transparent), color-mix(in srgb, var(--bg-card) 80%, transparent));
    box-shadow:
      0 24px 64px rgba(17, 17, 15, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    padding: clamp(1.4rem, 3.2vw, 2rem);
    backdrop-filter: blur(2px);
    animation: appear 560ms cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid color-mix(in srgb, var(--border-color) 82%, transparent);
  }

  .missing-app-label {
    margin: 0 0 1rem;
    text-align: center;
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .not-found-text {
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    opacity: 0.9;
  }

  .missing-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
    justify-content: center;
  }

  .app-label {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
  }

  .app-path {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-primary);
    background: var(--bg-secondary);
    padding: 0.35rem 0.55rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    word-break: break-all;
  }

  .ios-hub {
    display: grid;
    gap: 1rem;
    justify-items: center;
    margin: 0 auto;
    align-items: center;
  }

  .ios-app-frame {
    justify-self: center;
    width: min(360px, 100%);
    border-radius: 32px;
    padding: 1.15rem;
    background:
      linear-gradient(160deg, rgba(247, 245, 239, 0.06), rgba(247, 245, 239, 0.01)),
      var(--bg-primary);
    border: 1px solid var(--border-color);
    box-shadow: 0 26px 70px rgba(17, 17, 15, 0.34), var(--shadow-xl);
    position: relative;
    overflow: hidden;
    text-align: center;
    animation: app-focus 900ms cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(2px);
  }

  .ios-app-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 85% 10%, rgba(36, 120, 102, 0.18), transparent 42%);
    pointer-events: none;
  }

  .ios-app-frame::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px dashed color-mix(in srgb, var(--border-color) 65%, transparent);
    border-radius: 26px;
    opacity: 0.75;
  }

  .ios-notch {
    position: relative;
    width: 56px;
    height: 14px;
    margin: 0.2rem auto 1rem;
    border-radius: 999px;
    background: rgba(247, 245, 239, 0.3);
    opacity: 0.85;
    box-shadow: inset 0 0 0 2px rgba(17, 17, 15, 0.12);
  }

  .ios-app-header {
    position: relative;
    margin: 0 0 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .ios-app-icon {
    margin: 0 auto;
    width: 150px;
    height: 150px;
    border-radius: 34px;
    position: relative;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(150deg, #0f2620, #1d6f5e 35%, #3ba58c 70%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.15),
      0 14px 34px rgba(17, 17, 15, 0.24);
    overflow: hidden;
    animation: icon-drift 2.8s ease-in-out infinite alternate;
  }

  .app-tile-copy {
    font-size: 1.45rem;
    font-weight: 700;
    position: relative;
    z-index: 2;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.08em;
  }

  .tile-cross {
    position: absolute;
    inset: auto;
    width: 76px;
    height: 2px;
    background: rgba(255, 255, 255, 0.9);
    transform-origin: center;
  }

  .tile-cross-1 {
    transform: rotate(45deg);
  }

  .tile-cross-2 {
    transform: rotate(-45deg);
  }

  .ios-app-icon::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 2px dashed rgba(255, 255, 255, 0.5);
    border-radius: 16px;
    opacity: 0.7;
  }

  .ios-app-name {
    margin: 0.9rem 0 0.2rem;
    font-weight: 700;
    font-family: 'Satoshi', sans-serif;
  }

  .ios-app-sub {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .quick-actions {
    width: min(360px, 100%);
    display: grid;
    gap: 0.85rem;
    align-content: center;
    margin-top: 1rem;
    padding: 0.25rem;
  }

  @keyframes app-focus {
    from {
      transform: scale(0.985);
      filter: saturate(0.9);
    }

    to {
      transform: scale(1);
      filter: saturate(1.04);
    }
  }

  @keyframes icon-drift {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-6px);
    }
  }

  .quick-actions .btn {
    width: 100%;
    justify-content: center;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    font-size: 1rem;
    border-radius: 12px;
  }

  @keyframes pulse-grid {
    0%,
    100% {
      opacity: 0.35;
    }

    50% {
      opacity: 0.65;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 500px) {
    .not-found-page {
      padding: 2rem 0 3rem;
    }
  }
</style>
