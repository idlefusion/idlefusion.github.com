---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ExploreApps from '../../components/ExploreApps.astro';
---

<BaseLayout
  title="Stretch Easy — Guided Stretching Routines for iOS"
  description="Simple guided stretching routines with timers. Pre-built or custom routines, haptic cues, Apple Watch support. No accounts, no subscriptions."
  ogImage="/img/stretch-easy/icon.png"
  ogUrl="https://idlefusion.com/stretch-easy"
>

  <!-- App Nav -->
  <nav class="se-nav">
    <div class="se-nav-inner">
      <a href="/stretch-easy" class="se-logo">Stretch Easy</a>
      <div class="se-nav-actions">
        <ThemeToggle />
        <a href="https://apps.apple.com/app/stretch-easy/id0000000000" class="se-nav-cta" target="_blank" rel="noopener noreferrer">
          <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="40" />
        </a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section class="se-hero">
      <div class="se-hero-glow se-hero-glow--primary"></div>
      <div class="se-hero-glow se-hero-glow--accent"></div>
      <div class="se-hero-inner">
        <div class="se-hero-content">
          <div class="se-hero-text">
            <div class="se-hero-badge">GUIDED MOBILITY</div>
            <h1 class="se-hero-title">
              Guided stretching<br/><em>routines.</em>
            </h1>
            <p class="se-hero-subtitle">
              Simple stretch routines with visual timers and haptic cues. Pre-built or custom — pick one and follow along.
            </p>
            <div class="se-hero-actions">
              <a href="https://apps.apple.com/app/stretch-easy/id0000000000" class="se-store-badge" target="_blank" rel="noopener noreferrer">
                <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
              </a>
              <span class="se-hero-note">Free &middot; No account required</span>
            </div>
          </div>
          <div class="se-hero-icon-wrap">
            <img src="/img/stretch-easy/icon.png" alt="Stretch Easy app icon" class="se-hero-icon" width="240" height="240" />
          </div>
        </div>
      </div>
    </section>

    <!-- Screenshots -->
    <section class="se-screenshots">
      <div class="app-screenshots-scroll">
          <img src="/img/stretch-easy/screenshots/01_marketing.png" alt="Stretch Easy screenshot 1" class="app-screenshot" />
          <img src="/img/stretch-easy/screenshots/02_marketing.png" alt="Stretch Easy screenshot 2" class="app-screenshot" />
          <img src="/img/stretch-easy/screenshots/03_marketing.png" alt="Stretch Easy screenshot 3" class="app-screenshot" />
          <img src="/img/stretch-easy/screenshots/04_marketing.png" alt="Stretch Easy screenshot 4" class="app-screenshot" />
        </div>
    </section>

    <!-- Features -->
    <section class="se-features-section">
      <div class="se-container-wide">
        <div class="se-features-header">
          <span class="se-label">FEATURES</span>
          <h2 class="se-features-title">Built for your body.</h2>
        </div>

        <div class="se-features">
          <div class="se-feature">
            <div class="se-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <h3>Pre-Built Routines</h3>
            <p>Morning Wake-Up, Desk Break, Post-Workout, Full Body, Evening Wind-Down — ready to go in seconds.</p>
          </div>

          <div class="se-feature">
            <div class="se-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </div>
            <h3>Custom Routine Builder</h3>
            <p>Build your own routines from 15+ stretches. Set custom durations and save them for next time.</p>
          </div>

          <div class="se-feature">
            <div class="se-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Visual Timers</h3>
            <p>Large countdown display with clear stretch names. See your progress through the routine at a glance.</p>
          </div>

          <div class="se-feature">
            <div class="se-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 8.5 9 12l-3.5 3.5L2 12l3.5-3.5Z"/><path d="m12 2 3.5 3.5L12 9 8.5 5.5 12 2Z"/><path d="M18.5 8.5 22 12l-3.5 3.5L15 12l3.5-3.5Z"/><path d="m12 15 3.5 3.5L12 22l-3.5-3.5L12 15Z"/></svg>
            </div>
            <h3>Haptic Feedback</h3>
            <p>Subtle haptic cues guide you through transitions. Know when to switch without watching the screen.</p>
          </div>

          <div class="se-feature">
            <div class="se-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
            </div>
            <h3>Apple Watch</h3>
            <p>Full routine support on your wrist. Haptic guidance per stretch — use independently or with your iPhone.</p>
          </div>

          <div class="se-feature">
            <div class="se-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <h3>HealthKit Sync</h3>
            <p>Automatically log flexibility workouts to Apple Health. Track your stretching habit over time.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Banner -->
    <section class="se-privacy-banner">
      <div class="se-container">
        <div class="se-privacy-inner">
          <span class="se-label">PRIVACY</span>
          <h2 class="se-privacy-title">Your data stays yours.</h2>
          <p class="se-privacy-text">
            No analytics. No ads. No accounts. No cloud sync.<br/>
            Everything stays on your device. HealthKit logging is optional.
          </p>
          <a href="/stretch-easy/privacy" class="se-privacy-link">Read the full privacy policy &rarr;</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="se-cta">
      <div class="se-container">
        <div class="se-cta-inner">
          <h2 class="se-cta-title">Start stretching.</h2>
          <p class="se-cta-text">Free on the App Store. No account required.</p>
          <a href="https://apps.apple.com/app/stretch-easy/id0000000000" class="se-store-badge" target="_blank" rel="noopener noreferrer">
            <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
          </a>
        </div>
      </div>
    </section>
    <ExploreApps current="stretch-easy" />
  </main>

  <!-- Footer -->
  <footer class="se-footer">
    <div class="se-footer-inner">
      <div class="se-footer-links">
        <a href="/stretch-easy/support">Support</a>
        <span class="se-footer-dot">&middot;</span>
        <a href="/stretch-easy/privacy">Privacy Policy</a>
      </div>
      <div class="se-footer-brand">
        An <a href="/">Idle Fusion</a> app
      </div>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════
     STRETCH EASY — Teal / Mint, Calm Theme
     Fresh, clean, inviting
     ═══════════════════════════════════════════════════════ */

  :global(:root) {
    --se-accent: #2EBFB5;
    --se-accent-deep: #229e96;
    --se-accent-light: #6BE0BD;
    --se-accent-bg: #e6faf8;
    --se-bg: #f8fafc;
    --se-surface: #ffffff;
    --se-border: rgba(148, 163, 184, 0.15);
    --se-text: #0f172a;
    --se-text-muted: #64748b;
    --se-feature-icon-bg: rgba(46, 191, 181, 0.08);
    --se-feature-icon-border: rgba(46, 191, 181, 0.12);
  }

  :global(.dark) {
    --se-accent: #4fd1c5;
    --se-accent-deep: #2EBFB5;
    --se-accent-light: #6BE0BD;
    --se-accent-bg: #0d3331;
    --se-bg: #0a0f1a;
    --se-surface: #111827;
    --se-border: rgba(148, 163, 184, 0.08);
    --se-text: #f1f5f9;
    --se-text-muted: #94a3b8;
    --se-feature-icon-bg: rgba(46, 191, 181, 0.1);
    --se-feature-icon-border: rgba(46, 191, 181, 0.15);
  }

  /* ─── Nav ─── */
  .se-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--se-bg);
    border-bottom: 1px solid var(--se-border);
    backdrop-filter: blur(12px);
  }

  .se-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
  }

  @media (min-width: 640px) {
    .se-nav-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .se-nav-inner { padding: 0 3rem; }
  }

  .se-logo {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--se-accent-deep);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .se-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .se-nav-cta img {
    height: 32px;
    transition: opacity 0.2s;
  }

  .se-nav-cta:hover img {
    opacity: 0.7;
  }

  /* ─── Hero ─── */
  .se-hero {
    background: #0a0f1a;
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .se-hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.15;
  }

  .se-hero-glow--primary {
    top: -30%;
    left: -10%;
    background: #2EBFB5;
  }

  .se-hero-glow--accent {
    bottom: -40%;
    right: -10%;
    background: #6BE0BD;
  }

  .se-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .se-hero-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .se-hero-inner { padding: 0 3rem; }
  }

  .se-hero-content {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .se-hero-content {
      flex-direction: row;
      text-align: left;
      gap: 4rem;
    }
  }

  .se-hero-text { flex: 1; }

  .se-hero-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--se-accent);
    margin-bottom: 1.5rem;
  }

  .se-hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: #f1f5f9;
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .se-hero-title em {
    font-style: italic;
    color: var(--se-accent);
  }

  .se-hero-subtitle {
    font-size: 1.125rem;
    color: #94a3b8;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  @media (max-width: 767px) {
    .se-hero-subtitle { margin-left: auto; margin-right: auto; }
  }

  .se-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .se-hero-actions { align-items: flex-start; }
  }

  .se-store-badge {
    display: inline-block;
  }

  .se-store-badge img {
    height: 54px;
    transition: opacity 0.2s;
  }

  .se-store-badge:hover img { opacity: 0.8; }

  .se-hero-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .se-hero-icon-wrap { flex-shrink: 0; }

  .se-hero-icon {
    width: 180px;
    height: 180px;
    border-radius: 40px;
    box-shadow: 0 20px 60px rgba(46, 191, 181, 0.25), 0 0 80px rgba(46, 191, 181, 0.1);
  }

  @media (min-width: 768px) {
    .se-hero-icon {
      width: 240px;
      height: 240px;
      border-radius: 54px;
    }
  }

  /* ─── Screenshots ─── */
  .se-screenshots {
    padding: 2rem 0 4rem;
    overflow: hidden;
  }
  .se-screenshots-inner {
    max-width: 400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .se-screenshot {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  /* ─── Containers ─── */
  .se-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .se-container-wide {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .se-container { padding: 0 2rem; }
    .se-container-wide { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .se-container { padding: 0 3rem; }
    .se-container-wide { padding: 0 3rem; }
  }

  /* ─── Features ─── */
  .se-features-section {
    background: var(--se-surface);
    padding: 5rem 0;
  }

  .se-features-header {
    margin-bottom: 3.5rem;
    max-width: 520px;
  }

  .se-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--se-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .se-features-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    color: var(--se-text);
    margin-bottom: 1rem;
  }

  .se-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--se-border);
    border: 1px solid var(--se-border);
    border-radius: 16px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .se-features { grid-template-columns: 1fr 1fr; }
  }

  .se-feature {
    padding: 2rem;
    background: var(--se-surface);
  }

  .se-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--se-feature-icon-bg);
    border: 1px solid var(--se-feature-icon-border);
    border-radius: 10px;
    color: var(--se-accent-deep);
    margin-bottom: 1.25rem;
  }

  .se-feature h3 {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--se-text);
    margin-bottom: 0.625rem;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .se-feature p {
    color: var(--se-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* ─── Privacy Banner ─── */
  .se-privacy-banner {
    background: #0a0f1a;
    padding: 5rem 0;
    border-top: 1px solid rgba(148, 163, 184, 0.08);
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }

  .se-privacy-inner {
    text-align: center;
  }

  .se-privacy-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #f1f5f9;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .se-privacy-text {
    font-size: 1.0625rem;
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .se-privacy-link {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--se-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .se-privacy-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── CTA ─── */
  .se-cta {
    padding: 6rem 0;
    background: var(--se-accent-bg);
    position: relative;
    overflow: hidden;
  }

  .se-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  .se-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--se-text);
    margin-bottom: 1rem;
  }

  .se-cta-text {
    font-size: 1.125rem;
    color: var(--se-text-muted);
    margin-bottom: 2rem;
  }

  /* ─── Footer ─── */
  .se-footer {
    background: var(--se-bg);
    border-top: 1px solid var(--se-border);
    padding: 2rem 0;
  }

  .se-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .se-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .se-footer-inner { padding: 0 3rem; }
  }

  .se-footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .se-footer-links a {
    color: var(--se-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .se-footer-links a:hover {
    color: var(--se-accent);
  }

  .se-footer-dot {
    color: var(--se-text-muted);
    opacity: 0.4;
  }

  .se-footer-brand {
    font-size: 0.8125rem;
    color: var(--se-text-muted);
    opacity: 0.6;
  }

  .se-footer-brand a {
    color: var(--se-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .se-footer-brand a:hover {
    color: var(--se-accent);
  }
</style>
