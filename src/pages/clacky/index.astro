---
// Clacky's landing page. Like Pip's and Ebb's, everything between the studio
// header and footer is the app's own world: script paper by day, a warm
// near-black stage at night, with Clacky on the page. Try a rehearsal: pick a
// part and Clacky reads the other one, line by line.
import AppLayout from '../../layouts/AppLayout.astro';
import StoreButton from '../../components/app/StoreButton.astro';
import Clacky from '../../components/clacky/Clacky.astro';
import { appPageData } from '../../data/app-pages';

const page = appPageData['clacky'];

const scene = [
  ['MARCUS', 'She’s not getting off. She never gets off at Fairview.'],
  ['JUNE', 'You don’t know where I get off.'],
  ['MARCUS', 'I know you’ve ridden this bus past your stop four nights running.'],
  ['JUNE', 'Maybe I like the route.'],
  ['MARCUS', 'Nobody likes the route, June.'],
  ['JUNE', 'Then maybe I like the company.'],
];

const steps = [
  { n: '1', title: 'Sides in', text: 'Paste them, open the PDF from your email, or snap the pages. Clacky finds every character and line.', pose: 'read', tint: 'mine' },
  { n: '2', title: 'Pick your part', text: 'Your lines turn yellow. Clacky reads everyone else in a voice you choose, and waits for you.', pose: 'listen', tint: 'theirs' },
  { n: '3', title: 'Roll', text: 'A countdown, a clap, and your line right under the lens. Video and audio, or audio only.', pose: 'clap', tint: 'blush' },
  { n: '4', title: 'Watch, cut, send', text: 'Notes on each take, a quick cut with your slate, then MOV, MP4 or audio, named for casting.', pose: 'proud', tint: 'good' },
] as const;

const features = [
  { title: 'A reader for every part', text: 'Your iPhone’s own voices, a different one for each character, at your pace. Quieter than you, like a good off-camera reader.' },
  { title: 'Waits for your line', text: 'Clacky listens for you to finish before it reads, so your pauses stay yours.' },
  { title: 'Prompter by the lens', text: 'Your next line sits just under the camera and fills in as you speak. Shrink it to first words as you go off-book.' },
  { title: 'Sides from anywhere', text: 'Paste text, pick photos or screenshots, scan with the camera, open a PDF, or share straight from Mail.' },
  { title: 'Video or audio only', text: 'Tape on camera, front or back, portrait or landscape. Or switch the camera off for voiceover and audio drama reads.' },
  { title: 'Clacky’s notes', text: 'Line accuracy, eyeline, pickups and level after every take, plus what worked and one thing to try. All on your phone.' },
  { title: 'Quick cut', text: 'Your slate, the scene and a full-body shot, in order and trimmed. Start on the clap automatically.' },
  { title: 'Best of each take', text: 'Pick a take for each of your lines. Clacky joins them while the reader talks, so the cuts don’t show.' },
  { title: 'MOV, MP4, M4A, WAV', text: 'Export at 4K, 1080p or 720p, a smaller file for upload limits, and file names the way casting asks. Convert any video too.' },
  { title: 'Tape log', text: 'Every tape with its sides, takes and export. Mark sent, callback, booked or pass, and get a nudge to follow up.' },
  { title: 'Coach', text: 'A checklist before you roll, scene prep from your sides, and plain advice on framing, light, sound and eyeline.' },
  { title: 'Lock Screen and Watch', text: 'A deadline widget, a Live Activity while rolling, and an Apple Watch remote that taps your wrist before your line.' },
];

const confetti: [number, number, string, boolean][] = [
  [10, 0, '#1c1b22', true],
  [30, 0.8, '#ffffff', false],
  [52, 1.4, '#e5484d', true],
  [70, 0.3, '#1c1b22', false],
  [88, 1.9, '#ffffff', true],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Clacky - Self-Tape Partner',
  description: page.seo.description,
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'iOS',
  image: `https://idlefusion.com${page.icon}`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'Idle Fusion', url: 'https://idlefusion.com' },
};
---

<AppLayout
  title={page.seo.title}
  description={page.seo.description}
  app={page}
  kind="landing"
  ogImage={page.seo.ogImage}
  canonical={page.seo.canonical}
  sections={[
    { id: 'how', label: 'How it works' },
    { id: 'screenshots', label: 'Screenshots' },
    { id: 'features', label: 'Features' },
  ]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <main id="main" class="ck-stage">
    <!-- Hero: rehearse with Clacky, right here. -->
    <section class="ck-wrap ck-hero">
      <div>
        <p class="ck-label">Self-tapes for iPhone and Apple Watch</p>
        <h1>Your scene partner is ready when you are.</h1>
        <p class="ck-lede">
          Clacky is a little clapperboard who reads every part you’re not playing, holds your line up by the
          lens, claps you in, and tells you what landed. Paste your sides or snap a photo of them, and you’re
          rolling in a minute.
        </p>
        <div>
          <StoreButton store={page.store} platform="iOS" />
          <p class="ck-note">Free · No account · Your sides never leave your phone</p>
        </div>
      </div>

      <div class="ck-try">
        <div class="ck-rehearsal">
          <div class="ck-rehearsal-top">
            <span class="ck-rec"><span class="ck-dot" aria-hidden="true"></span>Rehearsing · The Last Bus</span>
            <span class="ck-mono">SC 1 · TK 1</span>
          </div>
          <ol class="ck-feed" aria-live="polite" data-feed></ol>
          <div class="ck-rehearsal-bottom">
            <Clacky id="ck-hero" pose="read" label="Clacky, reading Marcus" class="ck-hero-clacky" />
            <p class="ck-whisper" data-note>i got marcus.</p>
          </div>
        </div>
        <fieldset class="ck-picker">
          <legend>Pick your part, Clacky reads the other</legend>
          <div class="ck-picker-row">
            <button type="button" class="ck-role" data-role="JUNE" aria-pressed="true"><span class="ck-mono ck-role-name">JUNE</span><span class="ck-role-sub">You</span></button>
            <button type="button" class="ck-role" data-role="MARCUS" aria-pressed="false"><span class="ck-mono ck-role-name">MARCUS</span><span class="ck-role-sub">Clacky reads</span></button>
          </div>
        </fieldset>
      </div>
    </section>

    <!-- How it works -->
    <section class="ck-wrap" id="how" aria-labelledby="how-title">
      <p class="ck-label">How it works</p>
      <h2 id="how-title">From sides to sent in one sitting.</h2>
      <ol class="ck-steps">
        {
          steps.map((s) => (
            <li class:list={['ck-step', `ck-${s.tint}`]}>
              <div class="ck-step-top">
                <span class="ck-step-n">{s.n}</span>
                <Clacky pose={s.pose} class="ck-step-clacky" />
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Screenshots -->
    <section class="ck-wrap" id="screenshots" aria-labelledby="shots-title">
      <p class="ck-label">Screenshots</p>
      <h2 id="shots-title">No more begging your roommate.</h2>
      <div class="ck-shots">
        {
          page.screenshots.map((shot) => (
            <img src={shot.src} alt={shot.alt} width={shot.w} height={shot.h} loading="lazy" decoding="async" />
          ))
        }
      </div>
    </section>

    <!-- Features -->
    <section class="ck-wrap" id="features" aria-labelledby="features-title">
      <p class="ck-label">Features</p>
      <h2 id="features-title">Everything a self-tape needs. Nothing it doesn’t.</h2>
      <div class="ck-features">
        {
          features.map((f) => (
            <article class="ck-card">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
      <div class="ck-trio">
        <div class="ck-card ck-privacy" id="privacy">
          <h3>Sides are confidential. So is Clacky.</h3>
          <p>
            No account, no analytics, no ads. Scanning, voices, speech recognition and notes run on your iPhone,
            and Clacky never uploads your sides or your tapes.
          </p>
          <a href="/clacky/privacy/">Read the privacy policy <span aria-hidden="true">→</span></a>
        </div>
        <div class="ck-card">
          <h3>Works on what you have</h3>
          <p>Clacky’s written notes use Apple Intelligence where your iPhone supports it. Everywhere else you still get the line check, pickups, eyeline and level.</p>
        </div>
        <div class="ck-card ck-tip">
          <Clacky pose="wave" class="ck-tip-clacky" />
          <div>
            <h3>Free, with a tip jar</h3>
            <p>Everything is free. If Clacky helps, Settings has four optional one-time tips. They unlock nothing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Places, everyone -->
    <section class="ck-wrap" aria-labelledby="cta-title">
      <div class="ck-cta">
        <div class="ck-bulbs" aria-hidden="true">{Array.from({ length: 12 }, (_, i) => <span style={`animation-delay: ${(i % 3) * 0.5}s`} />)}</div>
        {
          confetti.map(([left, delay, color, stub]) => (
            <span class:list={['ck-confetti', { 'ck-stub': stub }]} aria-hidden="true" style={`left: ${left}%; background: ${color}; animation-delay: ${delay}s`} />
          ))
        }
        <Clacky pose="clap" class="ck-cta-clacky" />
        <h2 id="cta-title">{page.cta?.title}</h2>
        <p class="ck-lede ck-center">{page.cta?.text}</p>
        <StoreButton store={page.store} platform="iOS" />
      </div>
    </section>
  </main>
</AppLayout>

<style is:global>
  /* Script paper by day, the stage at night. The studio tokens are redefined
     here, so studio pieces inside (the store label) follow. */
  .ck-stage {
    --paper: #faf6ef;
    --ink: #1c1b22;
    --graphite: #4f4c58;
    --rule: #e6decf;
    --rule-strong: #8c8798;
    --app-a: #ffc94d;
    --ck-card: #ffffff;
    --ck-line: #e6decf;
    --ck-ink2: #4f4c58;
    --ck-accent: #7a5a00;
    --ck-mine: #fff0b8;
    --ck-theirs: #dce6ff;
    --ck-good: #e4f2e8;
    --ck-blush: #fbe3e1;
    position: relative;
    overflow: hidden;
    color: var(--ink);
    background-color: var(--paper);
    font-family: ui-rounded, 'SF Pro Rounded', var(--sans);
    padding-bottom: 96px;
  }
  @media (prefers-color-scheme: dark) {
    .ck-stage {
      --paper: #141318;
      --ink: #f3efe7;
      --graphite: #b5b1bf;
      --rule: #34323c;
      --ck-card: #222129;
      --ck-line: #34323c;
      --ck-ink2: #b5b1bf;
      --ck-accent: #ffc94d;
      --ck-mine: #4a4020;
      --ck-theirs: #283252;
      --ck-good: #22392a;
      --ck-blush: #45292a;
    }
  }
  .ck-wrap {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 72px 20px 0;
  }
  .ck-stage h1,
  .ck-stage h2,
  .ck-stage h3 {
    color: var(--ink);
  }
  .ck-stage h1,
  .ck-stage h2 {
    font-family: var(--sans);
    font-weight: 900;
    font-stretch: expanded;
    letter-spacing: -0.03em;
  }
  .ck-stage h1 {
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    line-height: 0.98;
    margin: 0 0 20px;
  }
  .ck-stage h2 {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    line-height: 1.04;
    margin: 0 0 16px;
  }
  .ck-label {
    margin: 0 0 12px;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ck-accent);
  }
  .ck-lede {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ck-ink2);
    max-width: 34rem;
    margin: 0 0 24px;
  }
  .ck-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }
  .ck-note {
    margin: 12px 0 0;
    font-size: 0.95rem;
    color: var(--ck-ink2);
  }
  .ck-mono {
    font-family: 'Courier New', ui-monospace, monospace;
    font-weight: 700;
  }

  /* Hero */
  .ck-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-top: 88px;
  }
  .ck-try {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ck-rehearsal {
    min-height: 440px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    border-radius: 36px;
    background: #1c1b22;
    color: #faf6ef;
  }
  .ck-rehearsal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ck-rehearsal-top .ck-mono {
    color: #ffc94d;
    letter-spacing: 0;
  }
  .ck-rec {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ck-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e5484d;
  }
  .ck-feed {
    list-style: none;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ck-line {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: 16px;
    font-family: 'Courier New', ui-monospace, monospace;
    font-size: 1rem;
    line-height: 1.35;
    background: #2d2b36;
    color: #dce6ff;
    opacity: 0.55;
  }
  .ck-line b {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .ck-line-you {
    align-self: flex-end;
    background: #ffc94d;
    color: #1c1b22;
  }
  .ck-line-now {
    opacity: 1;
  }
  .ck-rehearsal-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .ck-hero-clacky {
    width: 120px;
  }
  .ck-whisper {
    margin: 0 0 16px;
    font-family: 'Noteworthy', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 1.4rem;
    color: #ffc94d;
    text-align: right;
  }
  .ck-picker {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .ck-picker legend {
    padding: 0 4px 10px;
    font-weight: 700;
    color: var(--ink);
  }
  .ck-picker-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .ck-role {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 58px;
    border-radius: 18px;
    border: 2px solid var(--ck-line);
    background: var(--ck-card);
    color: var(--ink);
    font-family: ui-rounded, 'SF Pro Rounded', var(--sans);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .ck-role:active {
    transform: scale(0.96);
  }
  .ck-role:focus-visible {
    outline: 3px solid var(--ck-accent);
    outline-offset: 2px;
  }
  .ck-role[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ck-mine);
  }
  .ck-role-name {
    font-size: 1rem;
  }
  .ck-role-sub {
    font-size: 0.78rem;
    color: var(--ck-ink2);
  }

  /* How it works */
  .ck-steps {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .ck-step {
    padding: 20px 22px;
    border-radius: 26px;
  }
  .ck-step h3 {
    margin: 10px 0 6px;
    font-size: 1.15rem;
    font-weight: 900;
  }
  .ck-step p {
    margin: 0;
    line-height: 1.5;
    color: var(--ink);
  }
  .ck-step-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .ck-step-n {
    font-family: var(--sans);
    font-weight: 900;
    font-size: 2.6rem;
    line-height: 1;
  }
  .ck-step-clacky {
    width: 70px;
  }
  .ck-mine { background: var(--ck-mine); }
  .ck-theirs { background: var(--ck-theirs); }
  .ck-good { background: var(--ck-good); }
  .ck-blush { background: var(--ck-blush); }

  /* Screenshots */
  .ck-shots {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding: 8px 0 16px;
    scroll-snap-type: x mandatory;
  }
  .ck-shots img {
    flex: 0 0 auto;
    width: min(240px, 62vw);
    height: auto;
    border-radius: 22px;
    scroll-snap-align: start;
    box-shadow: 0 0 0 1px var(--ck-line);
  }

  /* Features */
  .ck-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 12px;
  }
  .ck-card {
    padding: 22px;
    border-radius: 22px;
    background: var(--ck-card);
    border: 1px solid var(--ck-line);
  }
  .ck-card h3 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    font-weight: 800;
  }
  .ck-card p {
    margin: 0;
    color: var(--ck-ink2);
    line-height: 1.5;
  }
  .ck-trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }
  .ck-privacy {
    background: #1c1b22;
    border-color: transparent;
  }
  .ck-privacy h3 {
    color: #faf6ef;
  }
  .ck-privacy p {
    color: #e2dfea;
  }
  .ck-privacy a {
    display: inline-block;
    margin-top: 12px;
    color: #ffc94d;
    font-weight: 700;
  }
  .ck-tip {
    display: flex;
    gap: 14px;
    align-items: center;
    background: var(--ck-mine);
    border-color: transparent;
  }
  .ck-tip p {
    color: var(--ink);
  }
  .ck-tip-clacky {
    flex-shrink: 0;
    width: 76px;
  }

  /* Places, everyone */
  .ck-cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 64px 24px 56px;
    border-radius: 40px;
    background: #ffc94d;
  }
  .ck-cta h2 {
    color: #1c1b22;
  }
  .ck-cta .ck-lede {
    color: #4a3b12;
  }
  .ck-cta .store-soon {
    position: relative;
    color: #1c1b22;
    border-color: rgba(28, 27, 34, 0.45);
  }
  .ck-bulbs {
    position: absolute;
    top: 18px;
    left: 24px;
    right: 24px;
    display: flex;
    justify-content: space-between;
  }
  .ck-bulbs span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff7dc;
    box-shadow: 0 0 0 2.5px #1c1b22;
  }
  .ck-cta-clacky {
    position: relative;
    width: 200px;
    margin-bottom: 8px;
  }
  .ck-confetti {
    position: absolute;
    bottom: -24px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0;
  }
  .ck-stub {
    width: 16px;
    height: 7px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ck-dot {
      animation: ck-rec 1.2s ease-in-out infinite;
    }
    .ck-bulbs span {
      animation: ck-bulb 1.5s steps(1) infinite;
    }
    .ck-confetti {
      animation: ck-rise 3.4s ease-out infinite;
    }
    .ck-line-now {
      animation: ck-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }
  @keyframes ck-rec {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  @keyframes ck-bulb {
    0% { opacity: 1; }
    33% { opacity: 0.35; }
    66% { opacity: 0.7; }
  }
  @keyframes ck-rise {
    0% { transform: translateY(40px) rotate(0); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: translateY(-460px) rotate(240deg); opacity: 0; }
  }
  @keyframes ck-in {
    from { opacity: 0; transform: translateY(16px); }
  }

  @media (max-width: 900px) {
    .ck-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .ck-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-top: 40px;
    }
    .ck-features,
    .ck-trio {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .ck-rehearsal {
      min-height: 420px;
      border-radius: 28px;
      padding: 18px;
    }
    .ck-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script define:vars={{ scene }}>
  // Rehearse: a line every 2.2 seconds. Clacky reads the part you're not
  // playing (glasses on) and listens during yours. Rests while off screen.
  const feed = document.querySelector('[data-feed]');
  const clacky = document.getElementById('ck-hero');
  const note = document.querySelector('[data-note]');
  const roles = [...document.querySelectorAll('.ck-role')];
  let me = 'JUNE';
  let step = 0;
  let visible = true;

  function render() {
    if (!feed) return;
    const k = step % scene.length;
    feed.replaceChildren();
    for (let i = Math.max(0, k - 3); i <= k; i++) {
      const [who, text] = scene[i];
      const you = who === me;
      const li = document.createElement('li');
      li.className = 'ck-line' + (you ? ' ck-line-you' : '') + (i === k ? ' ck-line-now' : '');
      const b = document.createElement('b');
      b.textContent = who + (you ? ' · YOU' : ' · CLACKY');
      li.append(b, document.createTextNode(text));
      feed.append(li);
    }
    const [who] = scene[k];
    const yours = who === me;
    if (clacky) {
      clacky.dataset.pose = yours ? 'listen' : 'read';
      clacky.setAttribute('aria-label', yours ? 'Clacky, listening for your line' : `Clacky, reading ${who.toLowerCase()}`);
    }
    if (note) note.textContent = yours ? 'your line. take your time.' : `i got ${who.toLowerCase()}.`;
  }

  setInterval(() => {
    if (!visible) return;
    step += 1;
    render();
  }, 2200);

  for (const button of roles) {
    button.addEventListener('click', () => {
      me = button.dataset.role;
      for (const other of roles) {
        const on = other === button;
        other.setAttribute('aria-pressed', String(on));
        const sub = other.querySelector('.ck-role-sub');
        if (sub) sub.textContent = on ? 'You' : 'Clacky reads';
      }
      step = 0;
      render();
    });
  }
  if (feed && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(feed);
  }
  render();
</script>
