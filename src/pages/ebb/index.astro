<script>
  // Breathe with Ebb: pick what you need, and the tide rises and Ebb puffs up
  // as you breathe in, both hold through a hold, and both let it all go as you
  // breathe out, with the phase and a countdown on top. With Reduce Motion the
  // water and Ebb hold still while the words and his face keep time. Pause
  // stops it all; it also rests while the tank is off screen.
  type Kind = 'in' | 'hold' | 'out' | 'rest';
  const words: Record<Kind, string> = { in: 'Breathe in', hold: 'Hold', out: 'Breathe out', rest: 'Hold' };
  const whispers: Record<Kind, string> = { in: 'I puff up…', hold: 'round and still', out: 'and let it all go', rest: 'ahh' };
  const poses: Record<Kind, string> = { in: 'inhale', hold: 'hold', out: 'exhale', rest: 'rest' };
  const spoken: Record<Kind, string> = {
    in: 'Ebb, puffing up as he breathes in',
    hold: 'Ebb, round and still, holding his breath',
    out: 'Ebb, letting it all go as he breathes out',
    rest: 'Ebb, resting before the next breath',
  };

  const tank = document.querySelector<HTMLElement>('[data-tank]');
  const ebb = document.getElementById('ebb-hero');
  const phaseText = document.querySelector<HTMLElement>('[data-phase]');
  const whisperText = document.querySelector<HTMLElement>('[data-whisper]');
  const countText = document.querySelector<HTMLElement>('[data-count]');
  const rhythmText = document.querySelector<HTMLElement>('[data-rhythm]');
  const pauseButton = document.querySelector<HTMLButtonElement>('[data-pause]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.ebb-demo')];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  let phases: [Kind, number][] = JSON.parse(buttons[0]?.dataset.phases ?? '[["in",5],["out",5]]');
  let elapsed = 0;
  let last: number | null = null;
  let paused = false;
  let visible = true;
  let shown = '';

  function render() {
    const cycle = phases.reduce((sum, [, s]) => sum + s, 0);
    let t = elapsed % cycle;
    let [kind, seconds] = phases[0];
    for (const [k, s] of phases) {
      if (t < s) {
        kind = k;
        seconds = s;
        break;
      }
      t -= s;
    }
    const ease = (1 - Math.cos(Math.PI * (t / seconds))) / 2;
    const full = kind === 'in' ? ease : kind === 'hold' ? 1 : kind === 'out' ? 1 - ease : 0;
    const level = still.matches ? 0.5 : full;
    tank?.style.setProperty('--ebb-full', level.toFixed(3));
    ebb?.style.setProperty('--ebb-puff', level.toFixed(3));

    const count = String(Math.max(1, Math.ceil(seconds - t)));
    const key = `${kind}${count}`;
    if (key === shown) return;
    shown = key;
    if (countText) countText.textContent = count;
    if (ebb && ebb.dataset.pose !== poses[kind]) {
      ebb.dataset.pose = poses[kind];
      ebb.setAttribute('aria-label', spoken[kind]);
      if (phaseText) phaseText.textContent = words[kind];
      if (whisperText) whisperText.textContent = whispers[kind];
    }
  }

  function frame(now: number) {
    if (last !== null) elapsed += Math.min(now - last, 100) / 1000;
    last = now;
    render();
    if (!paused && visible) requestAnimationFrame(frame);
    else last = null;
  }
  function start() {
    if (!paused && visible && last === null) requestAnimationFrame(frame);
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      phases = JSON.parse(button.dataset.phases ?? '[]');
      elapsed = 0;
      shown = '';
      if (rhythmText) rhythmText.textContent = button.dataset.rhythm ?? '';
      if (ebb) ebb.dataset.pose = '';
      render();
      start();
    });
  }
  pauseButton?.addEventListener('click', () => {
    paused = !paused;
    pauseButton.textContent = paused ? 'Play' : 'Pause';
    start();
  });
  if (tank && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(tank);
  }
  render();
  start();
</script>
