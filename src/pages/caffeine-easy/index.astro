---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ExploreApps from '../../components/ExploreApps.astro';
---

<BaseLayout
  title="Caffeine Easy — Track When Caffeine Clears"
  description="Know exactly when caffeine leaves your system. Half-life decay visualization, quick-log presets, clear-by time, and HealthKit sync. No accounts, no subscriptions."
  ogImage="/img/caffeine-easy/icon.png"
  ogUrl="https://idlefusion.com/caffeine-easy"
>

  <!-- App Nav -->
  <nav class="ce-nav">
    <div class="ce-nav-inner">
      <a href="/caffeine-easy" class="ce-logo">Caffeine Easy</a>
      <div class="ce-nav-actions">
        <ThemeToggle />
        <a href="https://apps.apple.com/app/id0000000000" class="ce-nav-cta" target="_blank" rel="noopener noreferrer">
          <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="40" />
        </a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero — Warm coffee tones -->
    <section class="ce-hero">
      <div class="ce-hero-glow ce-hero-glow--warm"></div>
      <div class="ce-hero-glow ce-hero-glow--cream"></div>
      <div class="ce-hero-inner">
        <div class="ce-hero-content">
          <div class="ce-hero-text">
            <div class="ce-hero-badge">CAFFEINE TRACKER</div>
            <h1 class="ce-hero-title">
              Know when your<br/>caffeine <em>clears.</em>
            </h1>
            <p class="ce-hero-subtitle">
              Track your caffeine intake and see exactly when it leaves your system. Half-life science meets simple design.
            </p>
            <div class="ce-hero-actions">
              <a href="https://apps.apple.com/app/id0000000000" class="ce-store-badge" target="_blank" rel="noopener noreferrer">
                <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
              </a>
              <span class="ce-hero-note">Free &middot; No account required</span>
            </div>
          </div>
          <div class="ce-hero-icon-wrap">
            <div class="ce-hero-icon-placeholder">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/><line x1="14" x2="14" y1="2" y2="4"/></svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="ce-screenshots-section">
      <div class="ce-container">
        <div class="ce-section-header">
          <span class="ce-label">SCREENSHOTS</span>
          <h2 class="ce-screenshots-title">See it in action.</h2>
        </div>
        <div class="ce-screenshots-scroll">
          <div class="ce-screenshot-card">
            <img src="/img/caffeine-easy/screenshots/01_marketing.png" alt="Caffeine Easy — Know Your Caffeine" loading="lazy" />
            <span class="ce-screenshot-label">Know Your Caffeine</span>
          </div>
          <div class="ce-screenshot-card">
            <img src="/img/caffeine-easy/screenshots/02_marketing.png" alt="Caffeine Easy — See the Decay Curve" loading="lazy" />
            <span class="ce-screenshot-label">See the Decay Curve</span>
          </div>
          <div class="ce-screenshot-card">
            <img src="/img/caffeine-easy/screenshots/03_marketing.png" alt="Caffeine Easy — Log Any Drink" loading="lazy" />
            <span class="ce-screenshot-label">Log Any Drink</span>
          </div>
          <div class="ce-screenshot-card">
            <img src="/img/caffeine-easy/screenshots/04_marketing.png" alt="Caffeine Easy — Sleep Better" loading="lazy" />
            <span class="ce-screenshot-label">Sleep Better</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="ce-features-section">
      <div class="ce-container-wide">
        <div class="ce-features-header">
          <span class="ce-label-dark">FEATURES</span>
          <h2 class="ce-features-title">Caffeine, understood.</h2>
        </div>

        <div class="ce-features">
          <div class="ce-feature">
            <div class="ce-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l3-9 6 18 3-9h4"/></svg>
            </div>
            <h3>Half-Life Decay Visualization</h3>
            <p>Watch your caffeine levels decay in real-time. Our beautiful chart shows exactly how much caffeine is in your system right now and when it will be gone.</p>
          </div>

          <div class="ce-feature">
            <div class="ce-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h3>Quick-Log Presets</h3>
            <p>Log your caffeine in seconds. Tap preset buttons for espresso, coffee, tea, energy drinks, and more. Custom amounts when you need them.</p>
          </div>

          <div class="ce-feature">
            <div class="ce-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Clear-By Time</h3>
            <p>The "Clear By" time tells you when caffeine will drop below 20mg — effectively out of your system. Perfect for planning your last coffee before bed.</p>
          </div>

          <div class="ce-feature">
            <div class="ce-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <h3>HealthKit Sync</h3>
            <p>Automatically sync your caffeine intake to Apple Health. Track alongside your sleep and other health data to see the full picture.</p>
          </div>

          <div class="ce-feature">
            <div class="ce-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            </div>
            <h3>Widgets</h3>
            <p>Home Screen and Lock Screen widgets show current caffeine level and clear-by time at a glance. Always know where you stand.</p>
          </div>

          <div class="ce-feature">
            <div class="ce-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h3>Completely Offline</h3>
            <p>No servers, no cloud sync, no network requests. Your caffeine data stays on your device. Period.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Science section -->
    <section class="ce-science">
      <div class="ce-container">
        <div class="ce-science-inner">
          <span class="ce-label-dark">THE SCIENCE</span>
          <h2 class="ce-science-title">5.7 hours.</h2>
          <p class="ce-science-text">
            That's the average half-life of caffeine. Every 5.7 hours, half the caffeine in your system is metabolized away.<br/><br/>
            We use this to calculate exactly how much caffeine remains in your system at any moment — so you can make smarter decisions about when to drink (and when to stop).
          </p>
        </div>
      </div>
    </section>

    <!-- Privacy Banner -->
    <section class="ce-privacy-banner">
      <div class="ce-container">
        <div class="ce-privacy-inner">
          <span class="ce-label-dark">PRIVACY</span>
          <h2 class="ce-privacy-title">Zero data collection.</h2>
          <p class="ce-privacy-text">
            No analytics. No ads. No tracking pixels. No telemetry.<br/>
            Caffeine Easy doesn't even make network requests. Your data lives on your device and nowhere else.
          </p>
          <a href="/caffeine-easy/privacy" class="ce-privacy-link">Read the full privacy policy &rarr;</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ce-cta">
      <div class="ce-container">
        <div class="ce-cta-inner">
          <h2 class="ce-cta-title">Track your caffeine.</h2>
          <p class="ce-cta-text">Free on the App Store. No account required.</p>
          <a href="https://apps.apple.com/app/id0000000000" class="ce-store-badge" target="_blank" rel="noopener noreferrer">
            <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" height="54" />
          </a>
        </div>
      </div>
    </section>
    <ExploreApps current="caffeine-easy" />
  </main>

  <!-- App Footer -->
  <footer class="ce-footer">
    <div class="ce-footer-inner">
      <div class="ce-footer-links">
        <a href="/caffeine-easy/support">Support</a>
        <span class="ce-footer-dot">&middot;</span>
        <a href="/caffeine-easy/privacy">Privacy Policy</a>
      </div>
      <div class="ce-footer-brand">
        An <a href="/">Idle Fusion</a> app
      </div>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════
     CAFFEINE EASY — Warm coffee/amber theme
     ═══════════════════════════════════════════════════════ */

  :global(:root) {
    --ce-accent: #b45309;
    --ce-accent-deep: #92400e;
    --ce-accent-light: #d97706;
    --ce-accent-bg: #fef3c7;
    --ce-warm: #78350f;
    --ce-bg: #f8fafc;
    --ce-surface: #ffffff;
    --ce-border: rgba(148, 163, 184, 0.15);
    --ce-text: #0f172a;
    --ce-text-muted: #64748b;
    --ce-feature-icon-bg: rgba(180, 83, 9, 0.08);
    --ce-feature-icon-border: rgba(180, 83, 9, 0.12);
  }

  :global(.dark) {
    --ce-accent: #fbbf24;
    --ce-accent-deep: #f59e0b;
    --ce-accent-light: #fcd34d;
    --ce-accent-bg: #451a03;
    --ce-bg: #0a0f1a;
    --ce-surface: #111827;
    --ce-border: rgba(148, 163, 184, 0.08);
    --ce-text: #f1f5f9;
    --ce-text-muted: #94a3b8;
    --ce-feature-icon-bg: rgba(251, 191, 36, 0.1);
    --ce-feature-icon-border: rgba(251, 191, 36, 0.15);
  }

  /* ─── Nav ─── */
  .ce-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ce-bg);
    border-bottom: 1px solid var(--ce-border);
    backdrop-filter: blur(12px);
  }

  .ce-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
  }

  @media (min-width: 640px) {
    .ce-nav-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .ce-nav-inner { padding: 0 3rem; }
  }

  .ce-logo {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ce-accent-deep);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .ce-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ce-nav-cta img {
    height: 32px;
    transition: opacity 0.2s;
  }

  .ce-nav-cta:hover img {
    opacity: 0.7;
  }

  /* ─── Hero — Dark, warm coffee tones ─── */
  .ce-hero {
    background: #1c1008;
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .ce-hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.15;
  }

  .ce-hero-glow--warm {
    top: -30%;
    left: -10%;
    background: #b45309;
  }

  .ce-hero-glow--cream {
    bottom: -40%;
    right: -10%;
    background: #fbbf24;
  }

  .ce-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .ce-hero-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .ce-hero-inner { padding: 0 3rem; }
  }

  .ce-hero-content {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .ce-hero-content {
      flex-direction: row;
      text-align: left;
      gap: 4rem;
    }
  }

  .ce-hero-text { flex: 1; }

  .ce-hero-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: #fbbf24;
    margin-bottom: 1.5rem;
  }

  .ce-hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: #fef3c7;
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .ce-hero-title em {
    font-style: italic;
    color: #fbbf24;
  }

  .ce-hero-subtitle {
    font-size: 1.125rem;
    color: #d6d3d1;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  @media (max-width: 767px) {
    .ce-hero-subtitle { margin-left: auto; margin-right: auto; }
  }

  .ce-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .ce-hero-actions { align-items: flex-start; }
  }

  .ce-store-badge {
    display: inline-block;
  }

  .ce-store-badge img {
    height: 54px;
    transition: opacity 0.2s;
  }

  .ce-store-badge:hover img { opacity: 0.8; }

  .ce-hero-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #a8a29e;
  }

  .ce-hero-icon-wrap { flex-shrink: 0; }

  .ce-hero-icon-placeholder {
    width: 180px;
    height: 180px;
    border-radius: 40px;
    background: linear-gradient(135deg, #78350f 0%, #b45309 50%, #d97706 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fef3c7;
    box-shadow: 0 20px 60px rgba(180, 83, 9, 0.3), 0 0 80px rgba(251, 191, 36, 0.1);
  }

  @media (min-width: 768px) {
    .ce-hero-icon-placeholder {
      width: 240px;
      height: 240px;
      border-radius: 54px;
    }
    .ce-hero-icon-placeholder svg {
      width: 100px;
      height: 100px;
    }
  }

  /* ─── Screenshots ─── */
  .ce-screenshot {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  /* ─── Containers ─── */
  .ce-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .ce-container-wide {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .ce-container { padding: 0 2rem; }
    .ce-container-wide { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .ce-container { padding: 0 3rem; }
    .ce-container-wide { padding: 0 3rem; }
  }

  /* ─── Features ─── */
  .ce-features-section {
    background: var(--ce-surface);
    padding: 5rem 0;
  }

  .ce-features-header {
    margin-bottom: 3.5rem;
    max-width: 520px;
  }

  .ce-label-dark {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--ce-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .ce-features-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    color: var(--ce-text);
    margin-bottom: 1rem;
  }

  .ce-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ce-border);
    border: 1px solid var(--ce-border);
    border-radius: 16px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .ce-features { grid-template-columns: 1fr 1fr; }
  }

  .ce-feature {
    padding: 2rem;
    background: var(--ce-surface);
  }

  .ce-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ce-feature-icon-bg);
    border: 1px solid var(--ce-feature-icon-border);
    border-radius: 10px;
    color: var(--ce-accent-deep);
    margin-bottom: 1.25rem;
  }

  :global(.dark) .ce-feature-icon {
    color: var(--ce-accent);
  }

  .ce-feature h3 {
    font-family: 'Satoshi', sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--ce-text);
    margin-bottom: 0.625rem;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .ce-feature p {
    color: var(--ce-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* ─── Science Section ─── */
  .ce-science {
    background: var(--ce-bg);
    padding: 5rem 0;
    border-top: 1px solid var(--ce-border);
    border-bottom: 1px solid var(--ce-border);
  }

  .ce-science-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .ce-science-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--ce-accent-deep);
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  :global(.dark) .ce-science-title {
    color: var(--ce-accent);
  }

  .ce-science-text {
    font-size: 1.0625rem;
    color: var(--ce-text-muted);
    line-height: 1.8;
  }

  /* ─── Privacy Banner ─── */
  .ce-privacy-banner {
    background: #1c1008;
    padding: 5rem 0;
  }

  .ce-privacy-inner {
    text-align: center;
  }

  .ce-privacy-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #fef3c7;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .ce-privacy-text {
    font-size: 1.0625rem;
    color: #d6d3d1;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .ce-privacy-link {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #fbbf24;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .ce-privacy-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── CTA ─── */
  .ce-cta {
    padding: 6rem 0;
    background: var(--ce-accent-bg);
    position: relative;
    overflow: hidden;
  }

  .ce-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  .ce-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--ce-text);
    margin-bottom: 1rem;
  }

  .ce-cta-text {
    font-size: 1.125rem;
    color: var(--ce-text-muted);
    margin-bottom: 2rem;
  }

  /* ─── Footer ─── */
  .ce-footer {
    background: var(--ce-bg);
    border-top: 1px solid var(--ce-border);
    padding: 2rem 0;
  }

  .ce-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .ce-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .ce-footer-inner { padding: 0 3rem; }
  }

  .ce-footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .ce-footer-links a {
    color: var(--ce-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .ce-footer-links a:hover {
    color: var(--ce-accent);
  }

  .ce-footer-dot {
    color: var(--ce-text-muted);
    opacity: 0.4;
  }

  .ce-footer-brand {
    font-size: 0.8125rem;
    color: var(--ce-text-muted);
    opacity: 0.6;
  }

  .ce-footer-brand a {
    color: var(--ce-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .ce-footer-brand a:hover {
    color: var(--ce-accent);
  }

  /* ─── Screenshots (run-easy style) ─── */
  .ce-screenshots-section {
    padding: 4rem 0;
    background: var(--ce-bg, #fafaf9);
  }

  .ce-section-header {
    margin-bottom: 2rem;
  }

  .ce-screenshots-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--ce-text, #0a0a0a);
    margin-top: 0.5rem;
  }

  .ce-screenshots-scroll {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .ce-screenshots-scroll::-webkit-scrollbar { height: 4px; }
  .ce-screenshots-scroll::-webkit-scrollbar-track { background: transparent; }
