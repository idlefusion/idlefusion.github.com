---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Marta Easy - Privacy Policy"
  description="Privacy policy for Marta Easy"
  ogUrl="https://idlefusion.com/marta-easy/privacy"
>
  <main>
    <section class="section-padding">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-2">Privacy Policy</h1>
        <p class="text-sm text-[var(--text-secondary)] mb-12">Marta Easy - Atlanta Transit Companion &middot; Effective February 23, 2026</p>

        <div class="space-y-8 text-[var(--text-secondary)] leading-relaxed">
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">What data is collected?</h2>
            <p>Marta Easy keeps transit stop preferences and app preferences on your device. No user account is required.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Data transmission</h2>
            <p>Commuter data is local. Network requests are limited to public MARTA feed lookups used to retrieve train timing and service updates.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Advertising and analytics</h2>
            <p>There are no ads and no analytics SDKs included in Marta Easy.</p>
          </div>
          <div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">Contact</h2>
            <p>Questions about privacy? Email <a href="mailto:support@idlefusion.com?subject=Marta%20Easy%20Privacy" class="text-[var(--accent-primary)] hover:underline">support@idlefusion.com</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
