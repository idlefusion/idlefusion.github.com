---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ExploreApps from '../../components/ExploreApps.astro';
---

<BaseLayout
  title="Meds Easy — Medication Reminder for iOS"
  description="Never miss a dose. A simple, private medication tracker with smart reminders, refill tracking, and adherence stats. No cloud, no account required."
  ogImage="/img/meds-easy/icon.png"
  ogUrl="https://idlefusion.com/meds-easy"
>

  <!-- App Nav — sits on light mint background -->
  <nav class="me-nav">
    <div class="me-nav-inner">
      <a href="/meds-easy" class="me-logo">Meds Easy</a>
      <div class="me-nav-actions">
        <ThemeToggle />
        <a href="https://apps.apple.com/app/id6759265440" class="me-nav-cta">
          <span class="me-coming-soon">Coming Soon</span>
        </a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero — Fresh mint gradient, pill themed -->
    <section class="me-hero">
      <div class="me-hero-glow me-hero-glow--primary"></div>
      <div class="me-hero-glow me-hero-glow--secondary"></div>
      <div class="me-hero-inner">
        <div class="me-hero-content">
          <div class="me-hero-text">
            <div class="me-hero-badge">MEDICATION REMINDERS</div>
            <h1 class="me-hero-title">
              Never miss<br/><em>a dose.</em>
            </h1>
            <p class="me-hero-subtitle">
              A simple, private medication tracker that helps you stay on schedule. Smart reminders, refill alerts, and adherence insights — all on your device.
            </p>
            <div class="me-hero-actions">
              <span class="me-coming-soon-badge">Coming Soon to the App Store</span>
              <span class="me-hero-note">Free &middot; No account required</span>
            </div>
          </div>
          <div class="me-hero-icon-wrap">
            <img src="/img/meds-easy/icon.png" alt="Meds Easy app icon" class="me-hero-icon" width="240" height="240" />
          </div>
        </div>
      </div>
    </section>

    <section class="me-screenshots-section">
      <div class="me-container">
        <div class="me-section-header">
          <span class="me-label">SCREENSHOTS</span>
          <h2 class="me-screenshots-title">See it in action.</h2>
        </div>
        <div class="me-screenshots-scroll">
          <div class="me-screenshot-card">
            <img src="/img/meds-easy/screenshots/01_marketing.png" alt="Meds Easy — Never Miss a Dose" loading="lazy" />
            <span class="me-screenshot-label">Never Miss a Dose</span>
          </div>
          <div class="me-screenshot-card">
            <img src="/img/meds-easy/screenshots/02_marketing.png" alt="Meds Easy — Smart Reminders" loading="lazy" />
            <span class="me-screenshot-label">Smart Reminders</span>
          </div>
          <div class="me-screenshot-card">
            <img src="/img/meds-easy/screenshots/03_marketing.png" alt="Meds Easy — Refill Alerts" loading="lazy" />
            <span class="me-screenshot-label">Refill Alerts</span>
          </div>
          <div class="me-screenshot-card">
            <img src="/img/meds-easy/screenshots/04_marketing.png" alt="Meds Easy — Dose History" loading="lazy" />
            <span class="me-screenshot-label">Dose History</span>
          </div>
          <div class="me-screenshot-card">
            <img src="/img/meds-easy/screenshots/07_widget.png" alt="Meds Easy — Home Screen Widget" loading="lazy" />
            <span class="me-screenshot-label">Widget</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features — 2-col grid with icons -->
    <section class="me-features-section">
      <div class="me-container-wide">
        <div class="me-features-header">
          <span class="me-label">FEATURES</span>
          <h2 class="me-features-title">Everything you need to stay on track.</h2>
        </div>

        <div class="me-features">
          <div class="me-feature">
            <div class="me-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Medication Schedules</h3>
            <p>Set up complex schedules with ease. Daily, weekly, every other day, or custom intervals — the app adapts to your prescriptions.</p>
          </div>

          <div class="me-feature">
            <div class="me-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            </div>
            <h3>Smart Reminders</h3>
            <p>Timely notifications that actually help. Snooze if you need a few minutes, or mark as taken right from the notification.</p>
          </div>

          <div class="me-feature">
            <div class="me-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
            </div>
            <h3>Refill Tracking</h3>
            <p>Know when you're running low. Track your supply and get alerts before you run out so you never scramble for refills.</p>
          </div>

          <div class="me-feature">
            <div class="me-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
            </div>
            <h3>Adherence Stats</h3>
            <p>See your medication history at a glance. Track your consistency over time and celebrate your streaks.</p>
          </div>

          <div class="me-feature">
            <div class="me-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
            </div>
            <h3>Completely Private</h3>
            <p>Your medication data stays on your device. No accounts, no cloud sync, no data collection. Your health information is yours alone.</p>
          </div>

          <div class="me-feature">
            <div class="me-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
            </div>
            <h3>Apple Watch</h3>
            <p>Log doses from your wrist. Quick, convenient, and always with you when it's time to take your medication.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy — Full-width banner -->
    <section class="me-privacy-banner">
      <div class="me-container">
        <div class="me-privacy-inner">
          <span class="me-label-dark">PRIVACY</span>
          <h2 class="me-privacy-title">Your meds. Your data.</h2>
          <p class="me-privacy-text">
            Medication data is deeply personal. That's why Meds Easy stores everything locally on your device.<br/>
            No HealthKit. No cloud. No analytics. No exceptions.
          </p>
          <a href="/meds-easy/privacy" class="me-privacy-link">Read the full privacy policy &rarr;</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="me-cta">
      <div class="me-container">
        <div class="me-cta-inner">
          <h2 class="me-cta-title">Stay on schedule.</h2>
          <p class="me-cta-text">Coming soon to the App Store. No account required.</p>
          <span class="me-coming-soon-badge me-coming-soon-badge--large">Coming Soon</span>
        </div>
      </div>
    </section>
    <ExploreApps current="meds-easy" />
  </main>

  <!-- App Footer -->
  <footer class="me-footer">
    <div class="me-footer-inner">
      <div class="me-footer-links">
        <a href="/meds-easy/support">Support</a>
        <span class="me-footer-dot">&middot;</span>
        <a href="/meds-easy/privacy">Privacy Policy</a>
      </div>
      <div class="me-footer-brand">
        An <a href="/">Idle Fusion</a> app
      </div>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════════════
     MEDS EASY — Mint / Teal, Fresh Health Theme
     Clean, trustworthy, medical-adjacent
     ═══════════════════════════════════════════════════════ */

  :global(:root) {
    --me-accent: #4ECDC4;
    --me-accent-deep: #26A69A;
    --me-accent-bg: #E0F7F4;
    --me-secondary: #88D8B0;
    --me-bg: #f8fafc;
    --me-surface: #ffffff;
    --me-border: rgba(148, 163, 184, 0.15);
    --me-text: #0f172a;
    --me-text-muted: #64748b;
    --me-feature-icon-bg: rgba(78, 205, 196, 0.08);
    --me-feature-icon-border: rgba(78, 205, 196, 0.12);
  }

  :global(.dark) {
    --me-accent: #4ECDC4;
    --me-accent-deep: #88D8B0;
    --me-accent-bg: #0d3d38;
    --me-bg: #0a0f1a;
    --me-surface: #111827;
    --me-border: rgba(148, 163, 184, 0.08);
    --me-text: #f1f5f9;
    --me-text-muted: #94a3b8;
    --me-feature-icon-bg: rgba(78, 205, 196, 0.1);
    --me-feature-icon-border: rgba(78, 205, 196, 0.15);
  }

  /* ─── Nav ─── */
  .me-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--me-bg);
    border-bottom: 1px solid var(--me-border);
    backdrop-filter: blur(12px);
  }

  .me-nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
  }

  @media (min-width: 640px) {
    .me-nav-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .me-nav-inner { padding: 0 3rem; }
  }

  .me-logo {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--me-accent-deep);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .me-nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .me-nav-cta .me-coming-soon {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--me-text-muted);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--me-border);
    border-radius: 6px;
  }

  /* ─── Hero ─── */
  .me-hero {
    background: linear-gradient(135deg, var(--me-accent-bg) 0%, var(--me-bg) 100%);
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }

  .me-hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.15;
  }

  .me-hero-glow--primary {
    top: -30%;
    left: -10%;
    background: var(--me-accent);
  }

  .me-hero-glow--secondary {
    bottom: -40%;
    right: -10%;
    background: var(--me-secondary);
  }

  .me-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    .me-hero-inner { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .me-hero-inner { padding: 0 3rem; }
  }

  .me-hero-content {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .me-hero-content {
      flex-direction: row;
      text-align: left;
      gap: 4rem;
    }
  }

  .me-hero-text { flex: 1; }

  .me-hero-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--me-accent-deep);
    margin-bottom: 1.5rem;
  }

  .me-hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--me-text);
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .me-hero-title em {
    font-style: italic;
    color: var(--me-accent-deep);
  }

  .me-hero-subtitle {
    font-size: 1.125rem;
    color: var(--me-text-muted);
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  @media (max-width: 767px) {
    .me-hero-subtitle { margin-left: auto; margin-right: auto; }
  }

  .me-hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .me-hero-actions { align-items: flex-start; }
  }

  .me-coming-soon-badge {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--me-accent-deep);
    padding: 0.75rem 1.5rem;
    background: var(--me-surface);
    border: 2px solid var(--me-accent);
    border-radius: 10px;
    display: inline-block;
  }

  .me-coming-soon-badge--large {
    font-size: 1rem;
    padding: 1rem 2rem;
  }

  .me-hero-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--me-text-muted);
  }

  .me-hero-icon-wrap { flex-shrink: 0; }

  .me-hero-icon {
    width: 180px;
    height: 180px;
    border-radius: 40px;
    box-shadow: 0 20px 60px rgba(78, 205, 196, 0.25), 0 0 80px rgba(78, 205, 196, 0.1);
  }

  @media (min-width: 768px) {
    .me-hero-icon {
      width: 240px;
      height: 240px;
      border-radius: 54px;
    }
  }

  /* ─── Screenshots ─── */
  .me-screenshot {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  /* ─── Containers ─── */
  .me-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .me-container-wide {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 640px) {
    .me-container { padding: 0 2rem; }
    .me-container-wide { padding: 0 2rem; }
  }

  @media (min-width: 1024px) {
    .me-container { padding: 0 3rem; }
    .me-container-wide { padding: 0 3rem; }
  }

  /* ─── Features ─── */
  .me-features-section {
    background: var(--me-surface);
    padding: 5rem 0;
  }

  .me-features-header {
    margin-bottom: 3.5rem;
    max-width: 520px;
  }

  .me-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--me-accent-deep);
    display: block;
    margin-bottom: 1rem;
  }

  .me-label-dark {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--me-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .me-features-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    color: var(--me-text);
    margin-bottom: 1rem;
  }

  .me-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--me-border);
    border: 1px solid var(--me-border);
    border-radius: 16px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .me-features { grid-template-columns: 1fr 1fr; }
  }

  .me-feature {
    padding: 2rem;
    background: var(--me-surface);
  }

  .me-feature-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--me-feature-icon-bg);
    border: 1px solid var(--me-feature-icon-border);
    border-radius: 10px;
    color: var(--me-accent-deep);
    margin-bottom: 1.25rem;
  }

  .me-feature h3 {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--me-text);
    margin-bottom: 0.625rem;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .me-feature p {
    color: var(--me-text-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* ─── Privacy Banner ─── */
  .me-privacy-banner {
    background: #0a0f1a;
    padding: 5rem 0;
    border-top: 1px solid rgba(148, 163, 184, 0.08);
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  }

  .me-privacy-inner {
    text-align: center;
  }

  .me-privacy-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #f1f5f9;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .me-privacy-text {
    font-size: 1.0625rem;
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .me-privacy-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--me-accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .me-privacy-link:hover {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── CTA ─── */
  .me-cta {
    padding: 6rem 0;
    background: var(--me-accent-bg);
    position: relative;
    overflow: hidden;
  }

  .me-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  .me-cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--me-text);
    margin-bottom: 1rem;
  }

  .me-cta-text {
    font-size: 1.125rem;
    color: var(--me-text-muted);
    margin-bottom: 2rem;
  }

  /* ─── Footer ─── */
  .me-footer {
    background: var(--me-bg);
    border-top: 1px solid var(--me-border);
    padding: 2rem 0;
  }

  .me-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .me-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      padding: 0 2rem;
    }
  }

  @media (min-width: 1024px) {
    .me-footer-inner { padding: 0 3rem; }
  }

  .me-footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .me-footer-links a {
    color: var(--me-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .me-footer-links a:hover {
    color: var(--me-accent);
  }

  .me-footer-dot {
    color: var(--me-text-muted);
    opacity: 0.4;
  }

  .me-footer-brand {
    font-size: 0.8125rem;
    color: var(--me-text-muted);
    opacity: 0.6;
  }

  .me-footer-brand a {
    color: var(--me-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .me-footer-brand a:hover {
    color: var(--me-accent);
  }

  /* ─── Screenshots (run-easy style) ─── */
  .me-screenshots-section {
    padding: 4rem 0;
    background: var(--me-bg, #fafaf9);
  }

  .me-section-header {
    margin-bottom: 2rem;
  }

  .me-screenshots-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--me-text, #0a0a0a);
    margin-top: 0.5rem;
  }

  .me-screenshots-scroll {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .me-screenshots-scroll::-webkit-scrollbar { height: 4px; }
  .me-screenshots-scroll::-webkit-scrollbar-track { background: transparent; }
  .me-screenshots-scroll::-webkit-scrollbar-thumb { background: var(--me-border, #e7e5e4); border-radius: 2px; }

  .me-screenshot-card {
    flex-shrink: 0;
    width: 260px;
    scroll-snap-align: start;
    text-align: center;
  }

  .me-screenshot-card img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(10, 10, 10, 0.08), 0 4px 12px rgba(10, 10, 10, 0.04);
    border: 1px solid var(--me-border, #e7e5e4);
    transition: transform 0.3s ease;
  }

  .me-screenshot-card img:hover {
    transform: translateY(-4px);
  }

  .me-screenshot-label {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--me-text-muted, #78716c);
    letter-spacing: 0.02em;
  }

</style>
